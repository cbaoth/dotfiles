# Dotfiles devcontainer: a clean Ubuntu box set up by this repo's own tooling.
#
# The Dockerfile only bootstraps; `system-setup -p container` does the rest, so
# the container gets exactly what the hosts get and doubles as a test bed for
# setup/ and tools/link.sh. Built from the WORKING TREE (build context = repo
# root, see devcontainer.json), so uncommitted changes can be tested before
# they are pushed. Docs: docs/setup/devcontainer.md
FROM mcr.microsoft.com/devcontainers/base:ubuntu26.04

# The non-root user the base image ships (uid 1000, matches the host user)
ARG USERNAME=vscode

ENV DEBIAN_FRONTEND=noninteractive

# Create workspace directory (required by devcontainer workspaceFolder setting)
RUN mkdir -p /workspace && chown ${USERNAME}:${USERNAME} /workspace

# Make zsh default shell
RUN chsh -s "$(command -v zsh)" ${USERNAME}

# Ensure user `$USERNAME` has full access to `sudo` (system-setup needs it)
RUN mkdir -p /etc/sudoers.d \
    && echo "${USERNAME} ALL=(root) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME} \
    && chmod 0440 /etc/sudoers.d/${USERNAME}

# From now on continue as user `$USERNAME` in user's home directory
USER ${USERNAME}
WORKDIR /home/${USERNAME}

# Set CACHE_BUST (any new value, e.g. `CACHE_BUST=$(date +%s)` in the env that
# runs the build) to re-run system-setup and pick up new upstream releases.
ARG CACHE_BUST=0

# System setup first, from only the files it needs: this layer is rebuilt when
# setup/ changes, not on every dotfile edit. apt lists are dropped in the same
# layer to keep the image small (st::apt_update re-fetches when they are gone).
COPY --chown=${USERNAME}:${USERNAME} bin/system-setup /home/${USERNAME}/dotfiles/bin/system-setup
COPY --chown=${USERNAME}:${USERNAME} setup/ /home/${USERNAME}/dotfiles/setup/
RUN /home/${USERNAME}/dotfiles/bin/system-setup --yes --profile container \
    && sudo apt-get clean \
    && sudo rm -rf /var/lib/apt/lists/*

# Generated by 10-locale above; set only now so the earlier steps don't warn
# about a missing locale.
ENV LANG=en_US.UTF-8

# The whole working tree (minus .dockerignore), then all symlinks
COPY --chown=${USERNAME}:${USERNAME} . /home/${USERNAME}/dotfiles
RUN /home/${USERNAME}/dotfiles/tools/link.sh

# Start zsh one time to bootstrap the plugin manager (zinit) and install all
# plugins. ZINIT_TURBO=false forces synchronous loading so every plugin is
# installed during this build step (turbo/async would defer installs to the
# first real prompt, which never happens in `zsh -ic true`).
RUN ZINIT_TURBO=false zsh -ic true
