{
  // Docs: docs/setup/devcontainer.md
  "name": "Dotfiles Dev Container",
  "build": {
    "dockerfile": "Dockerfile",
    // Repo root: the image is built from the working tree (see .dockerignore)
    "context": "..",
    "args": {
      // Set CACHE_BUST in your local env when you want to re-run system-setup
      "CACHE_BUST": "${localEnv:CACHE_BUST}"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      },
      "extensions": [
        "GitHub.copilot",
        "anthropic.claude-code"
      ]
    }
  },
  // Short name as hostname: the prompt and tmux show it (docker's default
  // is the container id). Keep it unique among your containers.
  "runArgs": ["--hostname=dotfiles"],
  "mounts": [
    // The host's timezone (containers default to UTC: wrong mtimes and
    // timestamps in file names and logs)
    "source=/etc/localtime,target=/etc/localtime,type=bind,readonly",
    // Claude Code config + login, kept across rebuilds; separate from the
    // host's ~/.claude so the container stays a sandbox
    "source=claude-config-${devcontainerId},target=/home/vscode/.claude,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  // Refresh the links inside the persisted ~/.claude volume, then the health
  // check: a correctly built image reports "0 changed"
  "postCreateCommand": "zsh -lc '~/dotfiles/tools/link.sh && system-setup --dry-run --profile container'",
  "remoteUser": "vscode",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace"
}
