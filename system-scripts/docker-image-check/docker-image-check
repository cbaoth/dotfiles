#!/usr/bin/env python3
"""Report Docker images that have fallen behind their upstream registry.

Deliberate deviation from cb-python.instructions.md: this uses a plain
`python3` shebang instead of `#!/usr/bin/env -S uv run --script` with PEP 723
metadata. It has NO third-party dependencies, and it runs from a systemd timer
on servers where `uv` is not installed. Adding uv here would mean installing a
package manager to run a script that needs no packages.
"""

from __future__ import annotations

import argparse
import json
import re
import shutil
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from dataclasses import dataclass, field

# Docker Hub short names ("redis:7-alpine") live under library/ on the actual
# registry host, which is registry-1.docker.io, not hub.docker.com.
DOCKER_HUB_REGISTRY = "registry-1.docker.io"

MANIFEST_ACCEPT = ", ".join(
    (
        "application/vnd.oci.image.index.v1+json",
        "application/vnd.oci.image.manifest.v1+json",
        "application/vnd.docker.distribution.manifest.list.v2+json",
        "application/vnd.docker.distribution.manifest.v2+json",
    )
)

USER_AGENT = "docker-image-check/1.0"
TIMEOUT = 20

# Docker Hub caps a page at 1000. 40 pages = 40k tags, far beyond any image
# here; if it is ever hit the report says so rather than silently truncating.
PAGE_SIZE = 1000
MAX_PAGES = 40

# 1.2.3 / 1.2.3-alpine / 15.0.6 / 31.0.9-apache — the leading numeric triple is
# what gets compared; the suffix must match exactly so that `-apache` images are
# never compared against plain ones.
VERSION_RE = re.compile(r"^v?(\d+)(?:\.(\d+))?(?:\.(\d+))?(?P<suffix>[-.].*)?$")


@dataclass
class ImageRef:
    """A parsed `registry/repo:tag` reference."""

    registry: str
    repo: str
    tag: str
    raw: str

    @property
    def is_moving_tag(self) -> bool:
        """True when the tag cannot pin an exact release (e.g. `2-alpine`, `11.4`).

        Such a tag is republished in place, so "behind" means the digest moved,
        not that a higher tag exists.
        """
        m = VERSION_RE.match(self.tag)
        if not m:
            return True  # `latest`, `stable`, ...
        # An exact pin needs all three numeric components (1.2.3).
        return m.group(3) is None


@dataclass
class Result:
    ref: ImageRef
    local_digest: str | None = None
    remote_digest: str | None = None
    newer_tags: list[str] = field(default_factory=list)
    tags_truncated: bool = False
    error: str | None = None

    @property
    def digest_drift(self) -> bool:
        return bool(
            self.local_digest and self.remote_digest and self.local_digest != self.remote_digest
        )

    @property
    def behind(self) -> bool:
        return self.digest_drift or bool(self.newer_tags)


def parse_image(raw: str) -> ImageRef:
    """Split `[registry/]repo[:tag]` the way the Docker CLI does."""
    name, _, tag = raw.partition(":")
    if "/" in tag:  # the colon belonged to a registry port, not a tag
        name, tag = raw, ""
    tag = tag or "latest"

    head, _, rest = name.partition("/")
    if rest and ("." in head or ":" in head or head == "localhost"):
        registry, repo = head, rest
    else:
        registry, repo = DOCKER_HUB_REGISTRY, name
        if "/" not in repo:
            repo = f"library/{repo}"

    return ImageRef(registry=registry, repo=repo, tag=tag, raw=raw)


def _request(url: str, headers: dict[str, str]) -> tuple[int, dict[str, str], bytes]:
    """GET a URL, returning (status, headers, body).

    Response header keys are LOWERCASED. HTTP header names are case-insensitive
    and registries disagree in practice — Docker Hub sends `www-authenticate`
    and `docker-content-digest` in lowercase, others use canonical casing. A
    plain dict lookup on the canonical spelling silently misses, which made
    every tag listing return empty and every image report as up to date.
    """
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT, **headers})
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
            return resp.status, {k.lower(): v for k, v in resp.headers.items()}, resp.read()
    except urllib.error.HTTPError as exc:
        raw = exc.headers.items() if exc.headers else []
        return exc.code, {k.lower(): v for k, v in raw}, exc.read()


def _bearer_token(www_authenticate: str) -> str | None:
    """Complete the OCI token dance advertised in a 401's WWW-Authenticate header.

    Docker Hub, ghcr.io and Codeberg all speak this, so one code path covers
    every registry in use here.
    """
    if not www_authenticate.lower().startswith("bearer "):
        return None
    params = dict(re.findall(r'(\w+)="([^"]*)"', www_authenticate))
    realm = params.pop("realm", None)
    if not realm:
        return None
    url = f"{realm}?{urllib.parse.urlencode(params)}" if params else realm
    status, _, body = _request(url, {})
    if status != 200:
        return None
    data = json.loads(body)
    return data.get("token") or data.get("access_token")


def registry_get(ref: ImageRef, path: str, accept: str | None = None) -> tuple[int, dict, bytes]:
    """GET a registry endpoint, transparently acquiring an anonymous token."""
    url = f"https://{ref.registry}/v2/{ref.repo}{path}"
    headers = {"Accept": accept} if accept else {}
    status, resp_headers, body = _request(url, headers)
    if status == 401:
        token = _bearer_token(resp_headers.get("www-authenticate", ""))
        if token:
            headers["Authorization"] = f"Bearer {token}"
            status, resp_headers, body = _request(url, headers)
    return status, resp_headers, body


def remote_digest(ref: ImageRef) -> str | None:
    status, headers, _ = registry_get(ref, f"/manifests/{ref.tag}", MANIFEST_ACCEPT)
    if status != 200:
        return None
    return headers.get("docker-content-digest")


def remote_tags(ref: ImageRef) -> tuple[list[str], bool]:
    """All tags for a repo, following pagination. Returns (tags, truncated).

    Pagination is NOT optional. Docker Hub caps a page at 1000 tags and returns
    them in an order that is neither semver nor chronological: for
    `library/nextcloud` the first page ends at `17.0.0beta4-fpm-alpine`, so
    every 31.x tag lives on a later page. Reading one page made the pinned
    31.0.9-apache look like the newest release in existence — a confident false
    negative, the exact failure mode this script exists to prevent.
    """
    tags: list[str] = []
    path = f"/tags/list?n={PAGE_SIZE}"

    for _ in range(MAX_PAGES):
        status, headers, body = registry_get(ref, path)
        if status != 200:
            return tags, False
        tags.extend(json.loads(body).get("tags") or [])

        # RFC 5988: `link: </v2/repo/tags/list?last=X&n=1000>; rel="next"`
        link = headers.get("link", "")
        match = re.search(r"<([^>]+)>\s*;\s*rel=\"?next\"?", link)
        if not match:
            return tags, False
        nxt = match.group(1)
        # The registry returns an absolute path; registry_get wants the part
        # after /v2/<repo>.
        prefix = f"/v2/{ref.repo}"
        path = nxt[len(prefix):] if nxt.startswith(prefix) else nxt

    return tags, True


def version_key(tag: str) -> tuple[tuple[int, int, int], str] | None:
    m = VERSION_RE.match(tag)
    if not m or m.group(3) is None:
        return None
    nums = (int(m.group(1)), int(m.group(2) or 0), int(m.group(3) or 0))
    return nums, (m.group("suffix") or "")


def newer_tags(ref: ImageRef, tags: list[str], *, same_major: bool) -> list[str]:
    """Tags strictly newer than the pinned one, with an identical suffix.

    `same_major` keeps the answer inside the release line that was deliberately
    pinned (Forgejo is on the v15 LTS on purpose), so the report says "you are
    behind on the line you chose" rather than nagging about a major bump.
    """
    current = version_key(ref.tag)
    if current is None:
        return []
    cur_nums, cur_suffix = current

    candidates = []
    for tag in tags:
        key = version_key(tag)
        if key is None:
            continue
        nums, suffix = key
        if suffix != cur_suffix:
            continue
        if same_major and nums[0] != cur_nums[0]:
            continue
        if nums > cur_nums:
            candidates.append((nums, tag))

    return [t for _, t in sorted(candidates, reverse=True)]


def local_digests() -> dict[str, str]:
    """Map `image:tag` -> repo digest for every running container."""
    out = subprocess.run(
        ["docker", "ps", "--format", "{{.Image}}"],
        capture_output=True,
        text=True,
        check=True,
    )
    images = sorted(set(line.strip() for line in out.stdout.splitlines() if line.strip()))

    digests: dict[str, str] = {}
    for image in images:
        inspect = subprocess.run(
            ["docker", "image", "inspect", image, "--format", "{{json .RepoDigests}}"],
            capture_output=True,
            text=True,
        )
        if inspect.returncode != 0:
            digests[image] = ""
            continue
        repo_digests = json.loads(inspect.stdout or "[]")
        digest = ""
        for entry in repo_digests:
            _, _, sha = entry.partition("@")
            if sha:
                digest = sha
                break
        digests[image] = digest
    return digests


def check(images: dict[str, str], *, same_major: bool) -> list[Result]:
    results = []
    for image, digest in images.items():
        ref = parse_image(image)
        result = Result(ref=ref, local_digest=digest or None)
        try:
            result.remote_digest = remote_digest(ref)
            if not ref.is_moving_tag:
                tags, truncated = remote_tags(ref)
                result.tags_truncated = truncated
                result.newer_tags = newer_tags(ref, tags, same_major=same_major)
        except (urllib.error.URLError, json.JSONDecodeError, OSError) as exc:
            result.error = str(exc)
        results.append(result)
    return results


def format_report(results: list[Result]) -> tuple[str, list[str]]:
    lines: list[str] = []
    behind: list[str] = []

    for r in sorted(results, key=lambda x: x.ref.raw):
        name = r.ref.raw
        if r.error:
            lines.append(f"  ?  {name}: {r.error}")
            continue
        notes = []
        if r.newer_tags:
            newest = r.newer_tags[0]
            extra = f" (+{len(r.newer_tags) - 1} more)" if len(r.newer_tags) > 1 else ""
            notes.append(f"newer tag {newest}{extra}")
        if r.digest_drift:
            notes.append("tag republished (digest moved)")
        if r.tags_truncated:
            notes.append(f"WARNING: tag list hit the {MAX_PAGES}-page cap, may be incomplete")
        if notes:
            behind.append(f"{name}: {'; '.join(notes)}")
            lines.append(f"  !  {name}  ->  {'; '.join(notes)}")
        else:
            lines.append(f"  ok {name}")

    return "\n".join(lines), behind


def notify(behind: list[str]) -> None:
    if not shutil.which("ntfy-send"):
        print("ntfy-send not on PATH; skipping notification", file=sys.stderr)
        return
    title = f"{len(behind)} container image(s) behind upstream"
    body = "\n".join(behind)
    subprocess.run(
        ["ntfy-send", "--priority", "low", "--tags", "package", title, body],
        check=False,
    )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument(
        "--notify",
        action="store_true",
        help="send an ntfy push when something is behind (for the systemd timer)",
    )
    parser.add_argument(
        "--any-major",
        action="store_true",
        help="also report major-version bumps, not just the pinned release line",
    )
    args = parser.parse_args()

    try:
        images = local_digests()
    except (subprocess.CalledProcessError, FileNotFoundError) as exc:
        print(f"cannot list running containers: {exc}", file=sys.stderr)
        return 1

    if not images:
        print("no running containers")
        return 0

    results = check(images, same_major=not args.any_major)
    report, behind = format_report(results)
    print(report)

    if behind:
        print(f"\n{len(behind)} image(s) behind upstream")
        if args.notify:
            notify(behind)
    else:
        print("\nall images current")
    return 0


if __name__ == "__main__":
    sys.exit(main())
