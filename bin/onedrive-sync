#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; indent-tabs-mode: nil; tab-width: 2 -*-
# vim: ft=bash:et:ts=2:sts=2:sw=2
# code: language=bash insertSpaces=true tabSize=2
# shellcheck shell=bash
#
# onedrive-sync: One guarded `onedrive --sync` run, with ntfy alerting (for timers).

# set options
# -e omitted intentionally: onedrive's exit code and output are inspected and
# classified below; an early abort would skip the state bookkeeping and alerts.
set -o pipefail
set -o nounset
(( ${DEBUG_LVL:-0} >= 2 )) && set -o xtrace

trap 'printf "\nINTERRUPT\n"; exit 1' SIGINT SIGTERM

# {{{ = CONSTANTS =============================================================

declare -r ONEDRIVE_CONF_DIR="${ONEDRIVE_CONF_DIR:-${HOME}/.config/onedrive}"
declare -r STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/onedrive-sync"
# Touched after every run that reached OneDrive and finished (failed items
# included). Its age is the staleness signal; also usable by an external
# dead-man check (netdata filecheck), which still fires if this timer is dead.
declare -r LAST_OK_FILE="${STATE_DIR}/last-success"
declare -r FAILED_ITEMS_FILE="${STATE_DIR}/failed-items"

# Seconds without a completed run before a *tolerated* failure (offline,
# OneDrive throttling, saito rebooting) becomes an *alertable* one (exit
# non-zero → OnFailure= ntfy). Brief outages are noise; a sync that has not
# completed for 6 h is worth a look.
declare -ri MAX_AGE="${ONEDRIVE_SYNC_MAX_AGE:-21600}"

# }}} = CONSTANTS =============================================================

# {{{ = ARGUMENTS =============================================================

declare -i quiet=0
declare -i no_notify=0
declare -a extra_args=()

# }}} = ARGUMENTS =============================================================

# {{{ = FUNCTIONS =============================================================

usage() {
  cat <<EOF
Usage: onedrive-sync [OPTIONS] [-- ONEDRIVE_ARGS...]

Run 'onedrive --sync' once, refusing to start when the sync dir looks
unmounted or empty, then classify the result:

  completed            -> record success
  completed, failures  -> record success; ntfy once when the failed set changes
  failed               -> tolerated (exit 0) until no run has completed for
                          ${MAX_AGE}s, then exit 1 (the unit's OnFailure= alerts)
  big delete detected  -> exit 1 immediately

Options:
  -q, --quiet       Do not echo onedrive's output (the journal still gets
                    the classification lines)
      --no-notify   Never call ntfy-send (manual runs)
  -h, --help        This help

Arguments after -- go to onedrive, e.g. a first catch-up run:
  onedrive-sync --no-notify -- --download-only --dry-run

Environment:
  ONEDRIVE_CONF_DIR       onedrive config dir (default: ~/.config/onedrive)
  ONEDRIVE_SYNC_MAX_AGE   staleness threshold in seconds (default: 21600)

Runs via the onedrive-sync.timer systemd user unit:
  systemctl --user status onedrive-sync.timer
  journalctl --user -u onedrive-sync.service -n 50
EOF
}

p_msg()  { (( quiet )) || printf '%s\n' "$*"; }
p_err()  { printf 'ERROR: %s\n' "$*" >&2; }
p_warn() { printf 'WARNING: %s\n' "$*" >&2; }

parse_args() {
  while (( $# > 0 )); do
    case "$1" in
      -q|--quiet)   quiet=1; shift ;;
      --no-notify)  no_notify=1; shift ;;
      -h|--help)    usage; exit 0 ;;
      --)           shift; extra_args=("$@"); break ;;
      *)
        p_err "unknown option: $1"
        usage >&2
        exit 1
        ;;
    esac
  done
}

notify() {
  (( no_notify )) && return 0
  command -v ntfy-send >/dev/null 2>&1 || { p_warn "ntfy-send not found, no alert sent"; return 0; }
  ntfy-send "$@" || p_warn "ntfy-send failed"
}

# Read sync_dir from the onedrive config (default ~/OneDrive, as onedrive does).
read_sync_dir() {
  local dir
  dir="$(sed -nE 's/^[[:space:]]*sync_dir[[:space:]]*=[[:space:]]*"([^"]*)".*/\1/p' \
    "${ONEDRIVE_CONF_DIR}/config" 2>/dev/null | tail -n1)"
  dir="${dir:-${HOME}/OneDrive}"
  dir="${dir/#\~/${HOME}}"
  printf '%s\n' "${dir%/}"
}

# An unmounted RAID leaves an empty (or missing) sync dir. onedrive would then
# see every known file as deleted locally and propagate that online — its
# big-delete guard is the only other thing standing in the way. Refuse first.
check_sync_dir() {
  local -r dir="$1"
  if [[ ! -d "${dir}" ]]; then
    p_err "sync dir missing: ${dir} (filesystem not mounted?)"
    return 1
  fi
  if [[ -z "$(find "${dir}" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]]; then
    p_err "sync dir is empty: ${dir} (filesystem not mounted?) — refusing to sync"
    return 1
  fi
}

seconds_since_ok() {
  local -i last=0 now
  now="$(date +%s)"
  [[ -f "${LAST_OK_FILE}" ]] && last="$(stat -c %Y "${LAST_OK_FILE}")"
  printf '%d\n' $(( now - last ))
}

# Tolerate a failed run until the last completed one is older than MAX_AGE.
fail_or_tolerate() {
  local -r reason="$1"
  local -i age
  if [[ ! -f "${LAST_OK_FILE}" ]]; then
    p_err "${reason}; no sync has ever completed here (${LAST_OK_FILE} missing)"
    exit 1
  fi
  age="$(seconds_since_ok)"
  if (( age > MAX_AGE )); then
    p_err "${reason}; no completed sync for $(( age / 3600 ))h (> $(( MAX_AGE / 3600 ))h)"
    exit 1
  fi
  p_warn "${reason} — tolerated, last completed sync $(( age / 60 ))min ago"
  exit 0
}

# }}} = FUNCTIONS =============================================================

# {{{ = MAIN ==================================================================

main() {
  parse_args "$@"

  if ! command -v onedrive >/dev/null 2>&1; then
    p_err "onedrive not installed"
    exit 1
  fi

  mkdir -p "${STATE_DIR}" || { p_err "cannot create ${STATE_DIR}"; exit 1; }

  # Two clients on one items.sqlite3 corrupt it. This also guards against the
  # packaged onedrive.service (--monitor) running next to this timer.
  exec 9>"${STATE_DIR}/lock"
  if ! flock -n 9; then
    p_msg "another onedrive-sync is running, skipping"
    exit 0
  fi
  if pgrep -u "$(id -u)" -x onedrive >/dev/null; then
    p_warn "an onedrive process is already running (onedrive.service --monitor?), skipping"
    exit 0
  fi

  local sync_dir
  sync_dir="$(read_sync_dir)"
  check_sync_dir "${sync_dir}" || fail_or_tolerate "sync dir check failed"

  local out_file
  out_file="$(mktemp -t onedrive-sync.XXXXXX)" || { p_err "mktemp failed"; exit 1; }
  # shellcheck disable=SC2064  # expand now: the path is fixed for this run
  trap "rm -f '${out_file}'" EXIT

  local -i rc=0
  if (( quiet )); then
    onedrive --sync "${extra_args[@]}" >"${out_file}" 2>&1 || rc=$?
  else
    onedrive --sync "${extra_args[@]}" 2>&1 | tee "${out_file}" || rc=$?
  fi

  # A dry run proves nothing about the real sync: never touch the state.
  local arg
  for arg in "${extra_args[@]}"; do
    [[ "${arg}" == "--dry-run" ]] && { p_msg "dry run (rc=${rc}), state not updated"; exit "${rc}"; }
  done

  # Wording differs between client versions; match loosely.
  if grep -qiE 'big delete|large volume of data|large number of (items|files) .*delet' "${out_file}"; then
    p_err "onedrive refused a large online delete — inspect before anything else:"
    grep -iE 'big delete|large volume|delet' "${out_file}" | tail -n 5 >&2
    notify --priority urgent --tags rotating_light \
      "onedrive: BIG DELETE blocked" \
      "OneDrive sync on $(hostname -s) stopped a mass online delete. Timer keeps failing until resolved. journalctl --user -u onedrive-sync -n 80"
    exit 1
  fi

  # The completion line decides, not rc: onedrive exits 1 on a finished sync
  # that merely had failed items (verified with 2.5.10).
  if ! grep -qE 'Sync with Microsoft OneDrive (is|has) complete' "${out_file}"; then
    grep -E 'ERROR' "${out_file}" | tail -n 5 >&2
    fail_or_tolerate "onedrive --sync failed (rc=${rc})"
  fi

  touch "${LAST_OK_FILE}"

  # Persistent per-file failures (no server hash, 403 on a flagged file) repeat
  # on every run; alert only when the set changes, not every 30 minutes.
  local failed
  failed="$(grep -E 'Failed to (download|upload)' "${out_file}" | sed -E 's/^\[[^]]*\] //' | LC_ALL=C sort -u)"
  if [[ "${failed}" != "$(cat "${FAILED_ITEMS_FILE}" 2>/dev/null)" ]]; then
    printf '%s' "${failed}" >"${FAILED_ITEMS_FILE}"
    if [[ -n "${failed}" ]]; then
      p_warn "failed item set changed:"
      printf '%s\n' "${failed}" >&2
      notify --priority default --tags warning \
        "onedrive: $(grep -c . <<<"${failed}") item(s) failing" \
        "$(head -n 10 <<<"${failed}")"
    else
      p_msg "all previously failing items synced"
    fi
  fi

  p_msg "sync completed${failed:+ ($(grep -c . <<<"${failed}") failed item(s), see ${FAILED_ITEMS_FILE})}"
}

main "$@"

# }}} = MAIN ==================================================================
