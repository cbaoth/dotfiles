#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; indent-tabs-mode: nil; tab-width: 2 -*-
# vim: ft=bash:et:ts=2:sts=2:sw=2
# code: language=bash insertSpaces=true tabSize=2
# shellcheck shell=bash
#
# Update apt package indexes quietly and store the last update timestamp
# (per user, in the XDG cache dir; read by the agu/apu aliases).

declare -r STAMP_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}"
apt-get -q -y update >/dev/null \
  && mkdir -p "${STAMP_DIR}" && date +%s > "${STAMP_DIR}/last_apt_update"
