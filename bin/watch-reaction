#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; indent-tabs-mode: nil; tab-width: 2 -*-
# vim: ft=bash:et:ts=2:sts=2:sw=2
# code: language=bash insertSpaces=true tabSize=2
# shellcheck shell=bash
#
# Watch a reaction alongside the show in two paused, IPC-controlled mpv windows,
# laid out per a selectable --profile: the reaction large with the show injected
# center-bottom (default), the classic small reaction overlay over a large show,
# or a larger reaction snapped to the screen corner. Placement is done via Sway
# (falls back to mpv geometry when not under Sway).

# shellcheck disable=SC2155
declare -r SCRIPT_FILE="$(basename "$0")"

# -e: exit on error  -u: unset vars are errors  -o pipefail: propagate pipe failures
set -o errexit
set -o pipefail
set -o nounset

# {{{ = CONSTANTS =============================================================

declare -r SHOW_SOCKET="/tmp/mpv-show.sock"
declare -r REACTION_SOCKET="/tmp/mpv-reaction.sock"

# Layout profiles pick which side is the large centered window and the small
# overlay's target height (px); the overlay's width follows its own aspect.
declare -r DEFAULT_PROFILE="inject"              # profile 2: reaction large
declare -ri PROFILE_INJECT_OVERLAY_H=578         # show injected into the reaction
declare -ri PROFILE_OVERLAY_OVERLAY_H=270        # classic reaction over the show
declare -ri PROFILE_CORNER_OVERLAY_H=640         # reaction in the screen corner
declare -ri OVERLAY_MARGIN=20                    # px inset for the classic overlay

declare -ri SHOW_ASPECT_W=16                     # show aspect fallback if unprobed
declare -ri SHOW_ASPECT_H=9

declare -ri WINDOW_WAIT_TRIES=30                 # ~3s at 0.1s/try for a window to map
declare -r WINDOW_WAIT_INTERVAL="0.1"

# }}} = CONSTANTS =============================================================

# {{{ = HELPERS ===============================================================

p_err() { printf '\033[31mERROR\033[0m: %s\n' "$*" >&2; }
p_war() { printf '\033[33mWARNING\033[0m: %s\n' "$*" >&2; }

p_usg() {
  cat <<EOF
Usage: ${SCRIPT_FILE} [OPTIONS] REACTION SHOW [SHOW...]
   or: ${SCRIPT_FILE} [OPTIONS] --reaction ARG... --show ARG...

Open two paused mpv windows wired for IPC control and lay them out for reaction
viewing per a selectable --profile. Both start paused so they can be lined up
and un-paused together — useful when the two drift because of a frame-rate
mismatch (see ff-video-sync to correct PAL/NTSC speed differences first).

Layout profiles (-P/--profile) — height is the reference, width follows aspect:
  2, inject    reaction large (full usable height); the SHOW injected clear and
               sharp center-bottom into the reaction's blurred dummy-footage
               area (~578 px high, flush to the bottom). The default.
  1, overlay   classic: SHOW large; a small REACTION overlay (~270 px) hugging
               the show's bottom-right corner with a margin.
  3, corner    SHOW large and left-aligned (uses the full ultra-wide width); a
               larger REACTION (~640 px) snapped flush to the screen's
               bottom-right corner, no padding — more out of the way.

Multiple files given to either side become an mpv playlist (played back to
back in that one window) — e.g. a single reaction covering several short
episodes, or one reaction split across several files.

The windows are titled "mpv-show" and "mpv-reaction" for Sway/i3 window rules,
and expose IPC sockets for scripted control at:
  show:     ${SHOW_SOCKET}
  reaction: ${REACTION_SOCKET}

Layout is applied via swaymsg using the workspace's usable area (bars excluded
automatically, like sway-place). Without Sway it falls back to mpv's own
geometry (the small overlay placed best-effort; the large window left at mpv's
default size).

Sync hotkeys are installed into both windows (they work whichever has focus;
require the mpv-ipc helper). Modifier picks the target — Shift+Alt = show,
Ctrl+Alt = reaction, Ctrl+Shift+Alt = both:
  <mod>+Left/Right   seek: -/+1 exact per side, -/+10 for both (skip/repeat)
  <mod>+Space        toggle play/pause
  <mod>+q            quit (quit-watch-later, so resume is saved)

Two input styles (do not mix them):
  Positional shortcut (common case):
    REACTION is a single file, every following file is a SHOW episode.
  Explicit groups (full control, either order):
    --reaction and --show each begin a group; every following argument — video
    files AND extra mpv options — is forwarded verbatim to that mpv instance
    until the next --reaction/--show. This is how you drive the rarer reverse
    case (one show, several reaction files) or pass per-window mpv options.
    A --geometry inside a group disables that window's automatic placement.
  The input style only picks which files feed which window; it never changes the
  layout — that is the --profile's job.

Options (must precede the first --reaction/--show group):
  -P, --profile PROFILE    layout: 1|overlay, 2|inject, 3|corner [inject]
  -a, --align left|center|right   horizontal alignment of the large window
                           [center; corner defaults to left]
  -g, --geometry WxH+X+Y   place the REACTION manually via mpv --geometry
                           (disables its automatic placement, in any profile)
  -p, --play               start playing immediately (default: start paused)
  -h, --help               show this help and exit

Examples:
  # default (inject): 1 reaction, several show episodes as a playlist
  ${SCRIPT_FILE} reaction_ep1-4.mp4 ep1.mkv ep2.mkv ep3.mkv ep4.mkv

  # classic small overlay over a large show, pinned left, start playing
  ${SCRIPT_FILE} -p -P overlay --align left reaction.mp4 ep1.mkv

  # larger reaction snapped to the screen's bottom-right corner
  ${SCRIPT_FILE} --profile corner reaction.mp4 ep1.mkv

  # place the reaction manually instead of the automatic overlay
  ${SCRIPT_FILE} -g 640x360-40-40 reaction.mp4 ep1.mkv

  # reverse (rare): one show episode, reaction split across two files
  ${SCRIPT_FILE} --show single_ep.mkv --reaction react_a.mp4 react_b.mp4
EOF
}

# Return 0 if any argument sets an mpv --geometry (manual placement opt-out).
_has_geometry_arg() {
  local a
  for a in "$@"; do
    [[ "$a" == "--geometry" || "$a" == "--geometry="* ]] && return 0
  done
  return 1
}

# Echo the first argument that is an existing file (for aspect probing).
_first_existing_file() {
  local a
  for a in "$@"; do
    [[ -f "$a" ]] && { printf '%s' "$a"; return 0; }
  done
  return 0
}

# Echo "W H" aspect for a video file via ffprobe (display aspect if sane, else
# pixel dimensions). Empty output on any failure — caller falls back to 16:9.
probe_aspect() {
  local file="$1"
  [[ -n "$file" && -f "$file" ]] || return 0
  command -v ffprobe > /dev/null 2>&1 || return 0

  local out w h dar
  out="$(ffprobe -v error -select_streams v:0 \
    -show_entries stream=width,height,display_aspect_ratio \
    -of default=nw=1 -- "$file" 2>/dev/null)" || return 0
  w="$(sed -n 's/^width=//p' <<< "$out")"
  h="$(sed -n 's/^height=//p' <<< "$out")"
  dar="$(sed -n 's/^display_aspect_ratio=//p' <<< "$out")"

  if [[ "$dar" =~ ^[0-9]+:[0-9]+$ && "$dar" != "0:1" ]]; then
    printf '%s %s' "${dar%:*}" "${dar#*:}"
  elif [[ "$w" =~ ^[0-9]+$ && "$h" =~ ^[0-9]+$ ]] && (( h > 0 )); then
    printf '%s %s' "$w" "$h"
  fi
}

# Echo a profile's layout params: "PRIMARY OVERLAY_H ANCHOR HPOS MARGIN ALIGN".
# PRIMARY (show|reaction) is the large window; the other side is the small
# overlay, OVERLAY_H its target height (px, width follows aspect), ANCHOR where
# it sits (primary = hug the large window's box, screen = the whole area), HPOS
# its horizontal placement (right|center), MARGIN its inset (px). ALIGN is the
# large window's default horizontal alignment (an explicit --align overrides it).
_profile_spec() {
  case "$1" in
    overlay) printf 'show %d primary right %d center\n' "$PROFILE_OVERLAY_OVERLAY_H" "$OVERLAY_MARGIN" ;;
    inject)  printf 'reaction %d primary center 0 center\n' "$PROFILE_INJECT_OVERLAY_H" ;;
    corner)  printf 'show %d screen right 0 left\n' "$PROFILE_CORNER_OVERLAY_H" ;;
  esac
}

# Echo an mpv --geometry string for the profile's overlay window (non-Sway
# fallback), sized from the overlay file's aspect at the profile height.
_overlay_fallback_geometry() {
  local profile="$1" overlay_file="$2"
  local hpos
  local -i overlay_h margin
  # Fields: PRIMARY OVERLAY_H ANCHOR HPOS MARGIN ALIGN — only HPOS/MARGIN/H matter.
  read -r _ overlay_h _ hpos margin _ < <(_profile_spec "$profile")
  local aow aoh
  read -r aow aoh < <(probe_aspect "$overlay_file") || true
  if ! { [[ "$aow" =~ ^[0-9]+$ && "$aoh" =~ ^[0-9]+$ ]] && (( aoh > 0 )); }; then
    aow=$SHOW_ASPECT_W
    aoh=$SHOW_ASPECT_H
  fi
  local -i ow=$(( overlay_h * aow / aoh ))
  if [[ "$hpos" == center ]]; then
    printf '%dx%d+50%%+100%%' "$ow" "$overlay_h"                 # centered, bottom
  else
    printf '%dx%d-%d-%d' "$ow" "$overlay_h" "$margin" "$margin"  # bottom-right
  fi
}

# True when Sway IPC (and jq) are usable for placement.
sway_available() {
  command -v swaymsg > /dev/null 2>&1 \
    && command -v jq > /dev/null 2>&1 \
    && swaymsg -t get_version > /dev/null 2>&1
}

# Echo the con_id of the first window whose title matches, or nothing.
sway_conid() {
  swaymsg -t get_tree 2>/dev/null \
    | jq -r --arg t "$1" '[ .. | objects | select(.name? == $t) | .id ] | first // empty'
}

# Poll for a titled window to map; echo its con_id (rc 1 on timeout).
sway_wait_conid() {
  local title="$1" id i
  for (( i = 0; i < WINDOW_WAIT_TRIES; i++ )); do
    id="$(sway_conid "$title")"
    [[ -n "$id" ]] && { printf '%s' "$id"; return 0; }
    sleep "$WINDOW_WAIT_INTERVAL"
  done
  return 1
}

# Echo "W H" of the usable area of the workspace containing con_id $1.
sway_ws_size() {
  swaymsg -t get_tree 2>/dev/null | jq -r --argjson id "$1" '
    [ .. | objects | select(.type? == "workspace")
      | select([ .. | .id? // empty ] | index($id)) ] | first
    | "\(.rect.width) \(.rect.height)"'
}

# Size and position both windows on their Sway workspace for the given profile.
# Coordinates are workspace-usable-relative (0,0 at the top-left of the area
# below the bar), matching sway-place's `move position` convention. The profile
# names which side is the large centered window; the other is a small overlay.
place_windows() {
  local profile="$1" align="$2" show_manual="$3" reaction_manual="$4"
  local show_file="$5" reaction_file="$6"
  local sid rid ws_w ws_h

  sid="$(sway_wait_conid mpv-show)" \
    || { p_war "show window did not appear; leaving mpv's own geometry"; return 0; }
  rid="$(sway_wait_conid mpv-reaction)" \
    || { p_war "reaction window did not appear; leaving mpv's own geometry"; return 0; }

  read -r ws_w ws_h < <(sway_ws_size "$sid") || true
  [[ "$ws_w" =~ ^[0-9]+$ && "$ws_h" =~ ^[0-9]+$ ]] \
    || { p_war "could not read workspace size; skipping placement"; return 0; }

  # Profile params: which side is large, and the overlay's target height, anchor
  # (hug the large window's box, or the whole screen), horizontal placement, and
  # inset margin. The overlay's width follows its own video aspect.
  local primary overlay_anchor overlay_hpos
  local -i overlay_h overlay_margin
  # Alignment is resolved in main and passed as $2, so drop the spec's ALIGN.
  read -r primary overlay_h overlay_anchor overlay_hpos overlay_margin _ \
    < <(_profile_spec "$profile")

  # Map the large/overlay roles onto the concrete windows, files, and flags.
  local -i primary_id overlay_id
  local primary_file overlay_file primary_manual overlay_manual
  if [[ "$primary" == show ]]; then
    primary_id=$sid; overlay_id=$rid
    primary_file="$show_file"; overlay_file="$reaction_file"
    primary_manual="$show_manual"; overlay_manual="$reaction_manual"
  else
    primary_id=$rid; overlay_id=$sid
    primary_file="$reaction_file"; overlay_file="$show_file"
    primary_manual="$reaction_manual"; overlay_manual="$show_manual"
  fi

  # Large window: full usable height, width from the (probed) aspect, aligned.
  # Computed even when manually placed, so the overlay can still anchor to it.
  local arw arh
  read -r arw arh < <(probe_aspect "$primary_file") || true
  if ! { [[ "$arw" =~ ^[0-9]+$ && "$arh" =~ ^[0-9]+$ ]] && (( arh > 0 )); }; then
    arw=$SHOW_ASPECT_W
    arh=$SHOW_ASPECT_H
  fi
  local -i primary_w=$(( ws_h * arw / arh )) primary_x=0
  (( primary_w > ws_w )) && primary_w=ws_w
  case "$align" in
    left)  primary_x=0 ;;
    right) primary_x=$(( ws_w - primary_w )) ;;
    *)     primary_x=$(( (ws_w - primary_w) / 2 )) ;;
  esac
  if [[ "$primary_manual" != true ]]; then
    swaymsg "[con_id=$primary_id] floating enable, resize set ${primary_w} px ${ws_h} px, move position ${primary_x} px 0 px" \
      > /dev/null || p_war "failed to place large window"
  fi

  # Overlay: profile height, width from its own aspect, placed against the chosen
  # anchor (the large window's box, or the whole screen).
  if [[ "$overlay_manual" != true ]]; then
    local aow aoh
    read -r aow aoh < <(probe_aspect "$overlay_file") || true
    if ! { [[ "$aow" =~ ^[0-9]+$ && "$aoh" =~ ^[0-9]+$ ]] && (( aoh > 0 )); }; then
      aow=$SHOW_ASPECT_W
      aoh=$SHOW_ASPECT_H
    fi
    local -i oh=overlay_h ow ox oy anchor_x=0 anchor_w=ws_w
    (( oh > ws_h )) && oh=ws_h
    ow=$(( oh * aow / aoh ))
    (( ow > ws_w )) && ow=ws_w
    if [[ "$overlay_anchor" == primary ]]; then
      anchor_x=primary_x
      anchor_w=primary_w
    fi
    if [[ "$overlay_hpos" == center ]]; then
      ox=$(( anchor_x + (anchor_w - ow) / 2 ))
    else
      ox=$(( anchor_x + anchor_w - ow - overlay_margin ))
    fi
    oy=$(( ws_h - oh - overlay_margin ))
    (( ox < 0 )) && ox=0
    (( oy < 0 )) && oy=0
    swaymsg "[con_id=$overlay_id] floating enable, resize set ${ow} px ${oh} px, move position ${ox} px ${oy} px" \
      > /dev/null || p_war "failed to place overlay window"
  fi

  # Raise the overlay above the large window (last-focused floating is on top).
  swaymsg "[con_id=$overlay_id] focus" > /dev/null || true
}

# Install sync hotkeys into both mpv instances (once their IPC sockets are up)
# via the `keybind` command. Each binding runs `mpv-ipc` to send an input
# command to the targeted socket(s), so the key works regardless of which
# window has focus. Requires the mpv-ipc helper in PATH; a no-op otherwise.
inject_keybinds() {
  local both="${SHOW_SOCKET},${REACTION_SOCKET}"
  local i
  for (( i = 0; i < WINDOW_WAIT_TRIES; i++ )); do
    if [[ -S "$SHOW_SOCKET" && -S "$REACTION_SOCKET" ]]; then break; fi
    sleep "$WINDOW_WAIT_INTERVAL"
  done
  if [[ ! -S "$SHOW_SOCKET" || ! -S "$REACTION_SOCKET" ]]; then
    p_war "mpv IPC sockets not ready; sync hotkeys not installed"
    return 0
  fi
  local mpv_ipc
  mpv_ipc="$(command -v mpv-ipc)" || {
    p_war "mpv-ipc helper not found in PATH; sync hotkeys not installed"
    return 0
  }

  # KEY | target socket(s) | mpv input command. Modifier picks the target:
  # Shift+Alt = show, Ctrl+Alt = reaction, Ctrl+Shift+Alt = both.
  local -a binds=(
    "Shift+Alt+RIGHT|${SHOW_SOCKET}|seek 1 exact"
    "Shift+Alt+LEFT|${SHOW_SOCKET}|seek -1 exact"
    "Ctrl+Alt+RIGHT|${REACTION_SOCKET}|seek 1 exact"
    "Ctrl+Alt+LEFT|${REACTION_SOCKET}|seek -1 exact"
    "Ctrl+Shift+Alt+RIGHT|${both}|seek 10"
    "Ctrl+Shift+Alt+LEFT|${both}|seek -10"
    "Shift+Alt+SPACE|${SHOW_SOCKET}|cycle pause"
    "Ctrl+Alt+SPACE|${REACTION_SOCKET}|cycle pause"
    "Ctrl+Shift+Alt+SPACE|${both}|cycle pause"
    "Shift+Alt+q|${SHOW_SOCKET}|quit-watch-later"
    "Ctrl+Alt+q|${REACTION_SOCKET}|quit-watch-later"
    "Ctrl+Shift+Alt+q|${both}|quit-watch-later"
  )

  local entry key targets cmd action esc json
  for entry in "${binds[@]}"; do
    IFS='|' read -r key targets cmd <<< "$entry"
    # The bound action: run the helper (absolute path, so it works regardless
    # of mpv's own PATH) to relay `cmd` to the target socket(s).
    action="run \"${mpv_ipc}\" \"${targets}\" \"${cmd}\""
    esc="${action//\"/\\\"}"                       # escape quotes for JSON
    json="{\"command\":[\"keybind\",\"${key}\",\"${esc}\"]}"
    # Install into both instances so the key fires no matter which is focused.
    mpv-ipc "$both" "$json" > /dev/null 2>&1 || p_war "failed to install hotkey ${key}"
  done
}

# }}} = HELPERS ===============================================================

main() {
  local play=false
  local align="center"
  local align_set=false
  local profile="$DEFAULT_PROFILE"
  local geometry=""
  local geometry_set=false
  local current=""
  local -a reaction=() show=() positional=()

  # Parse: --reaction/--show open a group that swallows every following token
  # verbatim (files + mpv options) until the next group flag. Plain options are
  # only recognized before the first group flag.
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --reaction)
        current="reaction"
        shift
        ;;
      --show)
        current="show"
        shift
        ;;
      *)
        if [[ "$current" == "reaction" ]]; then
          reaction+=("$1")
          shift
          continue
        elif [[ "$current" == "show" ]]; then
          show+=("$1")
          shift
          continue
        fi
        case "$1" in
          -p|--play)
            play=true
            shift
            ;;
          -P|--profile)
            [[ $# -ge 2 ]] || { p_err "missing argument for $1"; return 2; }
            profile="$2"
            shift 2
            ;;
          --profile=*)
            profile="${1#*=}"
            shift
            ;;
          -a|--align)
            [[ $# -ge 2 ]] || { p_err "missing argument for $1"; return 2; }
            align="$2"
            align_set=true
            shift 2
            ;;
          --align=*)
            align="${1#*=}"
            align_set=true
            shift
            ;;
          -g|--geometry)
            [[ $# -ge 2 ]] || { p_err "missing argument for $1"; return 2; }
            geometry="$2"
            geometry_set=true
            shift 2
            ;;
          --geometry=*)
            geometry="${1#*=}"
            geometry_set=true
            shift
            ;;
          -h|--help)
            p_usg
            return 0
            ;;
          --)
            shift
            positional+=("$@")
            break
            ;;
          -*)
            p_err "unknown option: $1"
            p_usg >&2
            return 2
            ;;
          *)
            positional+=("$1")
            shift
            ;;
        esac
        ;;
    esac
  done

  case "$align" in
    left|center|right) ;;
    *) p_err "invalid --align: ${align} (expected left|center|right)"; return 2 ;;
  esac

  # Normalize the profile to its canonical name (accept the 1/2/3 shortcuts).
  case "$profile" in
    1|overlay|classic) profile="overlay" ;;
    2|inject|default)  profile="inject" ;;
    3|corner)          profile="corner" ;;
    *) p_err "invalid --profile: ${profile} (expected 1|overlay, 2|inject, 3|corner)"; return 2 ;;
  esac

  # Without an explicit --align, take the profile's preferred alignment (the last
  # field of its spec) — e.g. corner left-aligns the show to free the ultra-wide.
  if [[ "$align_set" != true ]]; then
    local spec
    spec="$(_profile_spec "$profile")"
    align="${spec##* }"
  fi

  # Reconcile the two input styles: positional shortcut vs. explicit groups.
  local shortcut=false
  if [[ ${#positional[@]} -gt 0 ]]; then
    if [[ ${#reaction[@]} -gt 0 || ${#show[@]} -gt 0 ]]; then
      p_err "do not mix positional files with --reaction/--show groups"
      p_usg >&2
      return 2
    fi
    if [[ ${#positional[@]} -lt 2 ]]; then
      p_err "need a reaction file and at least one show file"
      p_usg >&2
      return 2
    fi
    reaction=("${positional[0]}")
    show=("${positional[@]:1}")
    shortcut=true
    # In shortcut mode the tokens are known to be files, so validate them.
    local f
    for f in "${reaction[@]}" "${show[@]}"; do
      [[ -f "$f" ]] || { p_err "file not found: ${f}"; return 1; }
    done
  fi

  if [[ ${#reaction[@]} -eq 0 || ${#show[@]} -eq 0 ]]; then
    p_err "both a reaction and a show video are required"
    p_usg >&2
    return 2
  fi

  command -v mpv > /dev/null 2>&1 || { p_err "mpv not found in PATH"; return 1; }

  # A --geometry (top-level -g or inside a group) means the user places that
  # window; skip our automatic placement for it.
  local reaction_manual=false show_manual=false
  if $geometry_set || _has_geometry_arg "${reaction[@]}"; then reaction_manual=true; fi
  if _has_geometry_arg "${show[@]}"; then show_manual=true; fi

  # Remove stale sockets so a previous run can't hijack the IPC commands.
  rm -f -- "${SHOW_SOCKET}" "${REACTION_SOCKET}"

  local -a pause_opt=(--pause)
  $play && pause_opt=()

  # Resolve the profile's large-window side once; the other side is the overlay.
  local primary
  primary="$(_profile_spec "$profile")"
  primary="${primary%% *}"

  # Detect Sway once: it drives both the layout dispatch and whether the overlay
  # needs a best-effort mpv --geometry fallback (Sway placement overrides it).
  local under_sway=false
  sway_available && under_sway=true

  # Distinct --audio-client-name so the two streams are told apart in pavucontrol
  # (and can be routed independently).
  local -a reaction_cmd=(
    mpv
    --no-terminal
    --title=mpv-reaction
    --audio-client-name=mpv-reaction
    --input-ipc-server="${REACTION_SOCKET}"
    "${pause_opt[@]}"
  )
  local -a show_cmd=(
    mpv
    --no-terminal
    --title=mpv-show
    --audio-client-name=mpv-show
    --input-ipc-server="${SHOW_SOCKET}"
    "${pause_opt[@]}"
  )

  # An explicit -g always places the reaction (in any profile). Otherwise, only
  # off Sway, the profile's overlay window gets a best-effort fallback geometry.
  if $geometry_set; then
    reaction_cmd+=(--geometry="${geometry}")
  fi
  if ! $under_sway; then
    if [[ "$primary" == show && "$reaction_manual" != true ]]; then
      reaction_cmd+=(--geometry="$(_overlay_fallback_geometry "$profile" "$(_first_existing_file "${reaction[@]}")")")
    elif [[ "$primary" == reaction && "$show_manual" != true ]]; then
      show_cmd+=(--geometry="$(_overlay_fallback_geometry "$profile" "$(_first_existing_file "${show[@]}")")")
    fi
  fi

  # Only the shortcut path is guaranteed file-only, so guard those with `--`;
  # group tokens may contain mpv options and must not be treated as filenames.
  if $shortcut; then
    reaction_cmd+=(-- "${reaction[@]}")
    show_cmd+=(-- "${show[@]}")
  else
    reaction_cmd+=("${reaction[@]}")
    show_cmd+=("${show[@]}")
  fi

  # Launch the profile's large window first and the small overlay last so the
  # overlay maps on top of the larger window (newest floating window stacks
  # above); place_windows then also explicitly focuses the overlay to keep it up.
  if [[ "$primary" == show ]]; then
    "${show_cmd[@]}" &
    "${reaction_cmd[@]}" &
  else
    "${reaction_cmd[@]}" &
    "${show_cmd[@]}" &
  fi

  if $under_sway; then
    place_windows "$profile" "$align" "$show_manual" "$reaction_manual" \
      "$(_first_existing_file "${show[@]}")" "$(_first_existing_file "${reaction[@]}")"
  else
    p_war "not running under Sway (swaymsg/jq unavailable); using mpv's own geometry"
  fi

  inject_keybinds

  return 0
}

main "$@"
