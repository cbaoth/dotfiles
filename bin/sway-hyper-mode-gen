#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; indent-tabs-mode: nil; tab-width: 2 -*-
# vim: ft=bash:et:ts=2:sts=2:sw=2
# code: language=bash insertSpaces=true tabSize=2
# shellcheck shell=bash
#
# Generate a sway mode mirroring all $hyper bindings (Hyper fallback for ANSI).
#
# Every top-level `bindsym [--flags] $hyper+KEYS CMD` in the sway config.d
# files becomes `bindsym [--flags] KEYS mode "default"; CMD` inside
# `mode "$mode_hyper"`, written to OUT_FILE, which config.d/41-hyper-mode.conf
# includes. Runs via exec_always on every sway (re)load.
#
# Sway reads all includes *before* exec_always runs, so a changed file only
# takes effect on the next reload; --reload triggers that one reload itself.
# Loop safety (each guard alone stops a loop):
#   1. reload only if the generated content differs from OUT_FILE; output is
#      deterministic and OUT_FILE is written before reloading, so the reload's
#      own exec_always run sees no change
#   2. reload only if `sway -C` validates the whole config — sway does NOT
#      abort on config errors, it skips the line and still runs exec_always
#   3. at most one triggered reload per RELOAD_COOLDOWN seconds (stamp file)
#   4. flock: concurrent runs wait instead of racing

set -euo pipefail

# shellcheck disable=SC2155
declare -r SCRIPT_FILE="$(basename "$0")"
declare -r SWAY_DIR="${HOME}/.config/sway"
declare -r OUT_FILE="${HOME}/.cache/sway/hyper-mode.conf"
declare -r RUN_DIR="${XDG_RUNTIME_DIR:-/tmp}"
declare -r LOCK_FILE="${RUN_DIR}/${SCRIPT_FILE}.lock"
declare -r STAMP_FILE="${RUN_DIR}/${SCRIPT_FILE}.reload"
declare -ri RELOAD_COOLDOWN=30

p_err() { printf '\033[31mERROR\033[0m: %s\n' "$*" >&2; }
p_msg() { printf '%s: %s\n' "${SCRIPT_FILE}" "$*" >&2; }

p_usg() {
  cat <<EOF
Usage: ${SCRIPT_FILE} [--reload | --print]

Generate ${OUT_FILE/#${HOME}/\~}
from all \$hyper bindings in ${SWAY_DIR/#${HOME}/\~}/config.d/*.conf.

Options:
  --reload     If the file changed and the config validates, reload sway
               (at most once per ${RELOAD_COOLDOWN}s)
  --print      Print the generated mode to stdout, change nothing
  -h, --help   Show this help message and exit
EOF
}

# Emit the generated mode block on stdout.
# shellcheck disable=SC2016  # literal $hyper / $mode_hyper are sway variables
generate() {
  local file line part key flags cmd
  local -i depth
  local -r re='^bindsym[[:space:]]+((--[^[:space:]]+[[:space:]]+)*)\$hyper\+([^[:space:]]+)[[:space:]]+(.+)$'

  printf '# Generated by %s from config.d/*.conf — do not edit.\n' "${SCRIPT_FILE}"
  printf 'mode "$mode_hyper" {\n'
  for file in "${SWAY_DIR}"/config.d/*.conf; do
    depth=0
    line=""
    while IFS= read -r part || [[ -n "${part}" ]]; do
      part="${part#"${part%%[![:space:]]*}"}"  # trim leading whitespace
      # Join backslash-continued lines.
      if [[ "${part}" == *\\ ]]; then
        part="${part%\\}"
        line+="${part%"${part##*[![:space:]]}"} "  # trim trailing whitespace
        continue
      fi
      line+="${part}"
      # Skip bindings inside mode blocks (only top-level $hyper bindings).
      if [[ "${line}" =~ \{[[:space:]]*$ ]]; then
        depth+=1
      elif [[ "${line}" =~ ^\}[[:space:]]*$ ]]; then
        depth+=-1
      elif (( depth == 0 )) && [[ "${line}" =~ ${re} ]]; then
        flags="${BASH_REMATCH[1]}"
        key="${BASH_REMATCH[3]}"
        cmd="${BASH_REMATCH[4]}"
        printf '    bindsym %s%s mode "default"; %s\n' "${flags}" "${key}" "${cmd}"
      fi
      line=""
    done < "${file}"
  done
  printf '    bindsym Escape mode "default"\n'
  printf '    bindsym Return mode "default"\n'
  printf '}\n'
}

# Reload sway, guarded by validation and a cooldown.
reload_sway() {
  local -i now last=0
  now="$(date +%s)"
  [[ -f "${STAMP_FILE}" ]] && last="$(< "${STAMP_FILE}")"
  if (( now - last < RELOAD_COOLDOWN )); then
    p_msg "reload skipped: last triggered reload $(( now - last ))s ago"
    notify-send --expire-time=5000 "Hyper mode" \
      "Changed again within ${RELOAD_COOLDOWN}s, no reload (loop guard)" || true
    return 0
  fi
  if ! sway -C >/dev/null 2>&1; then
    p_msg "reload skipped: sway config does not validate (sway -C)"
    notify-send --expire-time=5000 "Hyper mode" \
      "Config errors (sway -C), no reload — fix and reload manually" || true
    return 0
  fi
  printf '%s\n' "${now}" > "${STAMP_FILE}"
  p_msg "hyper bindings changed, reloading sway"
  swaymsg -q reload
}

main() {
  local mode="write" new
  case "${1:-}" in
    "") ;;
    --reload) mode="reload" ;;
    --print) generate; exit 0 ;;
    -h|--help) p_usg; exit 0 ;;
    *) p_err "unknown argument: '$1'"; p_usg >&2; exit 1 ;;
  esac

  exec 9> "${LOCK_FILE}"
  flock -w 10 9 || { p_err "lock timeout: ${LOCK_FILE}"; exit 1; }

  new="$(generate)"
  if [[ -f "${OUT_FILE}" ]] && [[ "${new}" == "$(< "${OUT_FILE}")" ]]; then
    exit 0
  fi
  mkdir -p "${OUT_FILE%/*}"
  printf '%s\n' "${new}" > "${OUT_FILE}.tmp"
  mv -f "${OUT_FILE}.tmp" "${OUT_FILE}"
  p_msg "updated ${OUT_FILE}"

  if [[ "${mode}" == "reload" ]]; then
    # Release the lock first: the reload's own exec_always run needs it.
    exec 9>&-
    reload_sway
  fi
}

main "$@"
