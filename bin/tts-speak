#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; indent-tabs-mode: nil; tab-width: 2 -*-
# vim: ft=bash:et:ts=2:sts=2:sw=2
# code: language=bash insertSpaces=true tabSize=2
# shellcheck shell=bash
#
# tts-speak: read text aloud (selection, stdin or argument) with a pluggable local TTS engine.

# set options
# -e omitted intentionally: a failing chunk must not abort the whole read-aloud,
# and the cleanup trap has to run through every step.
set -o pipefail
set -o nounset
(( ${DEBUG_LVL:-0} >= 2 )) && set -o xtrace

# {{{ = CONSTANTS =============================================================

SELF="$(readlink -f -- "${BASH_SOURCE[0]}")"
declare -r SELF

declare -r CONF_FILE="${TTS_CONF:-${XDG_CONFIG_HOME:-${HOME}/.config}/tts/tts-speak.conf}"

# Runtime state is tmpfs and per user: a crashed worker can never leave a
# stale "playing" flag behind across a reboot.
declare -r RUN_DIR="${XDG_RUNTIME_DIR:-/tmp/$(id -u)}/tts-speak"
declare -r PID_FILE="${RUN_DIR}/worker.pid"
# mpv's IPC socket; one job at a time, so a fixed path lets pause/prev/next find it.
declare -r MPV_SOCK="${RUN_DIR}/mpv.sock"

# Defaults, overridable in CONF_FILE or the environment. The conf file is
# sourced after these, so it wins; explicit command line options win over both.
TTS_ENGINE="${TTS_ENGINE:-piper}"
TTS_SPEED="${TTS_SPEED:-1.0}"
TTS_CHUNK_CHARS="${TTS_CHUNK_CHARS:-300}"
# auto: terminal UI when run from a terminal, small window otherwise (hotkey);
# term | window | none (none = plain background playback, no controls)
TTS_UI="${TTS_UI:-auto}"
# Extra mpv arguments, e.g. TTS_MPV_ARGS=(--volume=80 --autofit=600x160)
declare -a TTS_MPV_ARGS=()
# Silence before the first chunk and after saved files (ms): the audio device
# often wakes up late and swallows the first syllable.
TTS_PAD_MS="${TTS_PAD_MS:-250}"
TTS_PIPER_BIN="${TTS_PIPER_BIN:-${HOME}/.venv/bin/piper}"
TTS_PIPER_DIR="${TTS_PIPER_DIR:-${HOME}/.cache/piper-tts}"
TTS_PIPER_VOICE_DE="${TTS_PIPER_VOICE_DE:-de_DE-thorsten-high}"
TTS_PIPER_VOICE_EN="${TTS_PIPER_VOICE_EN:-en_US-amy-medium}"
# OpenAI-compatible /v1/audio/speech endpoint (Kokoro-FastAPI, Chatterbox server, ...)
TTS_HTTP_URL="${TTS_HTTP_URL:-http://127.0.0.1:8880/v1/audio/speech}"
TTS_HTTP_MODEL="${TTS_HTTP_MODEL:-tts-1}"
TTS_HTTP_VOICE_DE="${TTS_HTTP_VOICE_DE:-}"
TTS_HTTP_VOICE_EN="${TTS_HTTP_VOICE_EN:-}"

# }}} = CONSTANTS =============================================================

# {{{ = FUNCTIONS =============================================================

usage() {
  cat <<EOF
Usage: tts-speak [OPTIONS] [--] [TEXT...]
       tts-speak toggle | stop | pause | prev | next | list

Read TEXT aloud. Without TEXT: stdin if piped, else the primary selection
(falls back to the clipboard). Text is cleaned first (tts-clean): footnote
markers, URLs, markdown and dotted abbreviations are not read out.

Commands:
  toggle           stop if currently speaking, else read the selection (hotkey)
  stop             stop speaking
  pause            pause/resume (mpv UI only)
  prev | next      restart the current chunk (or go to the previous one if
                   it just started) / skip to the next chunk
  list             list engines and voices

Options:
  -e, --engine E   piper | http                (default: ${TTS_ENGINE})
  -l, --lang L     de | en | auto              (default: auto-detect per text)
  -v, --voice V    engine-specific voice/model (default: per language, see conf);
                   piper multi-speaker models: MODEL:SPEAKER (name or id)
  -s, --speed X    speaking speed, 1.0 = normal (default: ${TTS_SPEED})
  -o, --output F   write audio to F (any ffmpeg extension) instead of playing
  -u, --ui U       auto | term | window | none (default: ${TTS_UI})
                   term/window play in mpv with your own mpv keys (pause, seek,
                   loop, speed, ...); < > go to the previous/next chunk (a few
                   sentences). Run from a terminal, term is the default and the
                   command stays in the foreground; from a hotkey, window.
      --no-clean   read the text exactly as given
  -h, --help       this help

Config: ${CONF_FILE} (sourced; see the example shipped in the dotfiles).
EOF
}

p_err() { printf 'tts-speak: %s\n' "$*" >&2; }

notify() {
  command -v notify-send > /dev/null 2>&1 || return 0
  notify-send -a tts-speak -t 2500 "tts-speak" "$*" || true
}

get_selection() {
  local text
  text="$(wl-paste --primary --no-newline 2> /dev/null)"
  [[ -n "${text//[[:space:]]/}" ]] || text="$(wl-paste --no-newline 2> /dev/null)"
  printf '%s' "${text}"
}

is_running() {
  local pid
  [[ -f "${PID_FILE}" ]] && pid="$(< "${PID_FILE}")" && [[ -n "${pid}" ]] && kill -0 "${pid}" 2> /dev/null
}

stop_speaking() {
  is_running || return 1
  local pid
  pid="$(< "${PID_FILE}")"
  # The worker was started with setsid, so its pid is also its process group:
  # one signal takes down the engine, the player and the worker itself.
  kill -- "-${pid}" 2> /dev/null || kill "${pid}" 2> /dev/null
  rm -f "${PID_FILE}"
}

# Engines: engine_NAME LANG VOICE SPEED CHUNKS_FILE OUT_DIR
# Read one chunk per line from CHUNKS_FILE and write playable audio files that
# sort in speaking order (*.wav) into OUT_DIR. A file must be complete once the
# next one exists, or once the engine has exited.

engine_piper() {
  local -r lang="$1" voice="$2" speed="$3" chunks="$4" out_dir="$5"
  [[ -x "${TTS_PIPER_BIN}" ]] || { p_err "piper not found: ${TTS_PIPER_BIN}"; return 1; }
  local scale
  scale="$(awk -v s="${speed}" 'BEGIN { printf "%.3f", 1 / s }')"
  # Multi-speaker models: "MODEL:SPEAKER", SPEAKER = name from the model's
  # speaker_id_map (e.g. "thor") or a plain id.
  local -a speaker_args=()
  local model="${voice}"
  if [[ "${voice}" == *:* ]]; then
    local speaker="${voice#*:}" model_json
    model="${voice%%:*}"
    model_json="${TTS_PIPER_DIR}/${model}.onnx.json"
    # Names win over ids: libritts-style models name speakers by number ("161065" is id 1).
    local sid
    sid="$(jq -r --arg s "${speaker}" '.speaker_id_map[$s] // empty' "${model_json}" 2> /dev/null)"
    if [[ -n "${sid}" ]]; then
      speaker="${sid}"
    elif [[ ! "${speaker}" =~ ^[0-9]+$ ]]; then
      p_err "unknown speaker '${speaker}' for ${model} (see: tts-speak list)"
      return 1
    fi
    speaker_args=(-s "${speaker}")
  fi
  # One process for all chunks: model load is paid once, and piper writes one
  # wav per input line as soon as it is synthesized.
  "${TTS_PIPER_BIN}" -m "${model}" --data-dir "${TTS_PIPER_DIR}" --length-scale "${scale}" \
    "${speaker_args[@]}" -d "${out_dir}" < "${chunks}" > /dev/null 2> "${out_dir}/../piper.err"
  # Piper can exit 0 yet write empty wavs (e.g. speaker id out of range).
  if grep -q -E 'Error|Traceback' "${out_dir}/../piper.err"; then
    p_err "piper failed: $(tail -n 1 "${out_dir}/../piper.err")"
    notify "piper failed (see tts-speak -h)"
    return 1
  fi
}

engine_http() {
  local -r lang="$1" voice="$2" speed="$3" chunks="$4" out_dir="$5"
  local line n=0 body tmp state
  # A server that unloads its model when idle needs ~30 s for the first clip; say so.
  state="$(curl -s -m 1 "${TTS_HTTP_URL%/v1/audio/speech}/health" 2> /dev/null | jq -r '.model // empty' 2> /dev/null)"
  [[ -z "${state}" || "${state}" == loaded ]] || notify "TTS server is loading its model (${state}); the first clip can take ~30 s"
  while IFS= read -r line; do
    (( ++n ))
    printf -v tmp '%s/%04d.part' "${out_dir}" "${n}"
    body="$(jq -nc --arg m "${TTS_HTTP_MODEL}" --arg i "${line}" --arg v "${voice}" --argjson s "${speed}" \
      '{model: $m, input: $i, response_format: "wav", speed: $s} + (if $v != "" then {voice: $v} else {} end)')"
    if curl -sS --fail -H 'Content-Type: application/json' -d "${body}" -o "${tmp}" "${TTS_HTTP_URL}"; then
      mv -- "${tmp}" "${tmp%.part}.wav"
    else
      p_err "http engine failed on chunk ${n}"
      return 1
    fi
  done < "${chunks}"
}

# Voice per language; "list"/"-v" can override. For piper this is a model name.
voice_for() {
  local -r engine="$1" lang="$2"
  case "${engine}:${lang}" in
    piper:de) printf '%s' "${TTS_PIPER_VOICE_DE}" ;;
    piper:*)  printf '%s' "${TTS_PIPER_VOICE_EN}" ;;
    http:de)  printf '%s' "${TTS_HTTP_VOICE_DE}" ;;
    http:*)   printf '%s' "${TTS_HTTP_VOICE_EN}" ;;
    *)        return 1 ;;
  esac
}

# Play files as the engine produces them. Liveness is checked BEFORE listing so
# a file written just before the engine exited is never missed.
play_chunks() {
  local -r out_dir="$1" prod="$2"
  local -i i=0 alive
  local -a files
  while :; do
    kill -0 "${prod}" 2> /dev/null && alive=1 || alive=0
    mapfile -t files < <(find "${out_dir}" -maxdepth 1 -name '*.wav' | LC_ALL=C sort)
    if (( ${#files[@]} > i + 1 )) || { (( alive == 0 )) && (( ${#files[@]} > i )); }; then
      pw-play -- "${files[i]}" || sleep 0.2
      (( ++i ))
    elif (( alive == 0 )); then
      break
    else
      sleep 0.05
    fi
  done
}

# mpv JSON IPC. Arguments are the mpv command and its parameters. Prints the
# reply's data field (if any); a missing socket or reply is not an error.
# Always wait for the reply: if socat closes first, mpv logs "Write error
# (Broken pipe)" to the terminal. On quit it returns at once (mpv closes the
# socket); other commands take effect at once, socat just lingers <= 0.3s.
mpv_ipc() {
  [[ -S "${MPV_SOCK}" ]] || return 1
  jq -nc '{command: $ARGS.positional}' --args "$@" | socat -t 0.3 - "UNIX-CONNECT:${MPV_SOCK}" 2> /dev/null |
    jq -r 'select(has("error")) | .data // empty' 2> /dev/null
}

# Play through mpv: it is started idle and every finished chunk is appended to
# its playlist, so playback starts early AND the whole playlist stays
# navigable (pause, seek, previous/next chunk, loop).
play_mpv() {
  local -r out_dir="$1" prod="$2" ui="$3"
  # ${...} below are mpv property expansions, not shell ones.
  # shellcheck disable=SC2016
  # Override what a personal mpv config may set: a looping playlist (loop-playlist=inf)
  # would never end, so the worker would never exit. Toggle looping in mpv itself if wanted.
  local -a args=(--idle=yes --input-ipc-server="${MPV_SOCK}" --gapless-audio=yes --keep-open=no
    --loop-playlist=no --loop-file=no --audio-display=no --msg-level=all=error --title=tts-speak
    --wayland-app-id=tts-speak '--osd-playing-msg=${playlist-pos-1}/${playlist-count}'
    '--term-status-msg=${?pause==yes:(Paused) }[${playlist-pos-1}/${playlist-count}] ${time-pos} / ${duration}')
  rm -f -- "${MPV_SOCK}"
  if [[ "${ui}" == term ]]; then
    # stdin is the text; keystrokes must come from the terminal itself.
    mpv "${args[@]}" --no-video --input-terminal=yes "${TTS_MPV_ARGS[@]}" < /dev/tty &
  else
    mpv "${args[@]}" --force-window=yes --autofit=520x140 --no-terminal "${TTS_MPV_ARGS[@]}" \
      < /dev/null > /dev/null 2>&1 &
  fi
  local -r player=$!
  [[ "${ui}" == window ]] && place_window "${player}" &

  local -i n
  for (( n = 0; n < 100; n++ )); do
    [[ -S "${MPV_SOCK}" ]] && break
    kill -0 "${player}" 2> /dev/null || { p_err "mpv exited at startup"; return 1; }
    sleep 0.05
  done

  local -i i=0 alive idle_checks=0
  local -a files
  while kill -0 "${player}" 2> /dev/null; do
    kill -0 "${prod}" 2> /dev/null && alive=1 || alive=0
    mapfile -t files < <(find "${out_dir}" -maxdepth 1 -name '*.wav' | LC_ALL=C sort)
    if (( ${#files[@]} > i + 1 )) || { (( alive == 0 )) && (( ${#files[@]} > i )); }; then
      if (( i == 0 && TTS_PAD_MS > 0 )); then
        mpv_ipc loadfile "${files[i]}" append-play -1 "af=lavfi=[adelay=${TTS_PAD_MS}:all=1]" > /dev/null
      else
        mpv_ipc loadfile "${files[i]}" append-play > /dev/null
      fi
      (( ++i ))
      idle_checks=0
    elif (( alive == 0 )); then
      # Everything appended: done once mpv has gone idle twice in a row (a
      # single check can race with the first file still loading).
      if [[ "$(mpv_ipc get_property idle-active)" == true ]]; then
        (( ++idle_checks >= 2 )) && break
      else
        idle_checks=0
      fi
    else
      sleep 0.1
    fi
  done
  mpv_ipc quit > /dev/null || true
  wait "${player}" 2> /dev/null || true
}

# Sway: put the player window top-right and reveal it. The window rule maps it
# invisible (opacity 0) and unfocused; sway-place has to be given the con_id,
# since without one it would move the focused window instead.
place_window() {
  local -r pid="$1"
  [[ -n "${SWAYSOCK:-}" ]] && command -v swaymsg > /dev/null 2>&1 || return 0
  local -i n
  local id=""
  for (( n = 0; n < 60; n++ )); do
    id="$(swaymsg -t get_tree 2> /dev/null |
      jq -r --argjson p "${pid}" '.. | objects | select(.app_id? == "tts-speak" and .pid? == $p) | .id' | head -n 1)"
    [[ -n "${id}" ]] && break
    sleep 0.05
  done
  [[ -n "${id}" ]] || return 0
  if command -v sway-place > /dev/null 2>&1; then
    sway-place top-right --con-id "${id}" --opacity 1 > /dev/null 2>&1 && return 0
  fi
  swaymsg "[con_id=${id}] opacity 1" > /dev/null 2>&1 || true
}

# pause / prev / next for hotkeys: they talk to the running mpv.
player_control() {
  if [[ ! -S "${MPV_SOCK}" ]] || ! is_running; then
    p_err "no mpv playback running (see --ui)"
    return 1
  fi
  case "$1" in
    pause) mpv_ipc cycle pause > /dev/null ;;
    next)  mpv_ipc playlist-next > /dev/null ;;
    prev)
      # Like a music player: restart the chunk, unless it only just started.
      local pos
      pos="$(mpv_ipc get_property time-pos)"
      if awk -v p="${pos:-0}" 'BEGIN { exit !(p > 2) }'; then
        mpv_ipc seek 0 absolute > /dev/null
      else
        mpv_ipc playlist-prev > /dev/null
      fi
      ;;
  esac
}

save_chunks() {
  local -r out_dir="$1" out_file="$2"
  local list="${out_dir}/concat.txt" f
  : > "${list}"
  while IFS= read -r f; do printf "file '%s'\n" "${f}" >> "${list}"; done \
    < <(find "${out_dir}" -maxdepth 1 -name '*.wav' | LC_ALL=C sort)
  local pad_s
  pad_s="$(awk -v ms="${TTS_PAD_MS}" 'BEGIN { printf "%.3f", ms / 1000 }')"
  ffmpeg -loglevel error -y -f concat -safe 0 -i "${list}" \
    -af "adelay=${TTS_PAD_MS}:all=1,apad=pad_dur=${pad_s}" "${out_file}"
}

list_all() {
  printf 'default engine: %s  (speed %s)\n\npiper voices (%s):\n' "${TTS_ENGINE}" "${TTS_SPEED}" "${TTS_PIPER_DIR}"
  local f n
  while IFS= read -r f; do
    n="$(jq -r '.num_speakers // 1' "${f}.json" 2> /dev/null)"
    printf '  %s%s\n' "$(basename "${f}" .onnx)" "$([[ "${n}" -gt 1 ]] && echo "  (${n} speakers, use MODEL:SPEAKER)")"
  done < <(find "${TTS_PIPER_DIR}" -maxdepth 1 -name '*.onnx' | LC_ALL=C sort)
  printf '\nin use: de=%s  en=%s\nhttp: %s\n' "${TTS_PIPER_VOICE_DE}" "${TTS_PIPER_VOICE_EN}" "${TTS_HTTP_URL}"
  local voices
  voices="$(curl -s -m 1 "${TTS_HTTP_URL%/audio/speech}/audio/voices" 2> /dev/null | jq -r '.voices[]?' 2> /dev/null | tr '\n' ' ')"
  if [[ -n "${voices}" ]]; then printf '  server voices: %s\n' "${voices}"; else printf '  (server not reachable)\n'; fi
}

# Worker: runs detached so the sway binding returns immediately.
speak() {
  local -r engine="$1" lang_opt="$2" voice_opt="$3" speed="$4" out_file="$5" do_clean="$6" ui="$7" text_file="$8"
  local text
  text="$(< "${text_file}")"
  rm -f -- "${text_file}"

  # Global on purpose: the EXIT trap runs after this function's locals are gone.
  tmp="$(mktemp -d "${RUN_DIR}/job.XXXXXX")"
  trap 'jobs -p | xargs -r kill 2> /dev/null; { [[ -n "${TTS_KEEP:-}" ]] || rm -rf -- "${tmp:-/nonexistent}"; }; rm -f "${PID_FILE}" "${MPV_SOCK}"' EXIT
  trap 'exit 130' INT TERM HUP

  local lang="${lang_opt}"
  if [[ "${do_clean}" == 1 ]]; then
    [[ "${lang}" == auto ]] && lang="$(tts-clean --detect <<< "${text}")"
    tts-clean --lang "${lang}" --chunk "${TTS_CHUNK_CHARS}" <<< "${text}" > "${tmp}/chunks.txt"
  else
    [[ "${lang}" == auto ]] && lang="$(tts-clean --detect <<< "${text}")"
    tr '\n' ' ' <<< "${text}" > "${tmp}/chunks.txt"; echo >> "${tmp}/chunks.txt"
  fi
  if [[ ! -s "${tmp}/chunks.txt" ]]; then notify "nothing to read"; return 0; fi

  local voice="${voice_opt}"
  [[ -n "${voice}" ]] || voice="$(voice_for "${engine}" "${lang}")" || true
  mkdir -p -- "${tmp}/out"
  "engine_${engine}" "${lang}" "${voice}" "${speed}" "${tmp}/chunks.txt" "${tmp}/out" &
  local -r prod=$!

  if [[ -n "${out_file}" ]]; then
    wait "${prod}" || return 1
    save_chunks "${tmp}/out" "${out_file}" && notify "saved ${out_file}"
  elif [[ "${ui}" == none ]]; then
    play_chunks "${tmp}/out" "${prod}"
  else
    [[ "${ui}" == term ]] && printf 'tts-speak: mpv controls (see your input.conf): space pause, < > prev/next chunk, q quit\n' >&2
    play_mpv "${tmp}/out" "${prod}" "${ui}"
  fi
}

worker() {
  mkdir -p -- "${RUN_DIR}"
  echo $$ > "${PID_FILE}"
  speak "$@"
}

main() {
  if [[ "${1:-}" == --worker ]]; then
    shift
    # shellcheck disable=SC1090
    [[ -f "${CONF_FILE}" ]] && source "${CONF_FILE}"
    worker "$@"
    return
  fi
  local engine lang=auto voice="" speed out_file="" do_clean=1 cmd=speak ui
  local -a words=()

  # shellcheck disable=SC1090
  [[ -f "${CONF_FILE}" ]] && source "${CONF_FILE}"
  engine="${TTS_ENGINE}"; speed="${TTS_SPEED}"; ui="${TTS_UI}"

  while (( $# > 0 )); do
    case "$1" in
      toggle|stop|pause|prev|next|list) cmd="$1" ;;
      -e|--engine) engine="$2"; shift ;;
      -l|--lang)   lang="$2"; shift ;;
      -v|--voice)  voice="$2"; shift ;;
      -s|--speed)  speed="$2"; shift ;;
      -o|--output) out_file="$2"; shift ;;
      -u|--ui)     ui="$2"; shift ;;
      --no-clean)  do_clean=0 ;;
      -h|--help)   usage; return 0 ;;
      --)          shift; words+=("$@"); break ;;
      -*)          p_err "unknown option: $1"; usage >&2; return 2 ;;
      *)           words+=("$1") ;;
    esac
    shift
  done

  mkdir -p -- "${RUN_DIR}"
  case "${cmd}" in
    list) list_all; return 0 ;;
    stop) stop_speaking || p_err "not speaking"; return 0 ;;
    pause|prev|next) player_control "${cmd}"; return ;;
    toggle) stop_speaking && return 0 ;;
  esac

  declare -F "engine_${engine}" > /dev/null || { p_err "unknown engine: ${engine}"; return 2; }

  local text=""
  if (( ${#words[@]} > 0 )); then
    text="${words[*]}"
  else
    [[ -t 0 ]] || text="$(cat)"
    # No text on stdin (a terminal, or an empty/closed stdin as under a hotkey): use the selection.
    [[ -n "${text//[[:space:]]/}" ]] || text="$(get_selection)"
  fi
  if [[ -z "${text//[[:space:]]/}" ]]; then notify "nothing selected"; return 1; fi

  # Resolve the UI: mpv gives pause/seek/loop for free; without it (or when
  # writing a file) fall back to plain pw-play.
  if [[ -n "${out_file}" ]] || ! command -v mpv > /dev/null 2>&1 || ! command -v socat > /dev/null 2>&1; then
    ui=none
  elif [[ "${ui}" == auto || "${ui}" == term ]]; then
    if [[ -t 1 && -r /dev/tty ]]; then ui=term; else ui=window; fi
  fi
  [[ "${ui}" =~ ^(term|window|none)$ ]] || { p_err "unknown ui: ${ui}"; return 2; }

  # Replace a running read-aloud instead of overlapping two voices.
  stop_speaking || true

  # Text goes through a file: long chapters would exceed the argv size limit.
  local text_file
  text_file="$(mktemp "${RUN_DIR}/input.XXXXXX")"
  printf '%s' "${text}" > "${text_file}"

  if [[ -n "${out_file}" || "${ui}" == term || -n "${TTS_FOREGROUND:-}" ]]; then
    worker "${engine}" "${lang}" "${voice}" "${speed}" "${out_file}" "${do_clean}" "${ui}" "${text_file}"
  else
    # Detached worker: as session leader its pid is the process group id that
    # stop_speaking() signals.
    setsid -f "${SELF}" --worker "${engine}" "${lang}" "${voice}" "${speed}" "${out_file}" "${do_clean}" "${ui}" "${text_file}"
  fi
}

# }}} = FUNCTIONS =============================================================

main "$@"
