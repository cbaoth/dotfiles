#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; indent-tabs-mode: nil; tab-width: 2 -*-
# vim: ft=bash:et:ts=2:sts=2:sw=2
# code: language=bash insertSpaces=true tabSize=2
# shellcheck shell=bash
#
# voice-note: Dictate a quick note straight into the notes inbox.

# set options
# -e omitted intentionally: stop/transcribe must always reach the archive and
# notify steps — aborting mid-way is how a captured thought gets lost, which is
# the one unacceptable outcome here.
set -o pipefail
set -o nounset
(( ${DEBUG_LVL:-0} >= 2 )) && set -o xtrace

# {{{ = CONSTANTS =============================================================

declare -r NOTE_DIR="${VOICE_NOTE_DIR:-${QN_DIR:-${NOTES_DIR:-${HOME}/notes}/inbox}}"

# Recording state lives in the runtime dir: tmpfs, per-user, wiped on logout, so
# a crashed recording can never resurrect as a stale lock on the next boot.
declare -r RUN_DIR="${XDG_RUNTIME_DIR:-/tmp/$(id -u)}/voice-note"
declare -r PID_FILE="${RUN_DIR}/recording.pid"
declare -r WAV_FILE="${RUN_DIR}/recording.wav"
declare -r LOCK_FILE="${RUN_DIR}/voice-note.lock"

# Raw audio is kept so a garbled transcription is never a lost thought. It stays
# OUT of any git repo on purpose: large binaries, and these are recordings of
# unfiltered personal thinking (AGENTS.md: "no git repo at all").
declare -r AUDIO_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/voice-note/audio"
declare -ri KEEP_DAYS="${VOICE_NOTE_KEEP_DAYS:-7}"

# whisper.cpp via the vocalinux venv: the model is already downloaded and the
# Vulkan path loads it in ~0.2s. VOICE_NOTE_PWCPP/-MODEL repoint both if
# vocalinux moves or is removed.
declare -r PWCPP="${VOICE_NOTE_PWCPP:-${HOME}/.local/share/vocalinux/venv/bin/pwcpp}"
declare -r MODEL="${VOICE_NOTE_MODEL:-${HOME}/.local/share/vocalinux/models/whispercpp/ggml-small.bin}"
declare -r LANGUAGE="${VOICE_NOTE_LANG:-auto}"

# pwcpp hard-rejects anything that is not 16 kHz mono; this is not a preference.
declare -ri RATE=16000

# Empty = pipewire's default source. Set when the default is the wrong device
# (a muted webcam mic is a silent recording, not an error): `wpctl status`
# lists the ids under Sources.
declare -r TARGET="${VOICE_NOTE_TARGET:-}"

# Toggle mode can be left recording by accident. 10 min is well past any single
# thought and still short enough that a forgotten session is not a huge file.
declare -ri MAX_SECONDS="${VOICE_NOTE_MAX_SECONDS:-600}"

# Below this the "recording" is a mis-press, not a thought. 0.4s at 16kHz/s16.
declare -ri MIN_BYTES=12800

# Smallest gap between two accepted toggles. Shorter than any deliberate
# press-pause-press, longer than a keyboard repeat interval (~30/s = 33ms).
declare -r TOGGLE_STAMP="${RUN_DIR}/last-toggle"
declare -ri DEBOUNCE_MS="${VOICE_NOTE_DEBOUNCE_MS:-400}"

# }}} = CONSTANTS =============================================================

# {{{ = FUNCTIONS =============================================================

usage() {
  cat <<EOF
Usage: voice-note <command>

Record speech, transcribe it locally with whisper.cpp, and append it to today's
note in ${NOTE_DIR}. No text injection and no focused window required.

Commands:
  start       Begin recording (no-op if already recording)
  stop        End recording, transcribe, append, notify
  toggle      stop if recording, else start
  status      Print whether a recording is in progress
  -h, --help  This help

Environment:
  VOICE_NOTE_DIR          Note directory (default: \$QN_DIR, else \${HOME}/notes/inbox);
                          notes are saved via quicknote when it is installed
  VOICE_NOTE_MODEL        ggml model file (default: vocalinux's ggml-small.bin)
  VOICE_NOTE_PWCPP        pwcpp binary (default: vocalinux venv)
  VOICE_NOTE_LANG         Language code or 'auto' (default: auto)
  VOICE_NOTE_MAX_SECONDS  Auto-stop guard (default: 600)
  VOICE_NOTE_KEEP_DAYS    Days to keep raw audio (default: 7)
  VOICE_NOTE_DEBOUNCE_MS  Minimum gap between two toggles (default: 400)
  VOICE_NOTE_TARGET       Input device id/name (default: pipewire default;
                          see 'wpctl status' under Sources)
  VOICE_NOTE_CPU=1        Force CPU decoding, leaving the GPU free for games
                          or generative AI (sets GGML_VK_VISIBLE_DEVICES=)

Sway bindings (dotfiles/.config/sway/config.d/40-keybindings.conf):
  \$altgr+F6            toggle
  \$altgr+F5            hold to talk
EOF
}

p_msg()  { printf '%s\n' "$*"; }
p_err()  { printf 'ERROR: %s\n' "$*" >&2; }
p_warn() { printf 'WARNING: %s\n' "$*" >&2; }

# Desktop feedback. Never fatal: a missing notification daemon must not cost a
# captured note, so every failure here is swallowed.
notify() {
  local -r urgency="$1" title="$2" body="$3"
  command -v notify-send > /dev/null 2>&1 || return 0
  notify-send --app-name='voice-note' --urgency="${urgency}" \
    --icon=audio-input-microphone "${title}" "${body}" 2> /dev/null || true
}

# True when a recording is actually running, not merely when a pid file exists
# (pw-record can be killed from outside).
is_recording() {
  local pid
  [[ -f "${PID_FILE}" ]] || return 1
  pid="$(< "${PID_FILE}")" 2> /dev/null || return 1
  [[ -n "${pid}" ]] && kill -0 "${pid}" 2> /dev/null
}

# Rate-limit `toggle` only. start/stop are idempotent (repeats print
# "already recording"/"not recording" and notify nothing), so they need no
# guard; toggle is the one that flips state and fires a notification each time.
#
# Belt and braces alongside sway's --no-repeat: that only covers this one
# binding on this one compositor, while this covers every path that ever calls
# toggle. The window is well under the MIN_BYTES floor, so no note a human
# could actually have spoken is ever rejected by it.
debounce_toggle() {
  local now last
  now="$(date +%s%3N)"

  if [[ -f "${TOGGLE_STAMP}" ]]; then
    last="$(< "${TOGGLE_STAMP}")" 2> /dev/null || last=0
    [[ "${last}" =~ ^[0-9]+$ ]] || last=0
    if (( now - last < DEBOUNCE_MS )); then
      return 1
    fi
  fi

  printf '%s\n' "${now}" > "${TOGGLE_STAMP}"
  return 0
}

do_start() {
  local -i pid

  if is_recording; then
    p_msg 'already recording'
    return 0
  fi

  mkdir -p "${RUN_DIR}" || { p_err "cannot create ${RUN_DIR}"; return 1; }
  rm -f "${WAV_FILE}"

  local -a target_opt=()
  [[ -n "${TARGET}" ]] && target_opt=(--target "${TARGET}")

  # 9>&- is load-bearing, same reason as the watchdog below: pw-record would
  # otherwise inherit the flock fd and hold the lock for the whole recording,
  # so the stop that ends it could never acquire the lock.
  pw-record "${target_opt[@]}" --rate "${RATE}" --channels 1 --format s16 \
    "${WAV_FILE}" > /dev/null 2>&1 9>&- &
  pid=$!

  # pw-record exits immediately when it cannot reach pipewire. Without this
  # check start would report success, leave a stale pid file, and the thought
  # would be lost at stop time with no warning.
  sleep 0.3
  if ! kill -0 "${pid}" 2> /dev/null; then
    rm -f "${PID_FILE}" "${WAV_FILE}"
    notify critical 'Voice note' 'Could not start recording'
    p_err 'pw-record failed to start (is pipewire running? check VOICE_NOTE_TARGET)'
    return 1
  fi

  printf '%s\n' "${pid}" > "${PID_FILE}"

  # Auto-stop guard. It re-reads the pid file before firing so a recording
  # started after this one finished can never be killed by a stale watchdog.
  #
  # `exec 9>&-` is load-bearing: the subshell would otherwise inherit the flock
  # on fd 9 and hold it for MAX_SECONDS, so every later command — including the
  # stop for this very recording — would fail with "another voice-note is
  # running".
  (
    exec 9>&-
    sleep "${MAX_SECONDS}"
    [[ -f "${PID_FILE}" && "$(< "${PID_FILE}")" == "${pid}" ]] \
      && kill -TERM "${pid}" 2> /dev/null
  ) > /dev/null 2>&1 &
  disown 2> /dev/null || true

  notify low 'Voice note' 'Recording…'
  p_msg "recording (pid ${pid})"
}

# Join whisper's per-segment lines into one paragraph: these are single thoughts,
# and segment breaks are an artefact of the decoder, not of what was said.
read_transcript() {
  local -r txt="$1"
  [[ -f "${txt}" ]] || return 1
  # Drop whisper's non-speech annotations ([BLANK_AUDIO], (silence), [MUSIC]).
  # Only whole lines that are nothing but a bracketed token are removed, so
  # ordinary speech that happens to contain brackets survives untouched.
  sed 's/^[[:space:]]*//; s/[[:space:]]*$//' "${txt}" \
    | grep -v '^$' \
    | grep -vE '^[[(][^])]*[])]$' \
    | paste -sd' ' -
}

transcribe() {
  local -r wav="$1"
  local -a env_prefix=()

  (( ${VOICE_NOTE_CPU:-0} )) && env_prefix=(env 'GGML_VK_VISIBLE_DEVICES=')

  "${env_prefix[@]}" "${PWCPP}" -m "${MODEL}" --language "${LANGUAGE}" \
    -otxt "${wav}" > /dev/null 2>&1

  read_transcript "${wav}.txt"
}

archive_audio() {
  local -r wav="$1" stamp="$2"
  mkdir -p "${AUDIO_DIR}" 2> /dev/null || return 0
  mv "${wav}" "${AUDIO_DIR}/${stamp}.wav" 2> /dev/null || true
  # Prune on every run: no timer to install, and the cost is one find.
  find "${AUDIO_DIR}" -type f -name '*.wav' -mtime "+${KEEP_DAYS}" -delete \
    2> /dev/null || true
}

do_stop() {
  local pid text stamp note_file
  local -i waited=0

  if ! is_recording; then
    p_msg 'not recording'
    return 0
  fi

  pid="$(< "${PID_FILE}")"
  # TERM, not INT: both finalize the WAV header correctly (verified), but a
  # shell that backgrounds a job without job control sets SIGINT to SIG_IGN for
  # that child — an INT would then be silently dropped and stop would hang.
  kill -TERM "${pid}" 2> /dev/null
  while kill -0 "${pid}" 2> /dev/null && (( waited < 30 )); do
    sleep 0.1
    waited+=1
  done
  # Last resort. The header is then whatever pw-record last flushed, so the note
  # may be short — still better than a stop that never returns.
  if kill -0 "${pid}" 2> /dev/null; then
    p_warn 'pw-record did not exit on TERM, killing'
    kill -KILL "${pid}" 2> /dev/null
    sleep 0.2
  fi
  rm -f "${PID_FILE}"

  if [[ ! -s "${WAV_FILE}" ]] || (( $(stat -c %s "${WAV_FILE}" 2> /dev/null || echo 0) < MIN_BYTES )); then
    rm -f "${WAV_FILE}"
    notify normal 'Voice note' 'Too short — nothing saved'
    p_warn 'recording too short, discarded'
    return 0
  fi

  stamp="$(date +%Y-%m-%dT%H-%M-%S)"
  text="$(transcribe "${WAV_FILE}")"
  rm -f "${WAV_FILE}.txt"

  if [[ -z "${text}" ]]; then
    archive_audio "${WAV_FILE}" "${stamp}"
    notify critical 'Voice note' "No speech recognized — audio kept as ${stamp}.wav"
    p_warn 'empty transcription; audio kept'
    return 1
  fi

  # quicknote owns the note format, the day rollover and the locking shared by
  # every writer (qn, qne, ...); the inline append is only a fallback for a
  # host without it, in the same format.
  if command -v quicknote > /dev/null 2>&1; then
    printf '%s' "${text}" | QN_DIR="${NOTE_DIR}" quicknote -q --stdin 9>&- \
      || { p_err "quicknote failed to save the note"; return 1; }
  else
    mkdir -p "${NOTE_DIR}" || { p_err "cannot create ${NOTE_DIR}"; return 1; }
    note_file="${NOTE_DIR}/$(date +%F).md"
    {
      printf '\n## %s\n\n%s\n' "$(date --iso-8601=seconds)" "${text}"
    } >> "${note_file}" || { p_err "cannot append to ${note_file}"; return 1; }
  fi

  # Clipboard too: the thought is usable immediately, wherever you are.
  # 9>&- again: wl-copy daemonizes to serve the clipboard, so without it the
  # lock would stay held until the next unrelated copy — every later voice-note
  # would fail with "another voice-note is running".
  command -v wl-copy > /dev/null 2>&1 \
    && printf '%s' "${text}" | wl-copy 9>&- 2> /dev/null

  archive_audio "${WAV_FILE}" "${stamp}"
  notify normal 'Voice note saved' "${text:0:300}"
  p_msg "${text}"
}

# }}} = FUNCTIONS =============================================================

# {{{ = MAIN ==================================================================

main() {
  local -r command="${1:-toggle}"

  case "${command}" in
    -h|--help) usage; exit 0 ;;
    start|stop|toggle|status) ;;
    *) p_err "unknown command: ${command}"; usage >&2; exit 1 ;;
  esac

  for tool in pw-record "${PWCPP}"; do
    command -v "${tool}" > /dev/null 2>&1 || [[ -x "${tool}" ]] || {
      p_err "required tool not found: ${tool}"
      exit 1
    }
  done
  [[ -f "${MODEL}" ]] || { p_err "model not found: ${MODEL}"; exit 1; }

  if [[ "${command}" == status ]]; then
    is_recording && { p_msg 'recording'; exit 0; }
    p_msg 'idle'
    exit 0
  fi

  # A double-tap on the hotkey must not race start against stop. Held for the
  # whole command, so a slow transcription also blocks a new start.
  #
  # -n, not -w: a held hotkey must be DROPPED, never queued. Waiting would let a
  # burst of repeats pile up and then replay one after another, which is what
  # buried the screen in notifications. A hotkey press that arrives while we are
  # busy is a press the user did not mean; discarding it is the correct answer.
  mkdir -p "${RUN_DIR}"
  exec 9> "${LOCK_FILE}"
  if ! flock -n 9; then
    p_msg 'busy, ignoring'
    exit 0
  fi

  case "${command}" in
    start)  do_start ;;
    stop)   do_stop ;;
    toggle)
      debounce_toggle || exit 0
      if is_recording; then do_stop; else do_start; fi
      ;;
  esac
}

main "$@"

# }}} = MAIN ==================================================================
