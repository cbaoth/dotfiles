# Suspend the system after optional lock-screen and audio cleanup steps.
## lock screen before suspend (currently disabled)
#swaylock

# kill pulseaudio (doesn't always recover, respawn instead)
pkill -9 pulseaudio

# suspend system
systemctl suspend
