#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; indent-tabs-mode: nil; tab-width: 2 -*-
# vim: ft=bash:et:ts=2:sts=2:sw=2
# code: language=bash insertSpaces=true tabSize=2
# shellcheck shell=bash
#
# GitHub Copilot desktop app wrapper: appends GNOME to XDG_CURRENT_DESKTOP when
# running outside a recognised desktop (e.g. Sway), so Electron's safeStorage
# can use the keyring. Same root cause and fix as bin/claude-desktop. Untested
# for this app: the sign-in worked without it, so drop it if it ever misbehaves.

case ":${XDG_CURRENT_DESKTOP:-}:" in
  *:GNOME:*|*:KDE:*) ;;
  *) export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:+${XDG_CURRENT_DESKTOP}:}GNOME" ;;
esac

exec "${HOME}/Applications/GitHub-Copilot-linux-x64.AppImage" "$@"
