#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; indent-tabs-mode: nil; tab-width: 2 -*-
# vim: ft=bash:et:ts=2:sts=2:sw=2
# code: language=bash insertSpaces=true tabSize=2
# shellcheck shell=bash
#
# Launch a tray applet only once waybar's system tray is ready to receive it.
#
# Background: launching tray apps straight from the sway config raced waybar's
# startup -- apps that registered their StatusNotifierItem before waybar's tray
# module was up ended up with no icon and had to be restarted by hand. The old
# workaround (`until pgrep -x waybar; do sleep 1; done; sleep 2; ...`) was
# copy-pasted across every tray `exec` and only guessed at readiness with a
# fixed sleep.
#
# The real dependency is the `org.kde.StatusNotifierWatcher` D-Bus name, which
# waybar's tray module registers on the session bus once it can host tray items
# (verified live: waybar owns it plus `org.kde.StatusNotifierHost-<pid>`). We
# block on that name via `gdbus wait`, so the launch is deterministic rather
# than timed. A timeout guard ensures we still launch (late) if waybar never
# comes up, so a missing bar never silently swallows an app.
#
# Usage: sway-run-after-waybar [-t SECS] COMMAND [ARG...]
# Example (in ~/.config/sway/config):
#   exec sway-run-after-waybar flatpak run org.keepassxc.KeePassXC
#   exec sway-run-after-waybar copyq

# shellcheck disable=SC2155
declare -r SCRIPT_FILE="${0##*/}"

set -o errexit
set -o pipefail
set -o nounset
(( ${DEBUG_LVL:-0} >= 2 )) && set -o xtrace

# D-Bus name that signals "waybar's tray is ready to host items".
declare -r WATCHER_NAME="org.kde.StatusNotifierWatcher"
# Fallback timeout (seconds): launch anyway if the tray never appears.
declare -i timeout=30

p_err() { printf '\033[31mERROR\033[0m: %s\n' "$*" >&2; }

p_usg() {
  cat <<EOF
Usage: ${SCRIPT_FILE} [-t SECS] COMMAND [ARG...]

Wait until waybar's system tray (${WATCHER_NAME}) is ready on the session bus,
then exec COMMAND. If the tray does not appear within the timeout, COMMAND is
launched anyway.

Options:
  -t, --timeout SECS   Max seconds to wait for the tray (default: ${timeout})
  -h, --help           Show this help message and exit
EOF
}

main() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)    p_usg; exit 0 ;;
      -t|--timeout) timeout="${2:-}"; shift 2 || true ;;
      --)           shift; break ;;
      -*)           p_err "unknown option: '$1'"; p_usg >&2; exit 1 ;;
      *)            break ;;
    esac
  done

  if [[ $# -eq 0 ]]; then
    p_err "no COMMAND given"
    p_usg >&2
    exit 1
  fi

  if [[ ! "${timeout}" =~ ^[0-9]+$ ]]; then
    p_err "timeout must be a non-negative integer: '${timeout}'"
    exit 1
  fi

  # gdbus wait blocks until the name is owned (exit 0), or exits non-zero on
  # timeout. Either way we fall through to launch -- late is better than never.
  if command -v gdbus >/dev/null 2>&1; then
    gdbus wait --session --timeout "${timeout}" "${WATCHER_NAME}" \
      || p_err "timed out after ${timeout}s waiting for ${WATCHER_NAME}; launching '$1' anyway"
  else
    p_err "gdbus not found; launching '$1' without waiting for the tray"
  fi

  exec "$@"
}

main "$@"
