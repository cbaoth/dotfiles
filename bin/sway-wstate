#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; indent-tabs-mode: nil; tab-width: 2 -*-
# vim: ft=bash:et:ts=2:sts=2:sw=2
# code: language=bash insertSpaces=true tabSize=2
# shellcheck shell=bash
# The $-names in sway_cmd calls are sway config variables, single-quoted on purpose
# shellcheck disable=SC2016
#
# Sway window state management: floating and sticky with consistent border indicators.
#
# Border convention (values: sway config, 20-styles.conf / 30-variables.conf):
#   sticky + floating  → $stick:  $border_floating_stick + $title_sticky
#   floating only      → $float:  $border_floating
#   tiling             → $border_default, plain "%title"
#
# Note: per-window border colors are not supported by Sway; border thickness
# plus a colored (pango markup) title is the closest sticky indicator.
#
# Usage: sway-wstate <command>
#   float   Toggle floating state of the focused window
#   sticky  Toggle sticky state; auto-floats the window when enabling sticky
#   sheer [OPACITY]
#           Toggle translucency of the focused window: opaque -> OPACITY
#           (default 0.85), translucent -> opaque. Bind with the config's
#           $opacity so a window auto-set to $sheer can be made readable.

# -e: exit on error  -u: unset vars are errors  -o pipefail: propagate pipe failures
set -euo pipefail

p_err() { printf '\033[31mERROR\033[0m: %s\n' "$*" >&2; }

# Sway expands config variables ($stick, ...) only while reading the config,
# never in IPC commands, so resolve them from the same files sway reads.
readonly SWAY_CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/sway"

# Expand sway config variables in a command and run it via swaymsg.
# Usage: sway_cmd 'COMMAND with $vars'
sway_cmd() {
  local cmd
  cmd="$(awk -v tmpl="$1" '
    # join "\" continuation lines, then collect `set $name value`
    { line = line $0 }
    /\\$/ { sub(/\\$/, " ", line); next }
    line ~ /^[ \t]*set[ \t]+\$/ {
      sub(/^[ \t]*set[ \t]+\$/, "", line)
      name = line; sub(/[ \t].*/, "", name)
      val = substr(line, length(name) + 1); sub(/^[ \t]+/, "", val)
      vars[name] = val
    }
    { line = "" }
    END {
      # longest names first, so $border_floating_stick beats $border_floating;
      # repeat for values that reference other variables
      n = 0; for (k in vars) keys[++n] = k
      for (i = 2; i <= n; i++)
        for (j = i; j > 1 && length(keys[j]) > length(keys[j-1]); j--) {
          t = keys[j]; keys[j] = keys[j-1]; keys[j-1] = t
        }
      for (pass = 0; pass < 10 && index(tmpl, "$"); pass++)
        for (i = 1; i <= n; i++) {
          k = "$" keys[i]
          while ((p = index(tmpl, k)))
            tmpl = substr(tmpl, 1, p - 1) vars[keys[i]] substr(tmpl, p + length(k))
        }
      print tmpl
    }' "$SWAY_CONF_DIR/config" "$SWAY_CONF_DIR"/config.d/*.conf)"
  swaymsg -- "$cmd"
}

# Output: "<sticky> <type>", e.g. "true floating_con" or "false con"
get_focused_state() {
  swaymsg -t get_tree \
    | jq -r 'recurse(.nodes[]?, .floating_nodes[]?) | select(.focused == true) | "\(.sticky) \(.type)"' \
    | head -1
}

cmd_float() {
  local sticky type
  read -r sticky type < <(get_focused_state)

  # $-names are sway config variables (20-styles.conf, 30-variables.conf)
  if [[ "$type" == "floating_con" ]]; then
    sway_cmd 'floating disable, border $border_default, title_format "%title"'
  elif [[ "$sticky" == "true" ]]; then
    # Preserve sticky indicator if sticky was already set
    sway_cmd '$stick'
  else
    sway_cmd '$float'
  fi
}

cmd_sticky() {
  local sticky type
  swaymsg sticky toggle
  read -r sticky type < <(get_focused_state)

  if [[ "$sticky" == "true" ]]; then
    sway_cmd '$stick'
  else
    sway_cmd '$unstick'
  fi
}

cmd_sheer() {
  local -r target="${1:-0.85}"
  # Sanity: target must be a float in [0,1] (sway rejects the rest anyway).
  [[ "$target" =~ ^(0(\.[0-9]+)?|1(\.0+)?|\.[0-9]+)$ ]] \
    || { p_err "opacity must be a float in [0,1] (got '${target}')"; exit 1; }

  # sway (1.11) exposes no window opacity via IPC, so we cannot read the current
  # value to toggle against it. Track "is sheer" with a mark instead (marks ARE
  # reported, and underscore-prefixed ones are never drawn). Windows auto-set to
  # $sheer via for_window carry a plain `_sheer` mark; a user toggle adds a
  # con_id-scoped `_sheer_<id>` so multiple windows stay independent (a shared
  # mark would jump to the last-marked window).
  local cid smark
  read -r cid smark < <(swaymsg -t get_tree | jq -r '
    [ recurse(.nodes[]?, .floating_nodes[]?) | select(.focused == true) ] | first
    | if . == null then empty
      else "\(.id) \((((.marks // []) | map(select(startswith("_sheer"))) | first)) // "-")"
      end')
  [[ -n "${cid:-}" ]] || { p_err "no focused window"; exit 1; }

  if [[ "$smark" != "-" ]]; then
    swaymsg "[con_id=$cid] unmark $smark, opacity 1" > /dev/null       # sheer -> opaque
  else
    swaymsg "[con_id=$cid] mark --add _sheer_$cid, opacity $target" > /dev/null  # opaque -> sheer
  fi
}

p_usg() { printf 'Usage: %s <float|sticky|sheer [OPACITY]>\n' "$(basename "$0")"; }

main() {
  local cmd="${1:-}"
  case "$cmd" in
    float)  cmd_float ;;
    sticky) cmd_sticky ;;
    sheer)  cmd_sheer "${2:-}" ;;
    -h|--help) p_usg; exit 0 ;;
    *)
      p_err "unknown command: '${cmd}'"
      p_usg >&2
      exit 1
      ;;
  esac
}

main "$@"
