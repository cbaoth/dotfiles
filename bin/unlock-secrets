#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; indent-tabs-mode: nil; tab-width: 2 -*-
# vim: ft=bash:et:ts=2:sts=2:sw=2
# shellcheck shell=bash
#
# unlock-secrets: the counterpart to bin/lock-secrets. Bring up the unlock
# prompts for the secret stores that lock-secrets locked, instead of waiting for
# some application to demand a credential hours later.
#
# The problem it solves: lock-secrets runs on `before-sleep`, so after a resume
# the KeePassXC database and every persistent gnome-keyring collection are
# locked -- but nothing ever asks you to unlock them. gnome-keyring in
# particular stays silently locked (verified: both `login` and
# `Default_keyring` reported Locked=true long after a resume, while the SSH keys
# had already been restored by a manual KeePassXC unlock). Meanwhile VS Code's
# remote sessions have already failed and are showing reconnect dialogs, because
# the SSH keys KeePassXC feeds to the agent are not there yet.
#
# Timing: this must run AFTER swaylock is dismissed. On `after-resume` swaylock
# is still up, and a prompt raised then sits behind the lock screen where it
# cannot be answered. --wait-for-unlock handles that.
#
# Every step is best effort and independent, and the script always exits 0, so
# it can be chained from a swayidle hook without breaking the caller -- same
# contract as lock-secrets.
#
# See also: docs/troubleshooting/secret-stores-locked-after-resume.md

set -o errtrace
set -o pipefail
set -o nounset
(( ${DEBUG_LVL:-0} >= 2 )) && set -o xtrace

trap 'printf "\nINTERRUPT\n" >&2; exit 1' SIGINT SIGTERM

p_err()  { printf '\033[31mERROR\033[0m: %s\n' "$*" >&2; }
p_warn() { printf '\033[33mWARN\033[0m: %s\n' "$*" >&2; }
p_info() { (( VERBOSE )) && printf '%s\n' "$*"; return 0; }

# {{{ = CONSTANTS ============================================================
declare -r KPXC_NAME="org.keepassxc.KeePassXC.MainWindow"
declare -r KPXC_APP="org.keepassxc.KeePassXC"
declare -r SECRETS_NAME="org.freedesktop.secrets"

# Only one waiter at a time: every resume would otherwise leave another sleeping
# process behind if the screen is never unlocked.
declare -r LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/unlock-secrets.lock"

declare -i VERBOSE=0
declare -i DRY_RUN=0
declare -i WAIT_UNLOCK=0
declare -i WAIT_TIMEOUT=3600
declare -i FORCE_KPXC=0
declare -i KEYRING_ONLY=0
# Restrict the keyring step to collections whose label or path contains this.
# Mainly for testing one specific keyring; empty means all of them.
declare ONLY_COLLECTION=""
# Also offer collections that contain no user secrets (see the keyring step).
declare -i ALL_COLLECTIONS=0
# }}} = CONSTANTS ============================================================

# {{{ = HELPERS =============================================================
usage() {
  cat <<-EOF
	Usage: unlock-secrets [OPTIONS]

	Raise the unlock prompts for locked secret stores (gnome-keyring, KeePassXC).
	Best effort: absent or already-unlocked stores are skipped, exit code is
	always 0.

	Options:
	  -w, --wait-for-unlock   wait for swaylock to exit before prompting, so the
	                          dialog is not raised behind the lock screen
	      --timeout SECS      give up waiting after SECS (default: ${WAIT_TIMEOUT})
	  -k, --keyring-only      skip KeePassXC
	  -c, --collection NAME   only this keyring collection (label or path
	                          substring), e.g. -c Default_keyring
	  -K, --force-keepassxc   raise KeePassXC even if it looks unlocked
	  -a, --all-collections   also prompt for keyrings holding no user secrets
	                          (skipped by default -- see below)
	  -v, --verbose           report what was done
	  -n, --dry-run           print the actions instead of performing them
	  -h, --help              show this help

	KeePassXC caveat: its D-Bus interface (${KPXC_NAME})
	exposes openDatabase, lockAllDatabases and closeAllDatabases -- there is NO
	way to ask whether a database is locked, and no database path is recorded in
	keepassxc.ini here. So "is it locked?" is inferred from the SSH agent: this
	host's keys come from KeePassXC's agent integration, which removes them when
	the database locks, so an agent with no identities means a locked database.
	That inference is specific to this setup; use -K to bypass it.

	Keyrings with no user secrets are skipped: gnome-keyring keeps an internal
	"gkr:compat:hashed:keyring" marker, and a collection holding only that has
	nothing to offer. On this host 'login' is exactly that after the migration to
	'Default keyring', and its password is not the account password, so prompting
	for it would be an unanswerable dialog on every resume. Use -a to include it.
	EOF
}

parse_args() {
  while (( $# > 0 )); do
    case "$1" in
      -w|--wait-for-unlock) WAIT_UNLOCK=1 ;;
      --timeout)
        [[ $# -ge 2 ]] || { p_err "--timeout requires a value"; exit 2; }
        WAIT_TIMEOUT="$2"; shift ;;
      -k|--keyring-only) KEYRING_ONLY=1 ;;
      -c|--collection)
        [[ $# -ge 2 ]] || { p_err "--collection requires a value"; exit 2; }
        ONLY_COLLECTION="$2"; shift ;;
      -K|--force-keepassxc) FORCE_KPXC=1 ;;
      -a|--all-collections) ALL_COLLECTIONS=1 ;;
      -v|--verbose) VERBOSE=1 ;;
      -n|--dry-run) DRY_RUN=1; VERBOSE=1 ;;
      -h|--help) usage; exit 0 ;;
      *) p_err "unknown option: $1"; usage >&2; exit 2 ;;
    esac
    shift
  done
}

bus_has_name() { busctl --user status "$1" &>/dev/null; }

# Block until swaylock is gone. A prompt raised while it is up is invisible and
# unanswerable. Returns 0 when the screen is (or became) unlocked, 1 on timeout.
wait_for_unlock() {
  pgrep -x swaylock &>/dev/null || { p_info "wait: swaylock not running"; return 0; }
  p_info "wait: swaylock up, waiting up to ${WAIT_TIMEOUT}s"
  local -i waited=0
  while pgrep -x swaylock &>/dev/null; do
    (( waited >= WAIT_TIMEOUT )) && { p_warn "wait: timed out after ${WAIT_TIMEOUT}s"; return 1; }
    sleep 2
    waited+=2
  done
  p_info "wait: unlocked after ${waited}s"
  return 0
}
# }}} = HELPERS =============================================================

# {{{ = UNLOCK STEPS =========================================================
# gnome-keyring. This step is Python because bash cannot do it: the Secret
# Service ties a prompt object's lifetime to the D-Bus connection that asked for
# it, so two `busctl` calls (Unlock, then Prompt) can never work -- the second
# fails with "Object does not exist at path .../prompt/u1" because the first
# connection already closed. libsecret drives Unlock -> Prompt -> wait in one
# process, and also exposes a real Locked property so nothing has to be guessed.
unlock_keyring() {
  if ! bus_has_name "${SECRETS_NAME}"; then
    p_info "keyring: no Secret Service on the bus, skipped"
    return 0
  fi
  if ! python3 -c 'import gi; gi.require_version("Secret","1")' &>/dev/null; then
    p_warn "keyring: python3 libsecret bindings missing (gir1.2-secret-1), skipped"
    return 0
  fi

  local out
  out="$(DRY_RUN="${DRY_RUN}" ONLY="${ONLY_COLLECTION}" \
        ALL_COLLECTIONS="${ALL_COLLECTIONS}" python3 - <<-'PY' 2>&1
	import os, sys
	import gi
	gi.require_version("Secret", "1")
	from gi.repository import Secret

	dry = os.environ.get("DRY_RUN") == "1"
	only = os.environ.get("ONLY", "")
	all_cols = os.environ.get("ALL_COLLECTIONS") == "1"

	svc = Secret.Service.get_sync(
	    Secret.ServiceFlags.OPEN_SESSION | Secret.ServiceFlags.LOAD_COLLECTIONS, None)

	def name(c):
	    return c.get_object_path().rsplit("/", 1)[-1]

	def fold(x):
	    # The label carries a space ("Default keyring") while the D-Bus path is
	    # escaped ("Default_5fkeyring"), so a plain substring test matches neither
	    # spelling a human would type. Compare on letters and digits only.
	    return "".join(ch for ch in (x or "").lower() if ch.isalnum())

	# The "session" collection is the ephemeral in-memory one -- nothing persistent
	# and never locked. Same exclusion as lock-secrets.
	cols = [c for c in svc.get_collections() if not name(c).endswith("session")]
	if only:
	    want = fold(only).replace("5f", "")
	    cols = [c for c in cols
	            if want in fold(c.get_label()) or want in fold(name(c)).replace("5f", "")]
	    if not cols:
	        print(f"ERR no collection matching {only!r}")
	        sys.exit(0)

	locked = [c for c in cols if c.get_locked()]

	# Drop collections with nothing worth unlocking. gnome-keyring keeps an
	# internal "gkr:compat:hashed:keyring" marker item, and a keyring holding only
	# that has no user secrets in it -- on this host the `login` keyring is exactly
	# that (1 item, 328 bytes) after the 2026-05 migration to `Default keyring`,
	# and its password is NOT the account password. Prompting for it on every
	# resume would cost an unanswerable dialog for no gain. Attributes stay
	# readable while a collection is locked, so this needs no unlock to decide.
	# --all-collections overrides.
	if not all_cols:
	    keep = []
	    for c in locked:
	        try:
	            c.load_items_sync(None)
	            attrs = [i.get_attributes() or {} for i in c.get_items()]
	        except Exception:
	            keep.append(c)       # cannot tell -> offer it rather than skip it
	            continue
	        real = [a for a in attrs
	                if not any(k.startswith("gkr:compat") for k in a)]
	        if real:
	            keep.append(c)
	        else:
	            print(f"SKIP {c.get_label() or name(c)}: no user secrets "
	                  f"({len(attrs)} internal item(s))", file=sys.stderr)
	    locked = keep

	if not locked:
	    print("OK nothing-to-unlock")
	    sys.exit(0)

	if dry:
	    labels = ", ".join(c.get_label() or name(c) for c in locked)
	    print(f"DRY {len(locked)} locked: {labels}")
	    sys.exit(0)

	# ONE collection per unlock_sync call, deliberately. Passing several produces
	# back-to-back prompts with nothing to say which is which -- and on this host
	# the two keyrings do not share a password, so answering blind fails on one and
	# the single aggregate result hides which. Per-collection also means a failure
	# on one does not stop the other being offered.
	results = []
	for c in locked:
	    label = c.get_label() or name(c)
	    n, _ = svc.unlock_sync([c], None)
	    results.append((label, bool(n) and not c.get_locked()))

	ok = [l for l, good in results if good]
	bad = [l for l, good in results if not good]
	parts = []
	if ok:
	    parts.append("unlocked: " + ", ".join(ok))
	if bad:
	    parts.append("FAILED/cancelled: " + ", ".join(bad))
	print(("OK " if not bad else "PARTIAL ") + "; ".join(parts))
	PY
  )" || true

  # The python block emits one record per line (SKIP notes plus a final verdict),
  # so classify per line rather than matching the whole blob.
  local line
  while IFS= read -r line; do
    [[ -n "${line}" ]] || continue
    case "${line}" in
      OK\ already-unlocked|OK\ nothing-to-unlock)
                p_info "keyring: nothing to unlock" ;;
      SKIP*)    p_info "keyring: skipped ${line#SKIP }" ;;
      DRY*)     p_info "keyring: would unlock -- ${line#DRY }" ;;
      OK*)      p_info "keyring: ${line#OK }" ;;
      PARTIAL*) p_warn "keyring: ${line#PARTIAL }" ;;
      ERR*)     p_warn "keyring: ${line#ERR }" ;;
      *)        p_warn "keyring: ${line}" ;;
    esac
  done <<< "${out}"
}

# KeePassXC. No lock-state API and no recorded database path, so: infer from the
# SSH agent (see usage()) and trigger by re-launching the app -- its desktop
# entry sets SingleMainWindow=true, so a second invocation raises the existing
# instance and a locked database shows its unlock form. Re-launching is also why
# this needs no database path.
unlock_keepassxc() {
  (( KEYRING_ONLY )) && { p_info "KeePassXC: skipped (--keyring-only)"; return 0; }

  if ! bus_has_name "${KPXC_NAME}"; then
    p_info "KeePassXC: not running, skipped"
    return 0
  fi

  if (( ! FORCE_KPXC )); then
    if [[ -n "${SSH_AUTH_SOCK:-}" ]] && ssh-add -l &>/dev/null; then
      p_info "KeePassXC: agent has identities, assuming unlocked (use -K to override)"
      return 0
    fi
  fi

  local -a launch=()
  if flatpak info "${KPXC_APP}" &>/dev/null; then
    launch=(flatpak run "${KPXC_APP}")
  elif command -v keepassxc &>/dev/null; then
    launch=(keepassxc)
  else
    p_warn "KeePassXC: on the bus but no way to launch it found"
    return 0
  fi

  if (( DRY_RUN )); then
    p_info "KeePassXC: would raise via: ${launch[*]}"
    return 0
  fi

  # Detach: the launcher blocks for as long as the app runs.
  setsid "${launch[@]}" &>/dev/null < /dev/null &
  p_info "KeePassXC: raised (${launch[0]}) -- unlock prompt should be on screen"
}
# }}} = UNLOCK STEPS =========================================================

main() {
  parse_args "$@"

  # Serialise: one waiter is enough, and a second resume should not stack another
  # sleeping process. flock -n fails fast when one is already waiting.
  #
  # Probe writability with a NORMAL command first. `exec 9>file` with no command
  # applies its redirections to the shell itself, so an appended `2>/dev/null`
  # would silence stderr for the whole run -- which swallowed every p_warn and
  # the xtrace output until this was found. A failed `exec` redirection also
  # exits a non-interactive shell outright, so it must not be attempted blind.
  if : > "${LOCK_FILE}" 2>/dev/null; then
    exec 9>>"${LOCK_FILE}"
    if ! flock -n 9; then
      p_info "another unlock-secrets is already waiting, exiting"
      return 0
    fi
  else
    p_warn "cannot create ${LOCK_FILE}; continuing without the single-waiter guard"
  fi

  if (( WAIT_UNLOCK )); then
    wait_for_unlock || return 0
  fi

  # KeePassXC first: it holds the SSH keys, and the sooner the agent has them
  # the sooner a VS Code remote reconnect actually succeeds.
  unlock_keepassxc
  unlock_keyring
  return 0
}

main "$@"
