#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; indent-tabs-mode: nil; tab-width: 2 -*-
# vim: ft=bash:et:ts=2:sts=2:sw=2
# code: language=bash insertSpaces=true tabSize=2
# shellcheck shell=bash
#
# sway-exit: exit sway the proper way.
#
# Stops the portal stack and its requesters first (sway-stop-portals), then
# exits sway. A bare `swaymsg exit` skips that step and can leave a stale D-Bus
# activation that delays the next session's portal, waybar and tray apps by
# 120s. The "Exit Sway" entry in the system mode calls this script.
#
# Usage: sway-exit

set -o nounset

sway-stop-portals
# Run after sway is already gone (e.g. from a TTY) it only does the cleanup.
if ! swaymsg -t get_version > /dev/null 2>&1; then
  printf 'sway is not running: portals stopped, nothing to exit\n'
  exit 0
fi
# sway quits before it answers, so swaymsg reports "Unable to receive IPC
# response" and fails: expected, not an error.
swaymsg exit > /dev/null 2>&1 || true
