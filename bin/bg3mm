#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; indent-tabs-mode: nil; tab-width: 2 -*-
# vim: ft=bash:et:ts=2:sts=2:sw=2
# code: language=bash insertSpaces=true tabSize=2
# shellcheck shell=bash
#
# Launch BG3 Mod Manager inside the Baldur's Gate 3 Proton prefix.
# Unlike standalone wine apps, this must run in the game context, so it goes
# through protontricks-launch --appid rather than plain wine.

set -o nounset

readonly APPID=1086940   # Baldur's Gate 3
readonly EXE="${HOME}/Documents/Games/Baldurs Gate 3/BG3ModManager/BG3ModManager.exe"

exec flatpak run --command=protontricks-launch com.github.Matoking.protontricks \
  --appid "${APPID}" "${EXE}" "$@"
