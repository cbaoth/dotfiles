#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; indent-tabs-mode: nil; tab-width: 2 -*-
# vim: ft=bash:et:ts=2:sts=2:sw=2
# code: language=bash insertSpaces=true tabSize=2
# shellcheck shell=bash
#
# Start Sway with environment tuned to the active GPU driver. Auto-detects
# the proprietary Nvidia driver and, if active, adds the required launch
# flag and env vars; override the detection with --nvidia / --no-nvidia.

set -euo pipefail

# shellcheck disable=SC2155
declare -r SCRIPT_FILE="$(basename "$0")"

# Session log: sway + child-app stderr, read by conky configs. TTY-launched
# sway is not captured by the journal, so this file is the only capture.
declare -r LOG_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/sway/session.log"

p_err() { printf '\033[31mERROR\033[0m: %s\n' "$*" >&2; }

p_usg() {
  cat <<EOF
Usage: ${SCRIPT_FILE} [OPTIONS] [-- SWAY_ARGS...]

Start Sway with environment tuned to the active GPU driver.

Options:
  --nvidia      Force Nvidia proprietary-driver mode (--unsupported-gpu,
                software cursor), regardless of auto-detection
  --no-nvidia   Force plain mode, even if the Nvidia driver is detected
  -h, --help    Show this help message and exit

Auto-detection:
  Nvidia mode is enabled automatically when the proprietary 'nvidia' kernel
  module is loaded (checked via /sys/module/nvidia).

Log file: ${LOG_FILE}
EOF
}

# Return 0 if the proprietary Nvidia kernel module is currently loaded.
nvidia_active() {
  [[ -d /sys/module/nvidia ]]
}

main() {
  local nvidia_mode=""
  local -a sway_args=()

  while (( $# > 0 )); do
    case "$1" in
      --nvidia)    nvidia_mode="true" ;;
      --no-nvidia) nvidia_mode="false" ;;
      -h|--help)   p_usg; exit 0 ;;
      --)
        shift
        sway_args+=("$@")
        break
        ;;
      -*)
        p_err "unknown option: $1"
        p_usg >&2
        exit 1
        ;;
      *)
        sway_args+=("$1")
        ;;
    esac
    shift
  done

  if [[ -z "${nvidia_mode}" ]]; then
    if nvidia_active; then nvidia_mode="true"; else nvidia_mode="false"; fi
  fi

  # Wayland-native defaults (https://github.com/swaywm/sway/wiki/Running-programs-natively-under-wayland)
  # Qt5/6: force Wayland backend (XDG_SESSION_TYPE=wayland is set by sway, but being explicit is cleaner)
  export QT_QPA_PLATFORM=wayland
  # Java: required for correct rendering under Xwayland (reparenting WM workaround)
  export _JAVA_AWT_WM_NONREPARENTING=1
  # Required for XDG desktop portal backend selection (portals, file pickers, etc.)
  export XDG_CURRENT_DESKTOP=sway
  # TTY login leaves logind's session type at "tty"; Electron/Chromium apps
  # started from the launcher (systemd --user) then pick X11 and crash.
  export XDG_SESSION_TYPE=wayland

  if [[ "${nvidia_mode}" == "true" ]]; then
    # Nvidia: software cursor (no hardware cursor support with proprietary drivers)
    export WLR_NO_HARDWARE_CURSORS=1
    sway_args=(--unsupported-gpu "${sway_args[@]}")
  fi

  # Log to file for debugging and monitoring (e.g. conky). Overwrite instead
  # of append to avoid unbounded growth; no rotation needed.
  mkdir -p -- "$(dirname -- "${LOG_FILE}")"
  exec > >(tee "${LOG_FILE}") 2>&1
  # Portals are bound to the compositor they started under and outlive it (the
  # user manager keeps running while other sessions exist). A stale portal
  # makes every Settings read time out (~25s each), which delayed waybar and
  # tray apps after a sway restart. Stop them before and after the session.
  stop_session_apps
  stop_stale_portals
  wait_stale_activation "$(date +%s)"
  # Unmask: sway-stop-portals masks the portals after a session (see there).
  sway-stop-portals --unmask
  local -i rc=0
  sway "${sway_args[@]}" || rc=$?
  stop_session_apps
  stop_stale_portals
  return "${rc}"
}

# Flatpak tray apps run in their own systemd scopes and so survive sway. Their
# tray icon is registered with the old waybar, and the next launch just reuses
# the stale instance, so the icon never comes back. Kill them with the session.
declare -ra SESSION_FLATPAKS=(org.keepassxc.KeePassXC dev.deedles.Trayscale)

stop_session_apps() {
  local app
  for app in "${SESSION_FLATPAKS[@]}"; do
    flatpak kill "${app}" 2> /dev/null || true
  done
}

stop_stale_portals() {
  sway-stop-portals
}

# dbus-daemon's service_start_timeout (session.conf default: 120s) + margin.
declare -ri ACTIVATION_TIMEOUT=122

# Wait out a portal activation that dbus-daemon still holds from the previous
# session. If sway died before sway-stop-portals ran (bare `swaymsg exit`, a
# crash), a portal backend fails without a display and dbus-daemon keeps that
# request pending until the timeout: masking cannot cancel it, and a session
# started meanwhile gets a hanging portal (no waybar, light-themed apps).
# Detected from dbus-daemon's journal lines up to UNTIL_TS, when the portals
# got masked; later requests fail at once on the mask.
# Only the running bus instance counts: a request still pending when the last
# boot (or user manager) ended died with its bus, so a session started within
# the timeout after a hard power-off must not wait for it.
wait_stale_activation() {
  local -r until_ts="$1"
  local -i left
  local -a match=()
  local bus_pid
  bus_pid="$(systemctl --user show -p MainPID --value dbus.service 2> /dev/null)" || bus_pid=""
  [[ "${bus_pid}" =~ ^[1-9][0-9]*$ ]] && match=("_PID=${bus_pid}")
  left="$(journalctl --user -b -t dbus-daemon "${match[@]}" -o short-unix --no-pager -q \
      --since "@$(( until_ts - ACTIVATION_TIMEOUT ))" --until "@${until_ts}" 2> /dev/null \
    | awk -F "'" -v until_ts="${until_ts}" -v tmo="${ACTIVATION_TIMEOUT}" '
        # Fields split on quotes: $2 = service name (or unit, last rule), $4 = unit.
        /Activating via systemd: service name=/ && $2 ~ /portal/ {
          split($1, f, "."); pending[$2] = f[1]; unit[$2] = $4
        }
        /Successfully activated service|Failed to activate service/ { delete pending[$2] }
        /Activation via systemd failed for unit/ {
          for (n in pending) if (unit[n] == $2) delete pending[n]
        }
        END {
          max = 0
          for (n in pending) { l = pending[n] + tmo - until_ts; if (l > max) max = l }
          print max
        }')" || left=0
  (( left > 0 )) || return 0
  printf 'Waiting %ss for a stale D-Bus portal activation from the last session...\n' "${left}"
  sleep "${left}"
}

main "$@"
