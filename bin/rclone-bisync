#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; indent-tabs-mode: nil; tab-width: 2 -*-
# vim: ft=bash:et:ts=2:sts=2:sw=2
# code: language=bash insertSpaces=true tabSize=2
# shellcheck shell=bash
#
# rclone-bisync: One guarded `rclone bisync` run of a named replica, with ntfy alerting (for timers).

# set options
# -e omitted intentionally: rclone's exit code and output are inspected and
# classified below; an early abort would skip the state bookkeeping and alerts.
set -o pipefail
set -o nounset
(( ${DEBUG_LVL:-0} >= 2 )) && set -o xtrace

trap 'printf "\nINTERRUPT\n"; exit 1' SIGINT SIGTERM

# {{{ = CONSTANTS =============================================================

declare -r CONF_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/rclone-bisync"
declare -r STATE_BASE="${XDG_STATE_HOME:-${HOME}/.local/state}/rclone-bisync"

# Seconds without a completed run before a *tolerated* failure (offline,
# server maintenance, saito rebooting) becomes an *alertable* one (exit
# non-zero → OnFailure= ntfy). Same policy as onedrive-sync.
declare -ri MAX_AGE="${RCLONE_BISYNC_MAX_AGE:-21600}"

# }}} = CONSTANTS =============================================================

# {{{ = ARGUMENTS =============================================================

declare -i quiet=0
declare -i no_notify=0
declare name=""
declare -a extra_args=()
# Set in main once NAME is known; read by fail_or_tolerate/seconds_since_ok.
declare LAST_OK_FILE=""

# }}} = ARGUMENTS =============================================================

# {{{ = FUNCTIONS =============================================================

usage() {
  cat <<EOF
Usage: rclone-bisync [OPTIONS] NAME [-- RCLONE_ARGS...]

Run 'rclone bisync' once for the replica NAME, configured in
${CONF_DIR}/NAME.conf:

  LOCAL=/path/to/local/dir         (required)
  REMOTE=remote:path               (required)
  MAX_DELETE=5                     (percent of files; bisync aborts above)
  RCLONE_ARGS=--flag --other=x     (optional; split on spaces, no quoting)

and, if present, the filter rules in ${CONF_DIR}/NAME.filter.

Refuses to start when LOCAL looks unmounted or empty, then classifies:

  completed             -> record success
  failed                -> tolerated (exit 0) until no run has completed for
                           ${MAX_AGE}s, then exit 1 (the unit's OnFailure= alerts)
  too many deletes      -> exit 1 immediately, urgent ntfy
  needs --resync        -> exit 1 immediately, urgent ntfy

Options:
  -q, --quiet       Do not echo rclone's output (the journal still gets the
                    classification lines)
      --no-notify   Never call ntfy-send (manual runs)
  -h, --help        This help

Arguments after -- go to rclone, e.g. a first run or a preview:
  rclone-bisync --no-notify nextcloud -- --resync --resync-mode newer --dry-run

Environment:
  RCLONE_BISYNC_MAX_AGE   staleness threshold in seconds (default: 21600)

Runs via the rclone-bisync@NAME.timer systemd user unit:
  systemctl --user status rclone-bisync@NAME.timer
  journalctl --user -u rclone-bisync@NAME.service -n 50
EOF
}

p_msg()  { (( quiet )) || printf '%s\n' "$*"; }
p_err()  { printf 'ERROR: %s\n' "$*" >&2; }
p_warn() { printf 'WARNING: %s\n' "$*" >&2; }

parse_args() {
  while (( $# > 0 )); do
    case "$1" in
      -q|--quiet)   quiet=1; shift ;;
      --no-notify)  no_notify=1; shift ;;
      -h|--help)    usage; exit 0 ;;
      --)           shift; extra_args=("$@"); break ;;
      -*)
        p_err "unknown option: $1"
        usage >&2
        exit 1
        ;;
      *)
        if [[ -n "${name}" ]]; then
          p_err "only one NAME allowed (got '${name}' and '$1')"
          exit 1
        fi
        name="$1"; shift
        ;;
    esac
  done
  if [[ -z "${name}" ]]; then
    p_err "NAME missing"
    usage >&2
    exit 1
  fi
  if [[ ! "${name}" =~ ^[A-Za-z0-9_-]+$ ]]; then
    p_err "invalid NAME: ${name}"
    exit 1
  fi
}

notify() {
  (( no_notify )) && return 0
  command -v ntfy-send >/dev/null 2>&1 || { p_warn "ntfy-send not found, no alert sent"; return 0; }
  ntfy-send "$@" || p_warn "ntfy-send failed"
}

# Read KEY=VALUE lines; no sourcing, so the file cannot run code.
read_conf() {
  local -r file="$1" key="$2"
  sed -nE "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*\"?([^\"]*)\"?[[:space:]]*$/\1/p" "${file}" | tail -n1
}

# An unmounted RAID leaves an empty (or missing) local dir. bisync would then
# see every file as deleted locally — --max-delete is the only other guard.
check_local_dir() {
  local -r dir="$1"
  if [[ ! -d "${dir}" ]]; then
    p_err "local dir missing: ${dir} (filesystem not mounted?)"
    return 1
  fi
  if [[ -z "$(find "${dir}" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]]; then
    p_err "local dir is empty: ${dir} (filesystem not mounted?) — refusing to sync"
    return 1
  fi
}

seconds_since_ok() {
  local -i last=0 now
  now="$(date +%s)"
  [[ -f "${LAST_OK_FILE}" ]] && last="$(stat -c %Y "${LAST_OK_FILE}")"
  printf '%d\n' $(( now - last ))
}

# Tolerate a failed run until the last completed one is older than MAX_AGE.
fail_or_tolerate() {
  local -r reason="$1"
  local -i age
  if [[ ! -f "${LAST_OK_FILE}" ]]; then
    p_err "${reason}; no sync has ever completed here (${LAST_OK_FILE} missing)"
    exit 1
  fi
  age="$(seconds_since_ok)"
  if (( age > MAX_AGE )); then
    p_err "${reason}; no completed sync for $(( age / 3600 ))h (> $(( MAX_AGE / 3600 ))h)"
    exit 1
  fi
  p_warn "${reason} — tolerated, last completed sync $(( age / 60 ))min ago"
  exit 0
}

# }}} = FUNCTIONS =============================================================

# {{{ = MAIN ==================================================================

main() {
  parse_args "$@"

  if ! command -v rclone >/dev/null 2>&1; then
    p_err "rclone not installed"
    exit 1
  fi

  local -r conf="${CONF_DIR}/${name}.conf"
  local -r filter="${CONF_DIR}/${name}.filter"
  if [[ ! -f "${conf}" ]]; then
    p_err "config missing: ${conf}"
    exit 1
  fi

  local local_dir remote max_delete conf_args
  local -a conf_argv=()
  local_dir="$(read_conf "${conf}" LOCAL)"
  local_dir="${local_dir%/}"
  remote="$(read_conf "${conf}" REMOTE)"
  max_delete="$(read_conf "${conf}" MAX_DELETE)"
  max_delete="${max_delete:-5}"
  conf_args="$(read_conf "${conf}" RCLONE_ARGS)"
  read -r -a conf_argv <<<"${conf_args}"
  if [[ -z "${local_dir}" || -z "${remote}" ]]; then
    p_err "LOCAL and REMOTE must be set in ${conf}"
    exit 1
  fi

  local -r state_dir="${STATE_BASE}/${name}"
  # Its age is the staleness signal, also watched externally (netdata
  # filecheck) in case the timer itself dies.
  LAST_OK_FILE="${state_dir}/last-success"
  mkdir -p "${state_dir}" || { p_err "cannot create ${state_dir}"; exit 1; }

  # rclone has its own bisync lock, but it outlives a killed run (--max-lock
  # is unset on purpose: a stale lock must be looked at, not expire).
  exec 9>"${state_dir}/lock"
  if ! flock -n 9; then
    p_msg "another rclone-bisync ${name} is running, skipping"
    exit 0
  fi

  check_local_dir "${local_dir}" || fail_or_tolerate "local dir check failed"

  local -a args=(
    bisync "${local_dir}" "${remote}"
    --max-delete "${max_delete}"
    # Retry after less serious errors instead of demanding --resync, and
    # resume an interrupted run (reboot, timeout) on its own.
    --resilient --recover
    # Edits on both sides: the newer file keeps its name, the other is kept
    # next to it as <name>.conflictN (nothing is lost).
    --conflict-resolve newer --conflict-loser num
    --create-empty-src-dirs
    --log-level INFO --stats 0
  )
  [[ -f "${filter}" ]] && args+=(--filters-file "${filter}")
  args+=("${conf_argv[@]}")

  local out_file
  out_file="$(mktemp -t rclone-bisync.XXXXXX)" || { p_err "mktemp failed"; exit 1; }
  # shellcheck disable=SC2064  # expand now: the path is fixed for this run
  trap "rm -f '${out_file}'" EXIT

  local -i rc=0
  if (( quiet )); then
    rclone "${args[@]}" "${extra_args[@]}" >"${out_file}" 2>&1 || rc=$?
  else
    rclone "${args[@]}" "${extra_args[@]}" 2>&1 | tee "${out_file}" || rc=$?
  fi

  # A dry run proves nothing about the real sync: never touch the state.
  local arg
  for arg in "${extra_args[@]}"; do
    [[ "${arg}" == "--dry-run" ]] && { p_msg "dry run (rc=${rc}), state not updated"; exit "${rc}"; }
  done

  if grep -qE 'too many deletes|safety abort' "${out_file}"; then
    p_err "bisync refused a mass delete (> ${max_delete}%) — inspect before anything else:"
    grep -E 'too many deletes|safety abort|ERROR' "${out_file}" | tail -n 5 >&2
    notify --priority urgent --tags rotating_light \
      "rclone-bisync ${name}: MASS DELETE blocked" \
      "bisync ${name} on $(hostname -s) stopped a mass delete. Timer keeps failing until resolved. journalctl --user -u rclone-bisync@${name} -n 80"
    exit 1
  fi

  # The listings are gone or inconsistent; every later run fails the same way
  # until a human runs --resync. Waiting for MAX_AGE would only delay the news.
  if grep -qE 'Must run --resync|cannot find prior Path[12] or Path[12] listings|Bisync critical error' "${out_file}"; then
    p_err "bisync needs a manual --resync:"
    grep -E 'ERROR|critical|resync' "${out_file}" | tail -n 5 >&2
    notify --priority high --tags warning \
      "rclone-bisync ${name}: needs --resync" \
      "bisync ${name} on $(hostname -s) cannot continue without a --resync. Do NOT run it blindly (union merge resurrects deleted files). journalctl --user -u rclone-bisync@${name} -n 80"
    exit 1
  fi

  if (( rc != 0 )) || ! grep -q 'Bisync successful' "${out_file}"; then
    grep -E 'ERROR' "${out_file}" | tail -n 5 >&2
    fail_or_tolerate "rclone bisync failed (rc=${rc})"
  fi

  touch "${LAST_OK_FILE}"
  p_msg "sync completed: $(grep -cE 'INFO  : .*: (Copied|Deleted|Moved)' "${out_file}") change(s)"
}

main "$@"

# }}} = MAIN ==================================================================
