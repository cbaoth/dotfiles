#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; indent-tabs-mode: nil; tab-width: 2 -*-
# vim: ft=bash:et:ts=2:sts=2:sw=2
# code: language=bash insertSpaces=true tabSize=2
# shellcheck shell=bash
#
# ffmpeg-check.sh <file...>: fully decode media files and report decoder errors (timestamped log).

# Catches damage in the middle of a file that a CRC/size check or a look at the
# header/tail cannot see. ffmpeg's exit status is not reliable for this (it
# exits 0 after logging decode errors), so a file counts as bad when ffmpeg
# prints anything at -v error, or exits non-zero.
#
# Exit: 0 = all files clean, 1 = at least one file bad/missing, 2 = usage error.
# Log:  ${XDG_STATE_HOME:-~/.local/state}/ffmpeg-check/ffmpeg-check_<epoch>.log
#       or $FFMPEG_CHECK_LOG (appended to), e.g. one shared log for gnu parallel:
#       find DIR -type f -name '*.avi' -print0 | parallel -0 -j4 ffmpeg-check {}
#
# No `set -e`: a bad file must not stop the loop; failures are counted instead.
set -uo pipefail

declare -r LOG_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/ffmpeg-check"
declare LOG_FILE=""

usage() {
  printf 'Usage: %s <file...>\n' "$(basename "$0")" >&2
}

# Prepend a timestamp to every line, print it and append it to the log file
log() {
  awk '{ print strftime("%Y-%m-%d %H:%M:%S:"), $0; fflush(); }' | tee -a "${LOG_FILE}"
}

check_file() {
  local -r f="$1"
  if [[ ! -f "${f}" ]]; then
    echo "ERROR: File not found [${f}], skipping..." | log >&2
    return 1
  fi
  local fp out rc
  fp="$(realpath -- "${f}")"
  echo "Checking integrity of file [${fp}]..." | log
  out="$(ffmpeg -nostdin -v error -i "${f}" -f null - 2>&1)"
  rc=$?
  [[ -n "${out}" ]] && echo "${out}" | log
  if ((rc != 0)) || [[ -n "${out}" ]]; then
    echo "ERROR: File [${fp}] has errors (ffmpeg exit ${rc})!" | log >&2
    return 1
  fi
  echo "OK: [${fp}]" | log
}

main() {
  if (($# == 0)); then
    echo "ERROR: No file(s) provided!" >&2
    usage
    return 2
  fi
  if [[ -n "${FFMPEG_CHECK_LOG:-}" ]]; then
    # shared log for parallel runs (every line is a single append)
    LOG_FILE="${FFMPEG_CHECK_LOG}"
    mkdir -p "$(dirname -- "${LOG_FILE}")" || return 2
  else
    mkdir -p "${LOG_DIR}" || return 2
    LOG_FILE="${LOG_DIR}/ffmpeg-check_$(date +%s).log"
  fi
  echo "Log file: ${LOG_FILE}"

  local -i bad=0
  local f
  for f in "$@"; do
    check_file "${f}" || bad+=1
  done
  ((bad == 0))
}

main "$@"
