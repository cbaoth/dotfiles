#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; indent-tabs-mode: nil; tab-width: 2 -*-
# vim: ft=bash:et:ts=2:sts=2:sw=2
# code: language=bash insertSpaces=true tabSize=2
# shellcheck shell=bash
#
# notes-sync: Auto-commit and sync the private notes repo (~/notes).

# set options
# -e omitted intentionally: a failed pull/push must still leave the local commit
# in place — losing the commit would be the one unacceptable outcome here.
set -o pipefail
set -o nounset
(( ${DEBUG_LVL:-0} >= 2 )) && set -o xtrace

trap 'printf "\nINTERRUPT\n"; exit 1' SIGINT SIGTERM

# {{{ = CONSTANTS =============================================================

declare -r NOTES_DIR="${NOTES_DIR:-${HOME}/notes}"
declare -r LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/notes-sync.lock"

# Unpushed-commit count that flips a *tolerated* transient failure (offline, ssh
# agent not up yet) into a *hard, alertable* one (exit non-zero → the systemd
# unit fails → OnFailure= pushes an ntfy). At the 5-minute timer cadence, 3 ≈
# 15 min of failing while the machine is up — long enough to rule out a blip,
# short enough to catch the silent-drift-for-two-days failure mode early.
declare -ri MAX_UNPUSHED="${NOTES_SYNC_MAX_UNPUSHED:-3}"

# }}} = CONSTANTS =============================================================

# {{{ = ARGUMENTS =============================================================

declare -i dry_run=0
declare -i quiet=0
declare -i no_push=0
declare -i pull_only=0

# }}} = ARGUMENTS =============================================================

# {{{ = FUNCTIONS =============================================================

usage() {
  cat <<EOF
Usage: notes-sync [OPTIONS]

Commit any local changes in ${NOTES_DIR}, then pull --rebase and push.
Does nothing when the working tree is clean, so it is safe to run on a timer.

Options:
  -n, --dry-run   Show what would happen; change nothing
  -q, --quiet     Only print on error or on an actual commit (for timers)
      --no-push   Commit locally, but do not pull or push
      --pull-only Pull only: never commit, never push. For hosts that should
                  READ the notes but must not hold a push credential (the
                  public-facing vserver) — see the note in the source.
  -h, --help      This help

Environment:
  NOTES_DIR       Override the repo path (default: \${HOME}/notes)

Runs every 5 minutes via the notes-sync.timer systemd user unit:
  systemctl --user status notes-sync.timer
  journalctl --user -u notes-sync.service -n 50
EOF
}

p_msg()  { (( quiet )) || printf '%s\n' "$*"; }
p_err()  { printf 'ERROR: %s\n' "$*" >&2; }
p_warn() { printf 'WARNING: %s\n' "$*" >&2; }

parse_args() {
  while (( $# > 0 )); do
    case "$1" in
      -n|--dry-run) dry_run=1; shift ;;
      -q|--quiet)   quiet=1; shift ;;
      --no-push)    no_push=1; shift ;;
      --pull-only)  pull_only=1; shift ;;
      -h|--help)    usage; exit 0 ;;
      *)
        p_err "unknown option: $1"
        usage >&2
        exit 1
        ;;
    esac
  done
}

# Decide whether the pull/push failure that just happened is transient (retry on
# the next tick, exit 0, keep the local commit) or persistent (alert now, exit
# non-zero). "$1" = a human-readable reason for the log.
fail_or_tolerate() {
  local -r reason="$1"
  local upstream ahead

  # No upstream at all → a push can *never* succeed; this is a config bug, not a
  # network blip (it is the exact fault that hid two days of drift). Alert now.
  if ! upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)"; then
    p_err "${reason}; no upstream configured for '$(git branch --show-current)'"
    p_err "fix: git -C ${NOTES_DIR} branch --set-upstream-to=origin/<branch>"
    exit 1
  fi

  ahead="$(git rev-list --count "${upstream}..HEAD" 2>/dev/null)" || ahead=0
  if (( ahead > MAX_UNPUSHED )); then
    p_err "${reason}; ${ahead} commits unpushed (> ${MAX_UNPUSHED}) — notes have not synced for a while"
    exit 1
  fi

  p_warn "${reason} — local commit is safe (${ahead} unpushed), will retry next run"
  exit 0
}

# }}} = FUNCTIONS =============================================================

# {{{ = MAIN ==================================================================

main() {
  parse_args "$@"

  if [[ ! -d "${NOTES_DIR}/.git" ]]; then
    p_err "not a git repo: ${NOTES_DIR}"
    exit 1
  fi

  cd "${NOTES_DIR}" || { p_err "cannot cd to ${NOTES_DIR}"; exit 1; }

  # A timer firing every 5 minutes will eventually overlap a slow push. Two
  # concurrent rebases in one worktree is how a notes repo gets corrupted.
  exec 9>"${LOCK_FILE}"
  if ! flock -n 9; then
    p_msg "another notes-sync is running, skipping"
    exit 0
  fi

  # A rebase left in progress by a previous failed run is a stuck state only a
  # human can clear — alert, and do NOT commit on top of it (that compounds the
  # mess). Checked before the commit block for exactly that reason.
  if [[ -d "$(git rev-parse --git-path rebase-merge 2>/dev/null)" \
     || -d "$(git rev-parse --git-path rebase-apply 2>/dev/null)" ]]; then
    p_err "a rebase is in progress in ${NOTES_DIR} — resolve manually"
    p_err "  git -C ${NOTES_DIR} status   # then: git rebase --continue | --abort"
    exit 1
  fi

  # {{{ - Pull-only ------------------------------------------------------------
  # Read-only replica mode, for a host that must NOT hold a push credential.
  #
  # The threat is not "an attacker reads my notes" — anyone with a shell on the
  # vserver is in the docker group, which is root-equivalent, and can enumerate
  # the whole box in minutes. It is the CREDENTIAL: a token that can push to the
  # notes repo turns "one host compromised" into "every host's documentation
  # compromised, and writable" — notes that both humans and agents later read
  # back as instructions.
  #
  # So: pull, never commit, never push. Local edits are deliberately left
  # uncommitted so they show up as drift rather than accumulating into commits
  # that can never leave the box (the exact `_local/` failure this repo already
  # learned once). --autostash keeps them across the rebase.
  if (( pull_only )); then
    if ! git remote get-url origin >/dev/null 2>&1; then
      p_err "--pull-only needs an 'origin' remote"
      exit 1
    fi

    if (( dry_run )); then
      p_msg "would pull --rebase from $(git remote get-url origin)"
      return 0
    fi

    if ! git pull --rebase --autostash -q; then
      fail_or_tolerate "pull --rebase failed (conflict? offline? auth?)"
      return 0
    fi

    # Uncommitted edits are expected here and are not an error — but LOCAL
    # COMMITS are, because nothing on this host can ever push them. Warn every
    # run; they will otherwise sit here invisibly until they conflict.
    local -i ahead=0
    ahead="$(git rev-list --count '@{upstream}..HEAD' 2>/dev/null || echo 0)"
    if (( ahead > 0 )); then
      p_warn "${ahead} local commit(s) on a pull-only host — these can never be" \
             "pushed from here. Move them to a host that can push."
    fi

    [[ -n "$(git status --porcelain)" ]] \
      && p_msg "note: uncommitted local changes present (kept, not committed)"

    p_msg "pulled from $(git remote get-url origin)"
    return 0
  fi
  # }}} - Pull-only ------------------------------------------------------------

  # {{{ - Commit --------------------------------------------------------------
  if [[ -z "$(git status --porcelain)" ]]; then
    p_msg "nothing to commit"
  else
    local -i n_files
    n_files="$(git status --porcelain | wc -l)"
    local -r msg="notes: autosave $(date -Is) (${n_files} file(s))"

    if (( dry_run )); then
      printf 'would commit %d file(s):\n' "${n_files}"
      git status --short
    else
      git add -A || { p_err "git add failed"; exit 1; }
      git commit -q -m "${msg}" || { p_err "git commit failed"; exit 1; }
      # Not gated on --quiet: an actual commit is the one thing worth logging.
      printf '%s\n' "${msg}"
    fi
  fi
  # }}} - Commit --------------------------------------------------------------

  (( no_push )) && return 0

  # No remote yet (e.g. before the GitHub repo exists) is fine — commit and stop.
  if ! git remote get-url origin >/dev/null 2>&1; then
    p_msg "no 'origin' remote configured, skipping pull/push"
    return 0
  fi

  if (( dry_run )); then
    p_msg "would pull --rebase and push to $(git remote get-url origin)"
    return 0
  fi

  # {{{ - Pull & push ---------------------------------------------------------
  # A failed pull must not abort: the commit above is already safe locally, and
  # the next timer tick will retry. Warn loudly, exit 0, do not lose data.
  if ! git pull --rebase --autostash -q; then
    fail_or_tolerate "pull --rebase failed (conflict? offline?)"
  fi

  if ! git push -q; then
    fail_or_tolerate "push failed (offline? auth?)"
  fi

  p_msg "synced with $(git remote get-url origin)"
  # }}} - Pull & push ---------------------------------------------------------

  return 0
}

main "$@"

# }}} = MAIN ==================================================================
