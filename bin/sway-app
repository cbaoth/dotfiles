#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; indent-tabs-mode: nil; tab-width: 2 -*-
# vim: ft=bash:et:ts=2:sts=2:sw=2
# code: language=bash insertSpaces=true tabSize=2
# shellcheck shell=bash
#
# Run-or-raise for Sway: focus an existing window matching an app's
# app_id/class (Wayland/XWayland), or launch it if no window matches.
# Safe to chain with `||` as a fallback list: exits 127 if COMMAND is not
# installed, 0 once it was launched (or a window was focused).

# shellcheck disable=SC2155
declare -r SCRIPT_FILE="$(basename "$0")"

# -e: exit on error  -u: unset vars are errors  -o pipefail: propagate pipe failures
set -o errexit
set -o pipefail
set -o nounset
(( ${DEBUG_LVL:-0} >= 2 )) && set -o xtrace

# {{{ = HELPERS ===============================================================

p_err() { printf '\033[31mERROR\033[0m: %s\n' "$*" >&2; }

p_usg() {
  cat <<EOF
Usage: ${SCRIPT_FILE} [OPTIONS] [--] COMMAND [ARGS...]

Focus an existing window matching COMMAND (run-or-raise), or launch
COMMAND if no matching window exists.

Options:
  -m, --match REGEX    case-insensitive regex to match app_id/class
                        (default: basename of COMMAND)
  -t, --title           also match against the window title
  -A, --action ACTION  focus (default) | toggle | focus-only
  -q, --quiet          no message if COMMAND is not installed (use when a
                        \`||\` fallback follows; DEBUG_LVL>=1 shows it anyway)
  -n, --dry-run        print the action instead of executing it
  -h, --help           show this help and exit

Actions:
  focus       Focus a matching window if one exists, else launch COMMAND.
  toggle      Focus a matching window if hidden/elsewhere; if it is
              already visible, hide it to the scratchpad instead. Falls
              back to launching COMMAND if no window matches.
  focus-only  Focus a matching window if one exists; do nothing
              otherwise (never launches).
  run         No window lookup: just run COMMAND in the foreground and
              return its exit status (launchers, one-shot clients such as
              \`vicinae toggle\`).

Exit status: 127 if COMMAND is not installed (checked before anything is
executed; \`flatpak run APP_ID\` is checked with \`flatpak info\`), so
\`sway-app -q A || sway-app B\` falls through to B. Launched apps are
detached and the exit status is 0, so a later non-zero exit of the app
itself never triggers the fallback (except for -A run, which waits).

Examples:
  ${SCRIPT_FILE} doublecmd
  ${SCRIPT_FILE} -m obsidian -A toggle -- flatpak run md.obsidian.Obsidian
  ${SCRIPT_FILE} -q -A run vicinae toggle || ${SCRIPT_FILE} -A run rofi -show combi
EOF
}

# Find the best matching window in the Sway tree.
# Outputs: "<con_id> <visible>" of the best match, or nothing if none found.
# Priority: focused > visible > first match.
find_window() {
  swaymsg -t get_tree | jq -r \
    --arg re "${match_re}" \
    --arg use_title "${use_title}" '
    [ recurse(.nodes[]?, .floating_nodes[]?)
      | select(.app_id != null or (.window_properties.class? != null))
      | select(
          ((.app_id // "") | test($re; "i"))
          or ((.window_properties.class? // "") | test($re; "i"))
          or ($use_title == "1" and ((.name // "") | test($re; "i")))
        )
      | {id, visible, focused}
    ]
    | if length == 0 then empty
      else min_by(if .focused then 0 elif .visible then 1 else 2 end)
        | "\(.id) \(.visible)"
      end
  '
}

# Succeeds if COMMAND can be launched on this host. A bare `command -v` is not
# enough for `flatpak run APP_ID`: flatpak itself exists everywhere, the app
# may not. The first non-option argument after `run` is taken as the app id.
is_available() {
  local -r bin="$1"; shift
  command -v -- "${bin}" > /dev/null 2>&1 || return 1
  if [[ "${bin##*/}" == "flatpak" && "${1:-}" == "run" ]]; then
    local arg
    for arg in "${@:2}"; do
      [[ "${arg}" == -* ]] && continue
      flatpak info "${arg}" > /dev/null 2>&1
      return
    done
  fi
}

launch() {
  if ! is_available "${command[@]}"; then
    if (( ${DEBUG_LVL:-0} >= 1 )) || ! (( quiet )); then
      p_err "not installed: ${command[*]}"
    fi
    exit 127
  fi

  if (( dry_run )); then
    printf 'exec: %s\n' "${command[*]}"
  elif [[ "${action}" == "run" ]]; then
    exec "${command[@]}"
  else
    # detach and report success: the exit status of the app itself must not
    # trigger a `||` fallback once it has been launched
    setsid -f "${command[@]}"
  fi
}

focus_window() {
  local -r con_id="$1"
  if (( dry_run )); then
    printf 'swaymsg: [con_id=%s] focus\n' "${con_id}"
  else
    swaymsg "[con_id=${con_id}] focus"
  fi
}

hide_window() {
  local -r con_id="$1"
  if (( dry_run )); then
    printf 'swaymsg: [con_id=%s] move scratchpad\n' "${con_id}"
  else
    swaymsg "[con_id=${con_id}] move scratchpad"
  fi
}

# }}} = HELPERS ===============================================================

# {{{ = MAIN ===================================================================

parse_args() {
  match_re=""
  use_title="0"
  action="focus"
  dry_run=0
  quiet=0

  while (( $# > 0 )); do
    case "$1" in
      -m|--match)
        shift; match_re="${1:-}" ;;
      -t|--title)
        use_title="1" ;;
      -A|--action)
        shift; action="${1:-}" ;;
      -q|--quiet)
        quiet=1 ;;
      -n|--dry-run)
        dry_run=1 ;;
      -h|--help)
        p_usg; exit 0 ;;
      --)
        shift; break ;;
      -*)
        p_err "unknown option: $1"
        p_usg >&2
        exit 1
        ;;
      *)
        break
        ;;
    esac
    shift
  done

  command=("$@")
  if (( ${#command[@]} == 0 )); then
    p_err "COMMAND is required"
    p_usg >&2
    exit 1
  fi

  case "${action}" in
    focus|toggle|focus-only|run) ;;
    *)
      p_err "invalid action: '${action}' (expected: focus, toggle, focus-only, run)"
      exit 1
      ;;
  esac

  [[ -n "${match_re}" ]] || match_re="$(basename "${command[0]}")"
}

main() {
  local match_re use_title action dry_run quiet
  local -a command
  parse_args "$@"

  local win_id="" win_visible=""
  [[ "${action}" == "run" ]] || { read -r win_id win_visible < <(find_window) || true; }

  case "${action}" in
    run)
      launch
      ;;
    focus)
      if [[ -n "${win_id}" ]]; then
        focus_window "${win_id}"
      else
        launch
      fi
      ;;
    focus-only)
      [[ -n "${win_id}" ]] && focus_window "${win_id}"
      ;;
    toggle)
      if [[ -n "${win_id}" ]]; then
        if [[ "${win_visible}" == "true" ]]; then
          hide_window "${win_id}"
        else
          focus_window "${win_id}"
        fi
      else
        launch
      fi
      ;;
  esac
}

main "$@"

# }}} = MAIN ===================================================================
