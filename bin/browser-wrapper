#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; indent-tabs-mode: nil; tab-width: 2 -*-
# vim: ft=bash:et:ts=2:sts=2:sw=2
# code: language=bash insertSpaces=true tabSize=2
# shellcheck shell=bash
#
# Chromium-family browser wrapper, dispatching on the name it is called by.
# Not meant to be run directly: setup/modules/25-browsers.sh symlinks it as
# ~/.local/bin/<browser> (vivaldi-snapshot, google-chrome-unstable, ...) for
# every installed browser, and points the user-level .desktop overrides at
# those links. It then execs /usr/bin/<name> with the fixes below.
#
#   XDG_CURRENT_DESKTOP   Electron/Chromium pick their credential store from
#                         this variable; an unrecognised desktop (sway) makes
#                         them fall back to basic-text storage. We append
#                         ":GNOME" (a colon-separated list, most specific
#                         first) rather than replacing, so the real desktop
#                         stays first and portals.conf still picks wlr for
#                         file pickers. Same fix as bin/code and
#                         bin/claude-desktop.
#   --disable-features=Vulkan
#                         Was added for Nvidia proprietary + native Wayland.
#                         Verified to NOT silence the "--ozone-platform=wayland
#                         is not compatible with Vulkan" log line; kept for
#                         parity until tested without. Chromium honours only
#                         the LAST --disable-features, so a flags file that
#                         sets its own must repeat Vulkan.
#
# Optional flag files, one flag per line ('#' comments and blank lines ok),
# appended after the defaults (later flags win):
#   ~/.config/browser-wrapper/all.flags       every browser
#   ~/.config/browser-wrapper/<name>.flags    one browser, e.g. vivaldi-snapshot
#
# Firefox is deliberately not wrapped: it has its own credential store.

set -euo pipefail

declare -r NAME="${0##*/}"
declare -r REAL="/usr/bin/${NAME}"
declare -r FLAG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/browser-wrapper"

if [[ "${NAME}" == "browser-wrapper" ]]; then
  printf "%s: call me through a browser-named symlink (see header)\n" "${NAME}" >&2
  exit 2
fi
if [[ ! -x "${REAL}" ]]; then
  printf "%s: %s not found (uninstalled? re-run: system-setup 25-browsers)\n" "${NAME}" "${REAL}" >&2
  exit 127
fi

case ":${XDG_CURRENT_DESKTOP:-}:" in
  *:GNOME:*|*:KDE:*) ;;   # already lists a recognised desktop, leave as-is
  *) export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:+${XDG_CURRENT_DESKTOP}:}GNOME" ;;
esac

declare -a flags=(--disable-features=Vulkan)
for f in "${FLAG_DIR}/all.flags" "${FLAG_DIR}/${NAME}.flags"; do
  [[ -f "${f}" ]] || continue
  while IFS= read -r line; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -n "${line}" ]] && flags+=("${line}")
  done < "${f}"
done

exec "${REAL}" "${flags[@]}" "$@"
