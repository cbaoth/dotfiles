#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; indent-tabs-mode: nil; tab-width: 2 -*-
# vim: ft=bash:et:ts=2:sts=2:sw=2
# code: language=bash insertSpaces=true tabSize=2
# shellcheck shell=bash
#
# input-keyboards: list key input devices, or show their key events live (evtest).
#
# Why: one keyboard is several event devices. A Logitech receiver splits into
# the keyboard (letters, modifiers, Fn combos), "Consumer Control" (media
# keys) and "System Control" (sleep/power), so finding out what a special key
# sends means watching all of them at once. `debug` does that and prints one
# compact line per key: device, key name, down/up, scan code (MSC_SCAN, what a
# hwdb remap needs).
#
# A grabbed device (EVIOCGRAB) shows no events to anyone else. Vocalinux grabs
# every physical keyboard since v0.18, so `debug` stops it for the session and
# starts it again on exit.
#
# Needs read access to /dev/input (group `input`) and evtest (desktop.list).

# -e omitted: the EXIT trap must always get to restart Vocalinux.
set -o pipefail
set -o nounset
(( ${DEBUG_LVL:-0} >= 2 )) && set -o xtrace

# {{{ = CONSTANTS =============================================================

# Vocalinux: `python .../venv/bin/vocalinux` (sway autostart) or
# `.../vocalinux-gui` (desktop launcher). Anchored to the interpreter, so a
# shell or editor whose command line merely contains the path is not killed.
declare -r VL_PATTERN='^[^ ]*/python[0-9.]* [^ ]*/vocalinux/venv/bin/vocalinux'

# }}} = CONSTANTS =============================================================

# Subshells running one evtest | awk pipeline each, and whether Vocalinux has
# to be started again; read by the EXIT trap of `debug`.
declare -a WATCHERS=()
declare -i RESTART_VL=0

# {{{ = FUNCTIONS =============================================================

p_err() { printf '\e[1;31m[ERROR]\e[0m %s\n' "$*" >&2; }
p_war() { printf '\e[1;33m[WARN]\e[0m %s\n' "$*" >&2; }
p_msg() { printf '\e[1;34m::\e[0m %s\n' "$*" >&2; }

usage() {
  cat <<EOF
Usage: input-keyboards [list]
       input-keyboards debug [-n] [DEVICE...]

List the input devices that have keys, or watch their key events live.

Commands:
  list (default)   Devices with keys: keyboards, media/system key devices.
                   Marks virtual devices and ones grabbed by another process.
  debug            One line per key event: device, key, down/up, scan code.
                   Without DEVICE: all physical devices with keys at once.
                   Keys still reach sway while it runs. Ctrl+C to stop.

DEVICE: event3, /dev/input/event3, or part of the device name (any case).

Options:
  -n, --no-stop    debug: do not stop Vocalinux (its grab hides the keyboard)
  -h, --help       Show this help

A key that shows nothing on any device is handled by the keyboard itself, or
over Logitech HID++ (see \`solaar show\`; Solaar can divert such keys).
Key names as sway and apps see them (keysyms for bindsym): wev
EOF
}

# One line per device with keys: "eventN<TAB>kind<TAB>virtual<TAB>name".
# virtual is "virtual" or "-", never empty: tab is IFS whitespace, so `read`
# would merge an empty field away.
key_devices() {
  local sys props kind virt
  for sys in /sys/class/input/event*; do
    props="$(udevadm info -q property -p "${sys}" 2>/dev/null)" || continue
    props=$'\n'"${props}"$'\n'
    if [[ "${props}" == *$'\nID_INPUT_KEYBOARD=1\n'* ]]; then
      kind="keyboard"
    elif [[ "${props}" == *$'\nID_INPUT_KEY=1\n'* ]]; then
      kind="keys"
    else
      continue
    fi
    virt="-"
    [[ "$(readlink -f -- "${sys}")" == /sys/devices/virtual/* ]] && virt="virtual"
    printf '%s\t%s\t%s\t%s\n' "${sys##*/}" "${kind}" "${virt}" "$(< "${sys}/device/name")"
  done | sort -t $'\t' -k1,1V
}

# evtest reports a grab on start (it test-grabs and releases at once).
is_grabbed() {
  grep -q 'grabbed by another process' < <(timeout 0.5 evtest "$1" 2>&1)
}

# Names of the processes holding DEV open, except sway (it always does) and
# evtest (the parallel grab checks).
openers() {
  local -a pids
  read -r -a pids < <(fuser "$1" 2>/dev/null)
  (( ${#pids[@]} > 0 )) || return 0
  ps -o comm= -p "$(IFS=,; printf '%s' "${pids[*]}")" | grep -vxE 'sway|evtest' | sort -u | paste -sd ' '
}

require_evtest() {
  if ! command -v evtest > /dev/null; then
    p_err "evtest not found: sudo apt install evtest (or system-setup 00-apt-base)"
    exit 1
  fi
}

cmd_list() {
  require_evtest
  local tmp
  tmp="$(mktemp -d)"
  # shellcheck disable=SC2064  # expand now: tmp is local
  trap "rm -rf -- '${tmp}'" EXIT

  local -a lines
  mapfile -t lines < <(key_devices)
  local line ev
  for line in "${lines[@]}"; do
    ev="${line%%$'\t'*}"
    ( is_grabbed "/dev/input/${ev}" && openers "/dev/input/${ev}" > "${tmp}/${ev}" ) &
  done
  wait

  local kind virt name note
  printf '%-8s %-8s %-7s %-40s %s\n' DEVICE KIND VIRTUAL NAME NOTE
  for line in "${lines[@]}"; do
    IFS=$'\t' read -r ev kind virt name <<< "${line}"
    note=""
    [[ -f "${tmp}/${ev}" ]] && note="GRABBED (open by: $(< "${tmp}/${ev}"))"
    printf '%-8s %-8s %-7s %-40s %s\n' "${ev}" "${kind}" "${virt}" "${name}" "${note}"
  done
}

# Resolve DEVICE args to eventN names; no args = all physical devices with keys.
select_devices() {
  local -a all
  mapfile -t all < <(key_devices)
  local line ev kind virt name arg
  if (( $# == 0 )); then
    for line in "${all[@]}"; do
      IFS=$'\t' read -r ev kind virt name <<< "${line}"
      [[ "${virt}" == "-" ]] && printf '%s\n' "${ev}"
    done
    return 0
  fi
  for arg in "$@"; do
    arg="${arg##*/}"
    if [[ "${arg}" =~ ^event[0-9]+$ ]]; then
      if [[ -e "/dev/input/${arg}" ]]; then
        printf '%s\n' "${arg}"
      else
        p_war "no such device: /dev/input/${arg}"
      fi
      continue
    fi
    local -i found=0
    for line in "${all[@]}"; do
      IFS=$'\t' read -r ev kind virt name <<< "${line}"
      if [[ "${name,,}" == *"${arg,,}"* ]]; then
        printf '%s\n' "${ev}"
        found=1
      fi
    done
    (( found )) || p_war "no device with keys matches: ${arg}"
  done | sort -u -V
}

vocalinux_running() {
  pgrep -u "$(id -u)" -f "${VL_PATTERN}" > /dev/null
}

stop_vocalinux() {
  pkill -u "$(id -u)" -f "${VL_PATTERN}"
  local -i i
  for (( i = 0; i < 50; i++ )); do
    vocalinux_running || return 0
    sleep 0.1
  done
  p_war "Vocalinux did not exit within 5s"
}

# Through sway when possible, so its log goes to the sway session log again.
start_vocalinux() {
  p_msg "starting Vocalinux again"
  if [[ -n "${SWAYSOCK:-}" ]] && command -v swaymsg > /dev/null; then
    swaymsg -q exec 'sway-run-after-waybar vocalinux'
  else
    setsid -f vocalinux < /dev/null &> /dev/null
  fi
}

# Compact key events of one device, prefixed with its eventN.
# Field layout of an evtest event line:
#   Event: time T, type 1 (EV_KEY), code 35 (KEY_H), value 1
watch_device() {
  local -r ev="$1"
  stdbuf -oL evtest "/dev/input/${ev}" 2>&1 | awk -v tag="${ev}" '
    /grabbed by another process/ {
      printf "%-8s GRABBED by another process: no events visible here\n", tag
      fflush(); next
    }
    /^Event: .*\(MSC_SCAN\)/ { scan = $NF; next }
    /^Event: .*\(EV_KEY\)/ {
      key = $9; gsub(/[(),]/, "", key)
      state = ($11 == 0) ? "up" : ($11 == 1) ? "down" : "repeat"
      printf "%-8s %-22s %-6s code %-4s scan %s\n", tag, key, state, $8, (scan == "" ? "-" : scan)
      scan = ""; fflush()
    }'
}

# EXIT trap of `debug`. Killing the subshell alone is not enough: evtest and
# awk are its children, and as background jobs of a script they ignore the
# SIGINT of Ctrl+C, so they would keep printing into the shell. Kill them by
# parent pid first.
debug_cleanup() {
  trap - INT TERM
  local pid
  for pid in "${WATCHERS[@]}"; do
    pkill -TERM -P "${pid}" 2> /dev/null
    kill -TERM "${pid}" 2> /dev/null
  done
  (( RESTART_VL )) && start_vocalinux
}

cmd_debug() {
  local -i stop_vl=1
  local -a args=()
  while (( $# > 0 )); do
    case "$1" in
      -n|--no-stop) stop_vl=0 ;;
      -h|--help) usage; exit 0 ;;
      --) shift; args+=("$@"); break ;;
      -*) p_err "unknown option: $1"; usage >&2; exit 2 ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  require_evtest

  local -a devs
  mapfile -t devs < <(select_devices "${args[@]}")
  if (( ${#devs[@]} == 0 )); then
    p_err "no devices to watch (see: input-keyboards list)"
    exit 1
  fi

  local -i grabbed=0
  local ev
  for ev in "${devs[@]}"; do
    is_grabbed "/dev/input/${ev}" && grabbed=1
  done
  if (( grabbed && stop_vl )) && vocalinux_running; then
    p_msg "stopping Vocalinux while watching (its keyboard grab hides the events)"
    stop_vocalinux
    RESTART_VL=1
  fi

  trap debug_cleanup EXIT
  trap 'exit 130' INT TERM

  local name
  for ev in "${devs[@]}"; do
    name="$(< "/sys/class/input/${ev}/device/name")"
    printf '%-8s %s\n' "${ev}" "${name}"
  done
  p_msg "watching ${#devs[@]} device(s); keys still reach sway. Ctrl+C to stop."
  for ev in "${devs[@]}"; do
    watch_device "${ev}" &
    WATCHERS+=("$!")
  done
  wait
}

# }}} = FUNCTIONS =============================================================

# {{{ = MAIN ==================================================================

main() {
  local -r command="${1:-list}"
  (( $# > 0 )) && shift
  case "${command}" in
    list) cmd_list ;;
    debug) cmd_debug "$@" ;;
    -h|--help|help) usage ;;
    *) p_err "unknown command: ${command}"; usage >&2; exit 2 ;;
  esac
}

main "$@"

# }}} = MAIN ==================================================================
