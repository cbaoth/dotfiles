#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; indent-tabs-mode: nil; tab-width: 2 -*-
# vim: ft=bash:et:ts=2:sts=2:sw=2
# code: language=bash insertSpaces=true tabSize=2
# shellcheck shell=bash
#
# Launch Path of Building Community (PoE2) (standalone wine app).
# With --setup, download and run the latest installer instead.

set -o nounset

readonly EXE="C:/users/${USER}/AppData/Roaming/Path of Building Community (PoE2)/Path of Building-PoE2.exe"
readonly SETUP_URL="https://github.com/PathOfBuildingCommunity/PathOfBuilding-PoE2/releases/latest/download/PathOfBuildingCommunity-PoE2-Setup.exe"

if [[ "${1:-}" == "--setup" ]]; then
  tmp="$(mktemp --suffix=.exe)"
  trap 'rm -f "${tmp}"' EXIT
  printf 'Downloading Path of Building Community (PoE2) setup ...\n'
  wget -O "${tmp}" "${SETUP_URL}"
  wine "${tmp}"
  exit $?
fi

exec wine "${EXE}" "$@"
