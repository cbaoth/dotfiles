#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; indent-tabs-mode: nil; tab-width: 2 -*-
# vim: ft=bash:et:ts=2:sts=2:sw=2
# code: language=bash insertSpaces=true tabSize=2
# shellcheck shell=bash
#
# vram-waybar: emit waybar JSON for the custom/vram module (NVIDIA VRAM usage).
#
# Prints nothing at all unless an NVIDIA GPU is present, awake and answering
# nvidia-smi; waybar hides a custom module whose output is empty. So the module
# simply never appears on machines without one (e.g. the Yoga), and nothing
# is logged there either.
#
# A runtime-suspended GPU (hybrid graphics laptops) is left alone instead of
# queried: nvidia-smi would wake it every interval and cost battery, just to
# report an idle card.
#
# The text is the VRAM percentage of the fullest GPU, with a notice/warning/
# critical class like the memory module; the tooltip lists every GPU.

# set options (see also bin/sway-awake for the house pattern)
set -o errtrace
set -o pipefail
set -o nounset
(( ${DEBUG_LVL:-0} >= 2 )) && set -o xtrace
IFS=$'\t\n'

# traps
trap 'printf "\nINTERRUPT\n" >&2; exit 1' SIGINT SIGTERM

# {{{ = CONSTANTS ============================================================
declare -r NVIDIA_VENDOR="0x10de"

# nvidia-smi can block for a long time on a wedged driver; never let that
# pile up waybar exec processes.
declare -ri SMI_TIMEOUT_SECS=3
declare -r SMI_QUERY="name,memory.used,memory.total,utilization.gpu,temperature.gpu"

# CSS class thresholds (%), the same as "states" of the memory module in the
# waybar config. Custom modules ignore "states", hence computed here.
declare -ri NOTICE_PCT=70
declare -ri WARNING_PCT=80
declare -ri CRITICAL_PCT=90

declare -r DEGREE=$'°'
# }}} = CONSTANTS ============================================================

# {{{ = HELPERS =============================================================
usage() {
  cat <<EOF
Usage: vram-waybar

Emit waybar JSON for the custom/vram module: VRAM usage of the fullest
NVIDIA GPU as text and percentage, all GPUs in the tooltip. Prints nothing
(the module stays hidden) when no awake NVIDIA GPU answers nvidia-smi.
EOF
}

# True when at least one NVIDIA display controller exists and none of them is
# runtime-suspended (nvidia-smi queries all GPUs, so it would wake that one).
nvidia_awake() {
  local dev
  local -i found=1
  for dev in /sys/bus/pci/devices/*; do
    [[ -r "${dev}/vendor" && -r "${dev}/class" ]] || continue
    [[ "$(< "${dev}/vendor")" == "${NVIDIA_VENDOR}" ]] || continue
    [[ "$(< "${dev}/class")" == 0x03* ]] || continue   # display controller
    if [[ -r "${dev}/power/runtime_status" \
          && "$(< "${dev}/power/runtime_status")" == "suspended" ]]; then
      return 1
    fi
    found=0
  done
  return "${found}"
}

# MiB -> GiB with one decimal, integer arithmetic only: 2458 -> 2.4
mib_to_gib() {
  local -i tenths=$(( ($1 * 10 + 512) / 1024 ))
  printf '%d.%d' "$(( tenths / 10 ))" "$(( tenths % 10 ))"
}

trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  printf '%s' "${s%"${s##*[![:space:]]}"}"
}
# }}} = HELPERS =============================================================

# {{{ = MAIN ================================================================
main() {
  case "${1:-}" in
    -h|--help) usage; return 0 ;;
    "") ;;
    *) usage >&2; return 1 ;;
  esac

  command -v nvidia-smi >/dev/null 2>&1 || return 0
  command -v jq >/dev/null 2>&1 || return 0
  nvidia_awake || return 0

  local out
  out="$(timeout "${SMI_TIMEOUT_SECS}" nvidia-smi --query-gpu="${SMI_QUERY}" \
           --format=csv,noheader,nounits 2>/dev/null)" || return 0

  local name used total util temp tooltip=""
  local -i pct max_pct=-1
  while IFS=',' read -r name used total util temp; do
    used="$(trim "${used}")"
    total="$(trim "${total}")"
    # [N/A] on GPUs that do not report memory; skip rather than guess
    [[ "${used}" =~ ^[0-9]+$ && "${total}" =~ ^[1-9][0-9]*$ ]] || continue
    pct=$(( (used * 100 + total / 2) / total ))
    (( pct > max_pct )) && max_pct=pct

    tooltip+="${tooltip:+$'\n\n'}$(trim "${name}")"
    tooltip+=$'\n'"VRAM $(mib_to_gib "${used}") / $(mib_to_gib "${total}") GiB (${pct}%)"
    util="$(trim "${util}")"
    temp="$(trim "${temp}")"
    [[ "${util}" =~ ^[0-9]+$ ]] && tooltip+=$'\n'"Load ${util}%"
    [[ "${temp}" =~ ^[0-9]+$ ]] && tooltip+=$'\n'"Temp ${temp}${DEGREE}C"
  done <<< "${out}"

  (( max_pct >= 0 )) || return 0
  local class="ok"
  if (( max_pct >= CRITICAL_PCT )); then class="critical"
  elif (( max_pct >= WARNING_PCT )); then class="warning"
  elif (( max_pct >= NOTICE_PCT )); then class="notice"
  fi
  jq -cn --arg text "${max_pct}" --arg tooltip "${tooltip}" --arg class "${class}" \
    --argjson pct "${max_pct}" '{text: $text, tooltip: $tooltip, class: $class, percentage: $pct}'
}
# }}} = MAIN ================================================================

main "$@"
