#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; indent-tabs-mode: nil; tab-width: 2 -*-
# vim: ft=bash:et:ts=2:sts=2:sw=2
# code: language=bash insertSpaces=true tabSize=2
# shellcheck shell=bash
#
# Launch Awakened PoE Trade (AppImage) on Sway/Wayland, installing pending updates first.
#
# Two workarounds are needed to start the AppImage from a shell under Sway:
#
#   1. AppImageLauncher installs a binfmt_misc handler that routes every
#      AppImage exec through its Qt GUI wrapper (/usr/bin/AppImageLauncher).
#      That wrapper cannot initialize under Wayland — sway-start exports
#      QT_QPA_PLATFORM=wayland and the wrapper's bundled Qt has no wayland
#      plugin — so it SIGABRTs (exit 134) before the app ever runs.
#      APPIMAGELAUNCHER_DISABLE=1 makes the binfmt handler exec the AppImage
#      directly, skipping the wrapper.
#
#   2. The app is Electron. --ozone-platform=x11 forces it onto XWayland so its
#      global overlay works over the (XWayland) game. See issue #1647.
#
# Updates: the app's built-in updater (electron-updater) only downloads a new
# version into ~/.cache/awakened-poe-trade-updater/pending/ and swaps the
# AppImage on a *graceful* quit. bin/poe-trade-toggle stops the overlay with
# pkill (which also tears down the AppImage's FUSE mount), so that swap never
# happened and the old version kept running. This launcher installs a pending,
# sha512-verified update itself, always runs the highest installed version, and
# deletes every other copy of the app from ~/Applications.
#
# Simulated keys: APT copies items and types chat commands by sending fake
# key events with XSendEvent, which PoE under Proton 10+ ignores. The
# xsend2xtest LD_PRELOAD shim (built from ~/.local/share/poe-awakened-trade/)
# re-sends them through XTEST, which the game accepts.
#
# Plain launcher; "trade mode" (float game + hide waybar + DND + start/stop) is
# handled by bin/poe-trade-toggle, which tracks the overlay by process pattern.

# Errors abort: a half-installed update must never be launched.
set -euo pipefail

declare -r APP_DIR="${HOME}/Applications"
declare -r PENDING_DIR="${HOME}/.cache/awakened-poe-trade-updater/pending"
# LD_PRELOAD shim: APT's simulated keys (XSendEvent) -> XTEST, which Proton 10+
# accepts. Source deployed by dotfiles-link; built on demand. See the .c file.
# XSEND2XTEST_DELAY_MS (env, default 100) is passed through to the shim.
declare -r SHIM_SRC="${HOME}/.local/share/poe-awakened-trade/xsend2xtest.c"
declare -r SHIM_SO="${HOME}/.cache/poe-awakened-trade/xsend2xtest.so"

log() { printf 'poe-awakened-trade: %s\n' "$*" >&2; }

# Print installed versioned AppImages, highest version last.
installed_versions() {
  find "${APP_DIR}" -maxdepth 1 -type f -name 'Awakened-PoE-Trade-*.AppImage' -print \
    | sort -V
}

# Move a downloaded update into APP_DIR if its sha512 matches the updater's
# metadata. Any mismatch leaves the installed versions untouched.
install_pending_update() {
  local -r info="${PENDING_DIR}/update-info.json"
  local name want have src old
  [[ -f "${info}" ]] || return 0
  name="$(jq -r '.fileName // empty' "${info}" 2>/dev/null)" || return 0
  [[ "${name}" == Awakened-PoE-Trade-*.AppImage && "${name}" != */* ]] || return 0
  src="${PENDING_DIR}/${name}"
  [[ -f "${src}" ]] || return 0
  [[ -e "${APP_DIR}/${name}" ]] && return 0  # already installed

  want="$(jq -r '.sha512 // empty' "${info}")"
  have="$(openssl dgst -sha512 -binary "${src}" | base64 -w0)"
  if [[ -z "${want}" || "${want}" != "${have}" ]]; then
    log "pending update ${name}: sha512 mismatch, not installing"
    return 0
  fi

  chmod +x "${src}"
  mv -- "${src}" "${APP_DIR}/${name}"
  rm -f -- "${info}"
  log "installed update ${name}"
}

# Remove every other copy of the app in APP_DIR: older versions, and the
# hash-named copies AppImageLauncher's "Integrate and run" dialog makes
# (awakened_poe_trade_<md5>.appimage). Runs only after the newest version is
# in place, so a failed update still leaves a working one. appimagelauncherd
# drops the matching desktop entries by itself once the files are gone.
prune_other_copies() {
  local -r keep="$1"
  local old
  while IFS= read -r old; do
    [[ "${old}" == "${keep}" ]] && continue
    rm -f -- "${old}" && log "removed ${old##*/}"
  done < <(find "${APP_DIR}" -maxdepth 1 -type f -iname 'awakened[-_]poe[-_]trade*.appimage' -print)
}

# Build the shim if it is missing or older than its source; print its path on
# success. Without it APT still starts, only its simulated keys fail in game.
# POE_APT_NO_SHIM=1 skips it (to compare behavior).
build_shim() {
  [[ -z "${POE_APT_NO_SHIM:-}" && -f "${SHIM_SRC}" ]] || return 0
  if [[ ! -f "${SHIM_SO}" || "${SHIM_SRC}" -nt "${SHIM_SO}" ]]; then
    mkdir -p "${SHIM_SO%/*}"
    if ! cc -O2 -Wall -Wextra -shared -fPIC -o "${SHIM_SO}.tmp" "${SHIM_SRC}" -ldl 2>&1 | sed 's/^/  cc: /' >&2 \
      || [[ ! -f "${SHIM_SO}.tmp" ]]; then
      log "warning: could not build ${SHIM_SO##*/} (needs cc + libx11-dev); simulated keys will not reach the game"
      rm -f -- "${SHIM_SO}.tmp"
      return 0
    fi
    mv -f -- "${SHIM_SO}.tmp" "${SHIM_SO}"
    log "built ${SHIM_SO}"
  fi
  printf '%s\n' "${SHIM_SO}"
}

main() {
  local app shim
  install_pending_update

  app="$(installed_versions | tail -n 1)"
  [[ -n "${app}" ]] || { log "no Awakened-PoE-Trade-*.AppImage in ${APP_DIR}"; exit 1; }
  prune_other_copies "${app}"
  log "starting ${app##*/}"

  export APPIMAGELAUNCHER_DISABLE=1
  # ELECTRON_RUN_AS_NODE is injected by the VS Code terminal; it would make the
  # Electron binary run as plain node instead of launching the GUI.
  unset ELECTRON_RUN_AS_NODE

  shim="$(build_shim)"
  if [[ -n "${shim}" ]]; then
    export LD_PRELOAD="${shim}${LD_PRELOAD:+:${LD_PRELOAD}}"
    # Chat commands write the clipboard and paste right away; without a delay
    # Wine has not imported the text yet (2026-11-18: F5 /hideout failed at 0,
    # worked at 100 ms; item copies worked at both).
    export XSEND2XTEST_DELAY_MS="${XSEND2XTEST_DELAY_MS:-100}"
    log "preloading ${shim##*/} (XSendEvent keys -> XTEST, delay ${XSEND2XTEST_DELAY_MS} ms)"
  fi

  exec "${app}" --ozone-platform=x11 "$@"
}

main "$@"
