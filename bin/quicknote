#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; indent-tabs-mode: nil; tab-width: 2 -*-
# vim: ft=bash:et:ts=2:sts=2:sw=2
# code: language=bash insertSpaces=true tabSize=2
# shellcheck shell=bash
#
# quicknote: Append timestamped quick notes to ~/notes/inbox (or the dotfiles TODO).

# set options
# -e omitted intentionally: an editor draft must survive any failing step, and
# every failure path below decides explicitly whether to keep or drop it.
set -o pipefail
set -o nounset
(( ${DEBUG_LVL:-0} >= 2 )) && set -o xtrace

trap 'printf "\nINTERRUPT\n" >&2; exit 130' SIGINT SIGTERM

# {{{ = CONSTANTS =============================================================

declare -r QN_DIR="${QN_DIR:-${NOTES_DIR:-${HOME}/notes}/inbox}"
# Notes written before this time of day belong to the previous day's file, so a
# late-night session stays in one file. The header always shows the real time.
declare -r QN_DAY_START="${QN_DAY_START:-04:00}"
declare -r QN_TODO_FILE="${QN_TODO_FILE:-${HOME}/dotfiles/docs/TODO.md}"
declare -r QN_TODO_SECTION="${QN_TODO_SECTION:-## Quick Notes}"
# Persistent on purpose (not $XDG_RUNTIME_DIR, a tmpfs): a draft saved in the
# editor must survive a killed terminal or a crash, see --resolve.
declare -r DRAFT_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/quicknote/drafts"
declare -r PLACEHOLDER='## (timestamp set on save)'

# }}} = CONSTANTS =============================================================

# {{{ = ARGUMENTS =============================================================

declare mode=''          # append | stdin | edit-new | edit | resolve
declare target='inbox'   # inbox | todo
declare opt_dir=''
declare opt_file=''
declare opt_suffix=''
declare opt_at=''
declare opt_date=''
declare day_start="${QN_DAY_START}"
declare -a text_args=()
declare -i dry_run=0
declare -i quiet=0

# }}} = ARGUMENTS =============================================================

# {{{ = FUNCTIONS =============================================================

usage() {
  cat <<EOF
Usage: quicknote [OPTIONS] -- TEXT...      append TEXT (\\n = newline, \\\\n = literal)
       quicknote [OPTIONS] --raw TEXT      same, TEXT is one argument (zsh front-end)
       quicknote [OPTIONS] --stdin         append stdin verbatim
       quicknote [OPTIONS] --edit-new      write a new note in \$EDITOR
       quicknote [OPTIONS] --edit [DATE]   edit a day's file in \$EDITOR (3-way merge on save)
       quicknote --resolve                 recover orphaned drafts, merge conflict files

Each note becomes a section '## <ISO-8601 time>' appended to the logical day's
file (${QN_DIR}/YYYY-MM-DD.md). Time and file are decided when the note is
saved, not when the editor opens. With --target todo, the note becomes a
'- [ ]' bullet at the end of '${QN_TODO_SECTION}' in ${QN_TODO_FILE}.

Options:
  -t, --target T     inbox (default) | todo
  -d, --dir DIR      target directory (default: \$QN_DIR)
  -f, --file NAME    target filename, instead of the date-based one
  -s, --suffix S     date-based name with suffix: YYYY-MM-DD-S.md
  -a, --at TIME      note time (any 'date -d' string), default: now
      --day-start T  HH:MM a new day begins (default: \$QN_DAY_START)
  -n, --dry-run      print what would be appended; change nothing
  -q, --quiet        only print errors and warnings
  -h, --help         this help

Environment:
  QN_DIR             default: \${NOTES_DIR:-~/notes}/inbox (now: ${QN_DIR})
  QN_DAY_START       default: 04:00 (now: ${QN_DAY_START})
  QN_TODO_FILE       default: ~/dotfiles/docs/TODO.md
  QN_TODO_SECTION    default: '## Quick Notes'
  VISUAL / EDITOR    VISUAL in a graphical session (not over ssh), else EDITOR

Editor drafts live in ${DRAFT_DIR} until they are saved
to the note. A draft whose editor died (killed terminal, crash) is reported by
every run; recover it with --resolve.
EOF
}

p_msg()  { (( quiet )) || printf '%s\n' "$*"; }
p_err()  { printf 'ERROR: %s\n' "$*" >&2; }
p_warn() { printf 'WARNING: %s\n' "$*" >&2; }
p_dbg()  { (( ${DEBUG_LVL:-0} >= 1 )) && printf 'DEBUG: %s\n' "$*" >&2; return 0; }

set_mode() {
  if [[ -n "${mode}" && "${mode}" != "$1" ]]; then
    p_err "conflicting modes: --${mode} and --$1"
    exit 1
  fi
  mode="$1"
}

parse_args() {
  while (( $# > 0 )); do
    case "$1" in
      -t|--target)   target="${2:?--target needs a value}"; shift 2 ;;
      -d|--dir)      opt_dir="${2:?--dir needs a value}"; shift 2 ;;
      -f|--file)     opt_file="${2:?--file needs a value}"; shift 2 ;;
      -s|--suffix)   opt_suffix="${2:?--suffix needs a value}"; shift 2 ;;
      -a|--at)       opt_at="${2:?--at needs a value}"; shift 2 ;;
      --day-start)   day_start="${2:?--day-start needs a value}"; shift 2 ;;
      --stdin)       set_mode stdin; shift ;;
      --edit-new)    set_mode edit-new; shift ;;
      --edit)
        set_mode edit; shift
        if (( $# > 0 )) && [[ "$1" != -* ]]; then opt_date="$1"; shift; fi
        ;;
      --resolve)     set_mode resolve; shift ;;
      --raw)         set_mode append; text_args=("${2?--raw needs a value}"); shift 2 ;;
      -n|--dry-run)  dry_run=1; shift ;;
      -q|--quiet)    quiet=1; shift ;;
      -h|--help)     usage; exit 0 ;;
      --)            set_mode append; shift; text_args=("$@"); break ;;
      *)
        p_err "unknown option: $1 (note text goes after --)"
        usage >&2
        exit 1
        ;;
    esac
  done

  case "${target}" in
    inbox|todo) ;;
    *) p_err "unknown target: ${target} (inbox|todo)"; exit 1 ;;
  esac
  if [[ ! "${day_start}" =~ ^([01]?[0-9]|2[0-3]):[0-5][0-9]$ ]]; then
    p_err "invalid --day-start: ${day_start} (HH:MM)"
    exit 1
  fi
}

# {{{ - Time & Target ---------------------------------------------------------

# Epoch seconds of "$1" (a 'date -d' string), or of now when empty.
to_epoch() {
  if [[ -z "${1:-}" ]]; then date +%s; return; fi
  date -d "$1" +%s 2> /dev/null || { p_err "invalid time: $1"; return 1; }
}

# The calendar date of epoch "$1", shifted back by the day start: with 04:00,
# 02:30 on the 6th is still the 5th.
logical_date() {
  local -r h="${day_start%%:*}" m="${day_start##*:}"
  date -d "@$(( $1 - (10#${h} * 3600 + 10#${m} * 60) ))" +%F
}

format_header() { printf '## %s' "$(date -d "@$1" --iso-8601=seconds)"; }

# Target file of the inbox for a given date (YYYY-MM-DD).
inbox_file() {
  local -r dir="${opt_dir:-${QN_DIR}}"
  if [[ -n "${opt_file}" ]]; then
    printf '%s/%s' "${dir}" "${opt_file}"
  else
    printf '%s/%s%s.md' "${dir}" "$1" "${opt_suffix:+-${opt_suffix}}"
  fi
}

# }}} - Time & Target ---------------------------------------------------------

# {{{ - Text ------------------------------------------------------------------

# '\n' becomes a newline, '\\n' stays a literal '\n'. Nothing else is touched.
unescape_newlines() {
  local s="$1"
  s="${s//'\\n'/$'\x01'}"
  s="${s//'\n'/$'\n'}"
  printf '%s' "${s//$'\x01'/'\n'}"
}

# Strip leading blank lines and all trailing whitespace.
trim_text() {
  local s="$1"
  while [[ "${s}" == *$'\n'* ]] && is_blank "${s%%$'\n'*}"; do
    s="${s#*$'\n'}"
  done
  printf '%s' "${s%"${s##*[![:space:]]}"}"
}

is_blank() { [[ -z "${1//[[:space:]]/}" ]]; }

# }}} - Text ------------------------------------------------------------------

# {{{ - Locking ---------------------------------------------------------------

# Run "$@" while holding the quicknote lock of the repo (or dir) "$1" that holds
# the target. Also holds notes-sync's lock briefly, so the 5-minute autosave
# never commits or rebases half-way through a write; notes-sync just skips one
# tick when it finds the lock taken.
with_lock() {
  local -r dir="$1"; shift
  local git_dir lock_file
  local -i qn_fd sync_fd=-1 rc

  mkdir -p "${dir}" || { p_err "cannot create ${dir}"; return 1; }
  if git_dir="$(git -C "${dir}" rev-parse --absolute-git-dir 2> /dev/null)"; then
    lock_file="${git_dir}/quicknote.lock"
  else
    git_dir=''
    lock_file="${dir}/.quicknote.lock"
  fi

  exec {qn_fd}> "${lock_file}" || { p_err "cannot open lock ${lock_file}"; return 1; }
  if ! flock -w 30 "${qn_fd}"; then
    p_err "timed out waiting for ${lock_file}"
    exec {qn_fd}>&-
    return 1
  fi
  # Only where notes-sync runs (its lock exists): no stray files in other repos.
  if [[ -n "${git_dir}" && -e "${git_dir}/notes-sync.lock" ]] \
     && exec {sync_fd}> "${git_dir}/notes-sync.lock"; then
    flock -w 10 "${sync_fd}" || p_dbg "notes-sync lock busy, writing anyway"
  fi

  "$@"; rc=$?

  (( sync_fd >= 0 )) && exec {sync_fd}>&-
  exec {qn_fd}>&-
  return "${rc}"
}

# Replace "$1" with the contents of file "$2" atomically (same-dir temp + mv),
# so neither a reader nor notes-sync ever sees a half-written file.
replace_file() {
  local -r file="$1" src="$2"
  local tmp
  tmp="$(mktemp "${file}.qn-XXXXXX.tmp")" || { p_err "cannot create temp file next to ${file}"; return 1; }
  if ! cat "${src}" > "${tmp}"; then rm -f "${tmp}"; return 1; fi
  [[ -e "${file}" ]] && chmod --reference="${file}" "${tmp}" 2> /dev/null
  mv -f "${tmp}" "${file}" || { rm -f "${tmp}"; p_err "cannot replace ${file}"; return 1; }
}

# }}} - Locking ---------------------------------------------------------------

# {{{ - Writers ---------------------------------------------------------------

# Append "$2" (text) as a section dated epoch "$1" to the logical day's file.
# Same format as bin/voice-note: blank line, '## <time>', blank line, text.
do_append_section() {
  local -r file="$1" header="$2" text="$3"
  printf '\n%s\n\n%s\n' "${header}" "${text}" >> "${file}" \
    || { p_err "cannot append to ${file}"; return 1; }
}

# Insert "$2" (text) as a '- [ ]' bullet at the end of QN_TODO_SECTION. Extra
# lines become sub-bullets.
do_insert_todo() {
  local -r file="$1" date="$2" text="$3"
  local entry line first=1 tmp
  local -i rc

  while IFS= read -r line; do
    is_blank "${line}" && continue
    if (( first )); then
      entry="- [ ] ${line} _(${date})_"
      first=0
    else
      line="${line#"${line%%[![:blank:]]*}"}"
      line="${line#[-*] }"
      entry+=$'\n'"  - ${line}"
    fi
  done <<< "${text}"

  [[ -f "${file}" ]] || { p_err "TODO file not found: ${file}"; return 1; }
  tmp="$(mktemp)" || return 1
  # The entry goes in via ENVIRON: 'awk -v' would interpret backslashes in it.
  QN_ENTRY="${entry}" QN_SECTION="${QN_TODO_SECTION}" awk '
    BEGIN { entry = ENVIRON["QN_ENTRY"]; sec = ENVIRON["QN_SECTION"] }
    function flush_entry() { print entry; for (i = 0; i < nb; i++) print ""; nb = 0; done = 1; in_sec = 0 }
    in_sec && /^#+ / { flush_entry() }
    in_sec {
      if ($0 ~ /^[[:space:]]*$/) { nb++; next }
      for (i = 0; i < nb; i++) print ""
      nb = 0; print; next
    }
    !done && $0 == sec { in_sec = 1 }
    { print }
    END {
      if (in_sec) flush_entry()
      if (!done) exit 3
    }' "${file}" > "${tmp}"
  rc=$?
  if (( rc == 3 )); then
    p_err "section '${QN_TODO_SECTION}' not found in ${file}"
  elif (( rc == 0 )); then
    replace_file "${file}" "${tmp}"; rc=$?
  fi
  rm -f "${tmp}"
  return "${rc}"
}

# Save text "$2" as a note at epoch "$1" to the current target. The single entry
# point for every writer, so format, rollover and locking stay identical.
save_note() {
  local -r epoch="$1"
  local text date file header
  text="$(trim_text "$2")"
  if is_blank "${text}"; then
    p_msg 'nothing to save'
    return 0
  fi
  date="$(logical_date "${epoch}")"
  header="$(format_header "${epoch}")"

  if [[ "${target}" == todo ]]; then
    file="${QN_TODO_FILE}"
    if (( dry_run )); then
      printf 'would add to %s (%s):\n%s\n' "${file}" "${QN_TODO_SECTION}" "${text}"
      return 0
    fi
    with_lock "$(dirname "${file}")" do_insert_todo "${file}" "${date}" "${text}" || return 1
  else
    file="$(inbox_file "${date}")"
    if (( dry_run )); then
      printf 'would append to %s:\n\n%s\n\n%s\n' "${file}" "${header}" "${text}"
      return 0
    fi
    with_lock "$(dirname "${file}")" do_append_section "${file}" "${header}" "${text}" || return 1
  fi
  p_msg "saved → ${file}"
}

# }}} - Writers ---------------------------------------------------------------

# {{{ - Drafts ----------------------------------------------------------------

# Each editor session is a set of files sharing one id in DRAFT_DIR:
#   <id>.md    the draft the editor works on
#   <id>.orig  the draft as first written (unchanged on exit → discard)
#   <id>.base  edit mode: the target as it was when the editor opened
#   <id>.meta  how to save it (sourced; written with printf %q)
#   <id>.lock  flock'ed for the whole session; free lock = orphaned draft

draft_files() { printf '%s\n' "${DRAFT_DIR}/$1".{md,orig,base,meta,lock}; }
draft_remove() { local -a f; mapfile -t f < <(draft_files "$1"); rm -f "${f[@]}"; }

# Ids of drafts whose session is gone: nobody holds their lock.
orphan_ids() {
  local meta lock
  local -i fd
  [[ -d "${DRAFT_DIR}" ]] || return 0
  for meta in "${DRAFT_DIR}"/*.meta; do
    [[ -e "${meta}" ]] || continue
    lock="${meta%.meta}.lock"
    exec {fd}>> "${lock}" || continue
    if flock -n "${fd}"; then
      basename "${meta}" .meta
    fi
    exec {fd}>&-
  done
}

warn_orphans() {
  local -a ids
  mapfile -t ids < <(orphan_ids)
  (( ${#ids[@]} > 0 )) \
    && p_warn "${#ids[@]} unsaved draft(s) from an interrupted editor — run: quicknote --resolve"
  return 0
}

# Editor command as an array: VISUAL in a local graphical session, else EDITOR.
pick_editor() {
  local cmd="${EDITOR:-vi}"
  if [[ -n "${VISUAL:-}" && -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" && -z "${SSH_CONNECTION:-}" ]]; then
    cmd="${VISUAL}"
  fi
  read -ra editor <<< "${cmd}"
}

# Open file "$1" with the cursor at the end of its last line, in insert mode
# where the editor has one.
run_editor() {
  local -r file="$1"
  local -a editor
  local -i lines cols
  pick_editor
  lines="$(wc -l < "${file}")"
  (( lines < 1 )) && lines=1
  cols="$(( $(tail -n 1 "${file}" | wc -c) ))"
  (( cols < 1 )) && cols=1
  case "${editor[0]##*/}" in
    vim|nvim|gvim|mvim) editor+=("+" "-c" "startinsert!" "${file}") ;;
    emacs|emacsclient)  editor+=("+${lines}:${cols}" "${file}") ;;
    code|codium|code-insiders) editor+=("--goto" "${file}:${lines}:${cols}") ;;
    *)                  editor+=("${file}") ;;
  esac
  p_dbg "editor: ${editor[*]}"
  "${editor[@]}"
}

# Create a draft for the current mode; prints its id.
draft_create() {
  local -r kind="$1" file="${2:-}"
  local md id
  mkdir -p "${DRAFT_DIR}" || { p_err "cannot create ${DRAFT_DIR}"; return 1; }
  md="$(mktemp "${DRAFT_DIR}/$(date +%Y-%m-%dT%H%M%S)-${kind}-XXXX.md")" || return 1
  id="$(basename "${md}" .md)"

  if [[ "${kind}" == edit ]]; then
    if [[ -f "${file}" ]]; then cp "${file}" "${DRAFT_DIR}/${id}.base"; else : > "${DRAFT_DIR}/${id}.base"; fi
    { cat "${DRAFT_DIR}/${id}.base"; printf '\n%s\n\n' "${PLACEHOLDER}"; } > "${md}"
  fi
  cp "${md}" "${DRAFT_DIR}/${id}.orig"
  {
    printf 'd_kind=%q\n' "${kind}"
    printf 'd_target=%q\n' "${target}"
    printf 'd_dir=%q\n' "${opt_dir}"
    printf 'd_file=%q\n' "${opt_file}"
    printf 'd_suffix=%q\n' "${opt_suffix}"
    printf 'd_day_start=%q\n' "${day_start}"
    printf 'd_edit_file=%q\n' "${file}"
  } > "${DRAFT_DIR}/${id}.meta"
  printf '%s' "${id}"
}

# Restore the save options of draft "$1" into the globals save_note reads.
draft_load_meta() {
  local d_kind d_target d_dir d_file d_suffix d_day_start d_edit_file
  # shellcheck source=/dev/null
  source "${DRAFT_DIR}/$1.meta" || return 1
  draft_kind="${d_kind}"; draft_edit_file="${d_edit_file}"
  target="${d_target}"; opt_dir="${d_dir}"; opt_file="${d_file}"
  opt_suffix="${d_suffix}"; day_start="${d_day_start}"
}

# Save draft "$1" with note time epoch "$2". Returns 0 when the draft is done
# (saved or intentionally discarded) and may be deleted, 1 to keep it.
draft_commit() {
  local -r id="$1" epoch="$2"
  local -r md="${DRAFT_DIR}/${id}.md"
  local draft_kind='' draft_edit_file=''
  draft_load_meta "${id}" || { p_err "unreadable draft metadata: ${id}"; return 1; }

  if cmp -s "${md}" "${DRAFT_DIR}/${id}.orig"; then
    p_msg 'unchanged, discarded'
    return 0
  fi
  if [[ "${draft_kind}" == new ]]; then
    save_note "${epoch}" "$(< "${md}")"
  else
    edit_commit "${id}" "${epoch}" "${draft_edit_file}"
  fi
}

# Edit mode: the draft is the file as it was opened, plus a new section under
# the placeholder. The two parts are saved differently, so that the common
# case (voice-note or qn appending while the editor is open) never conflicts:
# - edits to the existing notes are 3-way merged with the file as it is now;
# - the new section is appended after that, like any other note.
edit_commit() {
  local -r id="$1" epoch="$2" file="$3"
  local -r md="${DRAFT_DIR}/${id}.md" base="${DRAFT_DIR}/${id}.base"
  local existing cur merged n new_text=''
  local -i rc

  existing="$(mktemp "${DRAFT_DIR}/${id}.existing-XXXX")" || return 1
  n="$(grep -nxF -- "${PLACEHOLDER}" "${md}" | tail -n 1)"; n="${n%%:*}"
  if [[ -n "${n}" ]]; then
    new_text="$(trim_text "$(tail -n "+$(( n + 1 ))" "${md}")")"
    head -n "$(( n - 1 ))" "${md}" > "${existing}"
  else
    cp "${md}" "${existing}"
  fi
  # Same trailing-newline shape as the base, so an untouched part compares equal.
  printf '%s\n' "$(< "${existing}")" > "${existing}.n" && mv -f "${existing}.n" "${existing}"
  if [[ "$(< "${existing}")" == "$(< "${base}")" ]]; then
    cp "${base}" "${existing}"
    if is_blank "${new_text}"; then
      rm -f "${existing}"
      p_msg 'unchanged, discarded'
      return 0
    fi
  fi

  if (( dry_run )); then
    printf 'would write %s:\n' "${file}"
    diff -u "${base}" "${existing}"
    is_blank "${new_text}" || printf '\n%s\n\n%s\n' "$(format_header "${epoch}")" "${new_text}"
    rm -f "${existing}"
    return 1
  fi

  cur="$(mktemp "${DRAFT_DIR}/${id}.cur-XXXX")" || { rm -f "${existing}"; return 1; }
  merged="$(mktemp "${DRAFT_DIR}/${id}.merged-XXXX")" || { rm -f "${existing}" "${cur}"; return 1; }
  with_lock "$(dirname "${file}")" \
    edit_write "${file}" "${base}" "${existing}" "${cur}" "${merged}" "${epoch}" "${new_text}"
  rc=$?
  rm -f "${existing}" "${cur}" "${merged}"
  return "${rc}"
}

# Under lock: merge the edited existing part into the file as it is now, then
# append the new section. On overlapping edits, write everything to a
# .conflict file and leave the target untouched.
edit_write() {
  local -r file="$1" base="$2" existing="$3" cur="$4" merged="$5" epoch="$6" new_text="$7"
  local conflict note='' msg=''
  local -i rc=0

  if [[ -f "${file}" ]]; then cp "${file}" "${cur}"; else : > "${cur}"; fi
  if cmp -s "${existing}" "${base}"; then
    cp "${cur}" "${merged}"                       # existing notes not edited
  elif cmp -s "${cur}" "${base}"; then
    cp "${existing}" "${merged}"                  # file not changed meanwhile
  else
    git merge-file -p -L current -L base -L draft "${cur}" "${base}" "${existing}" > "${merged}"
    rc=$?
    msg=' (merged with changes made while editing)'
    if (( rc < 0 || rc >= 128 )); then
      p_err "git merge-file failed (${rc})"
      return 1
    fi
  fi
  if ! is_blank "${new_text}"; then
    printf -v note '\n%s\n\n%s\n' "$(format_header "${epoch}")" "${new_text}"
    printf '%s' "${note}" >> "${merged}" || return 1
  fi

  if (( rc == 0 )); then
    replace_file "${file}" "${merged}" || return 1
    p_msg "saved → ${file}${msg}"
    return 0
  fi
  conflict="${file%.md}.conflict-$(date +%Y-%m-%dT%H%M%S).md"
  cp "${merged}" "${conflict}" || return 1
  p_warn "${file##*/} changed while editing, and your edits overlap those changes"
  p_warn "${file##*/} left untouched; your version, with conflict markers: ${conflict}"
  p_warn "merge it with: quicknote --resolve"
  return 0
}

# Run an editor session for a fresh or existing draft, then save it.
edit_session() {
  local -r id="$1"
  local -r md="${DRAFT_DIR}/${id}.md"
  local -i fd editor_rc

  exec {fd}>> "${DRAFT_DIR}/${id}.lock" || return 1
  if ! flock -n "${fd}"; then
    p_err "draft ${id} is open in another session"
    exec {fd}>&-
    return 1
  fi
  # {fd}>&-: the editor must not inherit the lock. A GUI editor that outlives
  # this script would otherwise keep the draft looking "alive" forever.
  run_editor "${md}" {fd}>&-
  editor_rc=$?

  if (( editor_rc != 0 )); then
    p_warn "editor exited with ${editor_rc}; draft kept: ${md}"
    p_warn "recover it with: quicknote --resolve"
  elif draft_commit "${id}" "$(date +%s)" || (( dry_run )); then
    draft_remove "${id}"
  else
    p_warn "draft not saved, kept: ${md} — recover with: quicknote --resolve"
  fi
  exec {fd}>&-
  (( editor_rc == 0 ))
}

# }}} - Drafts ----------------------------------------------------------------

# {{{ - Resolve ---------------------------------------------------------------

ask() {
  local reply
  read -r -p "$1 " reply < /dev/tty || return 1
  printf '%s' "${reply}"
}

resolve_drafts() {
  local id md choice
  local -i fd
  local -a ids
  mapfile -t ids < <(orphan_ids)
  for id in "${ids[@]}"; do
    md="${DRAFT_DIR}/${id}.md"
    exec {fd}>> "${DRAFT_DIR}/${id}.lock" || continue
    flock -n "${fd}" || { exec {fd}>&-; continue; }
    printf '\n=== draft %s (last change %s)\n' "${id}" "$(date -r "${md}" '+%F %T')"
    head -n 20 "${md}"
    (( $(wc -l < "${md}") > 20 )) && printf '[...]\n'
    choice="$(ask '[s]ave (timestamp = last change) / [e]dit, then save / [d]iscard / [k]eep for later?')" \
      || { exec {fd}>&-; return 1; }
    case "${choice}" in
      s|S)
        if draft_commit "${id}" "$(stat -c %Y "${md}")"; then draft_remove "${id}"; fi ;;
      e|E)
        exec {fd}>&-
        # edit_session takes the lock itself
        edit_session "${id}"
        continue ;;
      d|D) draft_remove "${id}"; p_msg 'discarded' ;;
      *)   p_msg 'kept' ;;
    esac
    exec {fd}>&-
  done
}

resolve_conflicts() {
  local conflict file choice
  local -a diff_cmd
  if command -v nvim > /dev/null; then diff_cmd=(nvim -d)
  elif command -v vimdiff > /dev/null; then diff_cmd=(vimdiff)
  else diff_cmd=(diff -u)
  fi
  for conflict in "${opt_dir:-${QN_DIR}}"/*.conflict-*.md; do
    [[ -e "${conflict}" ]] || continue
    file="${conflict%.conflict-*}.md"
    printf '\n=== conflict %s\n    target   %s\n' "${conflict}" "${file}"
    choice="$(ask "[m]erge (${diff_cmd[*]}) / [d]elete / [k]eep for later?")" || return 1
    case "${choice}" in
      m|M)
        "${diff_cmd[@]}" "${file}" "${conflict}"
        [[ "$(ask "delete ${conflict##*/} now? [y/N]")" == [yY] ]] && rm -f "${conflict}" ;;
      d|D) rm -f "${conflict}"; p_msg 'deleted' ;;
      *)   p_msg 'kept' ;;
    esac
  done
}

# }}} - Resolve ---------------------------------------------------------------

# }}} = FUNCTIONS =============================================================

# {{{ = MAIN ==================================================================

main() {
  local text file epoch id

  parse_args "$@"
  if [[ -z "${mode}" ]]; then
    if [[ -t 0 ]]; then
      p_err 'no note given: use -- TEXT, --stdin, --edit-new or --edit'
      usage >&2
      exit 1
    fi
    mode=stdin
  fi
  [[ "${mode}" == resolve ]] || warn_orphans

  case "${mode}" in
    append)
      (( ${#text_args[@]} > 0 )) || { p_err 'no text after --'; exit 1; }
      epoch="$(to_epoch "${opt_at}")" || exit 1
      text="$(unescape_newlines "${text_args[*]}")"
      save_note "${epoch}" "${text}"
      ;;
    stdin)
      epoch="$(to_epoch "${opt_at}")" || exit 1
      text="$(cat)"
      save_note "${epoch}" "${text}"
      ;;
    edit-new)
      id="$(draft_create new)" || exit 1
      edit_session "${id}"
      ;;
    edit)
      if [[ "${target}" == todo ]]; then
        p_err "--edit works on the inbox; edit ${QN_TODO_FILE} directly"
        exit 1
      fi
      if [[ -n "${opt_date}" ]]; then
        opt_date="$(date -d "${opt_date}" +%F 2> /dev/null)" || { p_err "invalid date"; exit 1; }
      else
        opt_date="$(logical_date "$(date +%s)")"
      fi
      file="$(inbox_file "${opt_date}")"
      id="$(draft_create edit "${file}")" || exit 1
      edit_session "${id}"
      ;;
    resolve)
      resolve_drafts
      resolve_conflicts
      ;;
  esac
}

main "$@"

# }}} = MAIN ==================================================================
