#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; indent-tabs-mode: nil; tab-width: 2 -*-
# vim: ft=bash:et:ts=2:sts=2:sw=2
# code: language=bash insertSpaces=true tabSize=2
# shellcheck shell=bash
#
# Cycle keyboard layout (Extend → Colemak → QWERTY) for both Wayland and XWayland.
#
# Usage: kbd-layout-toggle         switch to the next layout group
#        kbd-layout-toggle sync    re-apply the XWayland map (exec_always)
#
# swaymsg xkb_switch_layout covers native Wayland apps; setxkbmap on DISPLAY=:0
# is required separately because XWayland does not propagate Sway's XKB group
# changes to its X11 clients (Wine/Proton games, legacy X11 apps).
#
# The X server cannot load ~/.config/xkb/symbols/custom, so X11 clients get the
# nearest stock equivalent: Colemak or US with CapsLock → Ctrl (ctrl:nocaps,
# mirroring custom(mods)). The Extend group maps to plain Colemak there, i.e.
# Extend does not work in X11 apps.

active_layout() {
  swaymsg -t get_inputs \
    | jq -r "[.[] | select(.type == \"keyboard\") | .${1}] | first"
}

# Sync the XWayland X11 keyboard map to match the active Wayland layout.
sync_x11() {
  local -ra opts=(-option "" -option ctrl:nocaps)
  if [[ "$(active_layout xkb_active_layout_name)" == *"QWERTY"* ]]; then
    DISPLAY=:0 setxkbmap -layout us "${opts[@]}"
  else
    DISPLAY=:0 setxkbmap -layout us -variant colemak "${opts[@]}"
  fi 2>/dev/null
}

main() {
  case "${1:-}" in
    sync)
      sync_x11
      ;;
    "")
      swaymsg -q input type:keyboard xkb_switch_layout next
      sync_x11
      notify-send --expire-time=2000 "Keyboard Layout" \
        "$(active_layout xkb_active_layout_name)"
      ;;
    *)
      echo "Usage: ${0##*/} [sync]" >&2
      exit 1
      ;;
  esac
}

main "$@"
