UNIT_RE = re.compile(
    r"(?<![\w.,$€£])(\d(?:[\d.,]*\d)?)\s?(" + "|".join(re.escape(u) for u in sorted(UNITS, key=len, reverse=True))
    + r")(?![\w/²³])"
)

# Spoken symbols. The ASCII ones need the spaces: "a->b" is code, "foo&bar" a name.
SYMBOLS = {
    "en": {"→": " to ", "⇒": " so ", "≥": " greater than or equal to ", "≤": " less than or equal to ", "≠": " not equal to ",
           "≈": " about ", "×": " times ", "±": " plus or minus ", " -> ": " to ", " => ": " so ",
           " >= ": " greater than or equal to ", " <= ": " less than or equal to ", " != ": " not equal to ", " & ": " and "},
    "de": {"→": " zu ", "⇒": " also ", "≥": " größer gleich ", "≤": " kleiner gleich ", "≠": " ungleich ",
           "≈": " ungefähr ", "×": " mal ", "±": " plus minus ", " -> ": " zu ", " => ": " also ",
           " >= ": " größer gleich ", " <= ": " kleiner gleich ", " != ": " ungleich ", " & ": " und "},
}
SYMBOL_RE = {
    lang: re.compile("|".join(re.escape(s) for s in sorted(table, key=len, reverse=True)))
    for lang, table in SYMBOLS.items()
}
APPROX_RE = re.compile(r"(?<![\w~/])~(?=\d)")
DIGIT_STAR_RE = re.compile(r"(?<=\d)\s?\*\s?(?=\d)")

# Section titles that end the readable part of a text, when only such sections follow. Plain text has no heading
# marks, so a one-line paragraph only counts for the unmistakable titles; "Notes" or "Quellen" need a real heading.
REFERENCE_TITLES_PLAIN = {
    "references", "see also", "external links", "further reading", "bibliography", "footnotes",
    "einzelnachweise", "weblinks", "siehe auch", "literaturverzeichnis", "fußnoten",
}
REFERENCE_TITLES = REFERENCE_TITLES_PLAIN | {
    "notes", "sources", "citations", "works cited",
    "anmerkungen", "quellen", "quellenangaben", "belege", "literatur", "referenzen",
}

STOPWORDS = {
    "de": set("der die das und ist nicht ein eine einer mit von zu den dem des auf für auch sich im es sie wir ich aber "  # noqa: SIM905
              "oder wird werden wurde dass wenn noch nur wie bei aus nach zum zur über ".split()),
    "en": set("the and is not a an of to in that it for with as on are this be by or from at was but have has you "  # noqa: SIM905
              "we they which can will if there their would about ".split()),
}


def detect_lang(text: str) -> str:
    """Guess ``de`` or ``en`` from stopword counts; English wins ties and empty input."""
    words = re.findall(r"[a-zäöüß]+", text.lower())
    scores = {lang: sum(w in sw for w in words) for lang, sw in STOPWORDS.items()}
    return "de" if scores["de"] > scores["en"] else "en"


def _acronym(match: re.Match[str]) -> str:
    """Collapse ``S.M.A.R.T.``; pronounceable ones (4+ letters, has a vowel) become a word."""
    letters = match.group(0).replace(".", "")
    if len(letters) >= 4 and letters.isupper() and re.search(r"[AEIOU]", letters):
        return letters.capitalize()
    return letters.upper() if letters.isupper() else match.group(0)


def expand_abbreviations(text: str, lang: str) -> str:
    """Replace known abbreviations with their spoken form, then collapse dotted acronyms."""
    # English Latin-isms turn up in German text as well, so that table always applies
    tables = [ABBREVIATIONS["en"]] if lang == "en" else [ABBREVIATIONS.get(lang, {}), ABBREVIATIONS["en"]]
    for table in tables:
        for pattern, spoken in table.items():
            text = re.sub(pattern, spoken, text)
    return DOTTED_ACRONYM_RE.sub(_acronym, text)


def strip_terminal(text: str) -> str:
    """Remove terminal escapes, UI decoration and control characters."""
    text = ANSI_RE.sub("", text)
    text = INPUT_JUNK_RE.sub("", text)
    text = BOX_RE.sub(" ", text)
    return UI_MARKS_RE.sub("", text)


def scrub(text: str) -> str:
    """Remove citation markers and leftovers from a rendered run of inline text."""
    text = FOOTNOTE_RE.sub("", text)
    text = CARET_RE.sub("", text)
    text = SUPERSCRIPT_RE.sub("", text)
    text = BARE_FOOTNOTE_RE.sub("", text)
    text = EMPTY_PARENS_RE.sub("", text)
    text = TABLE_RULE_RE.sub("", text)
    text = text.replace("|", " ")
    text = LINE_EMOJI_RE.sub(rf"{ITEM_MARK}\1, ", text).replace(EMOJI_MARK, "")
    return BULLET_RE.sub(ITEM_MARK, text)


# {{{ Entities


def split_tail(raw: str) -> tuple[str, str]:
    """Split trailing sentence punctuation off a matched URL or path."""
    core = raw.rstrip(".,;:!?")
    return core, raw[len(core):]


@dataclass
class Held:
    """Spoken forms parked on single private-use characters until the text passes are done.

    Abbreviation expansion and number spelling would otherwise rewrite what was already put into words, and the
    phone number search would see digits in a placeholder made of them.
    """

    slots: list[str] = field(default_factory=list)
    base: int = 0xF0000

    def hold(self, spoken: str) -> str:
        """Store ``spoken``, return its placeholder."""
        self.slots.append(spoken)
        return chr(self.base + len(self.slots) - 1)

    def restore(self, text: str) -> str:
        """Put every held spoken form back."""
        return HELD_RE.sub(lambda m: self.slots[ord(m.group(0)) - self.base], text)


@dataclass
class Speaker:
    """Turns the things written for the eye into words, in one language."""

    lang: str
    held: Held = field(default_factory=Held)

    def text(self, text: str) -> str:
        """Rewrite every entity found in a run of plain text."""
        text = DECOR_RE.sub("", self._emoji(text))
        text = URL_RE.sub(self._on_url, text)
        text = SCP_RE.sub(lambda m: self.held.hold(f"SSH {self._word('address')} {self._host(m.group(1))}"), text)
        text = EMAIL_RE.sub(lambda m: self.held.hold(self._email(m.group(1))), text)
        text = BARE_DOMAIN_RE.sub(self._on_bare_domain, text)
        text = IP_RE.sub(lambda m: self.held.hold(self._dotted(m.group(1))), text)
        text = UUID_RE.sub(lambda _: self.held.hold("UUID"), text)
        text = WINDOWS_PATH_RE.sub(self._on_path, text)
        text = UNIX_PATH_RE.sub(self._on_path, text)
        text = RELATIVE_PATH_RE.sub(self._on_relative_path, text)
        text = VERSION_RE.sub(self._on_version, text)
        text = PRODUCT_VERSION_RE.sub(lambda m: f"{m.group(1)}{m.group(2)}{self.held.hold(self._dotted(m.group(3)))}", text)
        text = HASH_RE.sub(lambda _: self.held.hold("Hash"), text)
        text = self._phones(text)
        if self.lang == "de":
            text = POSTCODE_RE.sub(lambda m: self.held.hold(self._digits(m.group(0))), text)
        text = IDENTIFIER_RE.sub(self._on_identifier, text)
        text = UNIT_RE.sub(self._on_unit, text)
        text = POWER_RE.sub(self._on_power, text)
        text = SYMBOL_RE[self.lang].sub(lambda m: SYMBOLS[self.lang][m.group(0)], text)
        text = APPROX_RE.sub(f"{self._word('about')} ", text)
        return DIGIT_STAR_RE.sub(f" {self._word('times')} ", text)

    def code(self, code: str) -> str:
        """Speak inline code: an entity as such, a word or short command cleaned up, anything longer announced."""
        code = code.strip()
        spoken = self.text(code)
        if len(spoken) == 1 and spoken >= chr(self.held.base):
            return spoken
        if BARE_RELATIVE_PATH_RE.fullmatch(code):
            return self.held.hold(self._path(code, None))
        if len(code) > MAX_SPOKEN_CODE:
            return self.held.hold(self._word("code_skipped"))
        return CLI_FLAG_RE.sub("", CAMEL_RE.sub(" ", spoken))

    def code_block(self, info: str, body: str) -> str:
        """Announce a code block that is not read aloud."""
        parts = [self._word("code_block")]
        language = self._code_language(info)
        if language:
            parts.append(language)
        parts += [self.count(max(body.count("\n"), 1), "line"), self._word("skipped")]
        return ", ".join(parts) + "."

    def skipped_table(self, rows: int) -> str:
        """Announce a table too large to read."""
        return f"{self._word('table')}, {self.count(rows, 'row')}, {self._word('skipped')}."

    def count(self, n: int, unit: str) -> str:
        """Spell "three lines"."""
        one, many = COUNTS[self.lang][unit]
        return one if n == 1 else f"{self._number(n)} {many}"

    def times(self) -> str:
        """Spoken multiplication sign."""
        return f" {self._word('times')} "

    def _word(self, key: str) -> str:
        return WORDS[self.lang][key]

    def _emoji(self, text: str) -> str:
        """Name the emoji in ``text``, marked for scrub(); a run is one mention: "rocket, sparkles emoji"."""
        names: list[str] = []

        def note(chars: str, _: dict[str, object]) -> str:
            if chars[0] in EMOJI_TEXT_SYMBOLS:
                return chars
            if chars[0].isdigit():  # 1️⃣ numbers a list item, it is not a picture
                return EMOJI_MARK + chars[0]
            names.append(self._emoji_name(chars))
            return EMOJI_SLOT

        found = iter(names)

        def run(m: re.Match[str]) -> str:
            spoken = ", ".join(dict.fromkeys(next(found) for _ in range(m.group(2).count(EMOJI_SLOT))))
            mention = EMOJI_MARK + self.held.hold(f"{spoken} {self._word('emoji')}")
            return " ".join(filter(None, [m.group(1), mention, m.group(3)]))

        text = EMOJI_SHORTCODE_RE.sub(lambda m: emoji.emojize(m.group(0), language="alias"), text)
        return EMOJI_RUN_RE.sub(run, emoji.replace_emoji(text, note))

    def _emoji_name(self, chars: str) -> str:
        """Speak an emoji's name; skin tones say nothing about what it means."""
        name = emoji.demojize(SKIN_TONE_RE.sub("", chars), language=self.lang, delimiters=("", ""))
        return EMOJI_NAME_JUNK_RE.sub(" ", name).strip()

    def _number(self, n: int) -> str:
        return de_cardinal(n) if self.lang == "de" else en_cardinal(n)

    def _digits(self, digits: str) -> str:
        ones = _DE_ONES if self.lang == "de" else _EN_ONES
        return " ".join(ones[int(d)] for d in digits)

    def _dotted(self, dotted: str) -> str:
        """Spell the parts of an IP address or version: "one dot two dot three"."""
        return f" {self._word('dot')} ".join(self._number(int(p)) for p in dotted.split("."))

    def _host(self, host: str) -> str:
        """Speak a host name; www. is dropped, "web address" already says it."""
        host = host.lower().removeprefix("www.")
        if IP_RE.fullmatch(host):
            return self._dotted(host)
        return f" {self._word('dot')} ".join(host.split("."))

    def _email(self, address: str) -> str:
        user, _, domain = address.partition("@")
        return f" {self._word('dot')} ".join(user.split(".")) + f" at {self._host(domain)}"

    def _on_url(self, m: re.Match[str]) -> str:
        core, tail = split_tail(m.group(0))
        return self.held.hold(self._url(core)) + tail

    def _on_bare_domain(self, m: re.Match[str]) -> str:
        _, tail = split_tail(m.group(0))
        return self.held.hold(self._url(m.group(1))) + tail

    def _url(self, url: str) -> str:
        """Speak a URL as its type and host; path, query and port are of no use by ear."""
        try:
            parts = urlsplit(url if "://" in url else f"//{url}")
            host = parts.hostname
        except ValueError:
            parts, host = None, None
        scheme = parts.scheme.lower() if parts else ""
        if scheme == "file" and parts:
            return self._path(parts.path, None)
        if scheme in WEB_SCHEMES:
            kind = self._word("web")
        else:
            kind = scheme.upper() if scheme in SPELLED_SCHEMES else scheme
        return f"{kind} {self._word('address')}" + (f" {self._host(host)}" if host else "")

    def _on_path(self, m: re.Match[str]) -> str:
        line = m.group(1) if m.re.groups else None
        if line:
            return self.held.hold(self._path(m.group(0).split(":", 1)[0], line))
        core, tail = split_tail(m.group(0))
        return self.held.hold(self._path(core, None)) + tail

    def _on_relative_path(self, m: re.Match[str]) -> str:
        """Unanchored paths only with a line number or file extension: "km/h" and "A/B" stay as they are."""
        if m.group(1):
            return self._on_path(m)
        core, _ = split_tail(m.group(0))
        return self._on_path(m) if PATH_EXTENSION_RE.search(core) else m.group(0)

    def _path(self, path: str, line: str | None) -> str:
        """Speak a path as its last component: "file config dot ini", "file tts clean, line forty-two"."""
        name = re.split(r"[/\\]", path.rstrip("/\\"))[-1]
        if path.endswith(("/", "\\")):
            kind = "folder"
        else:
            kind = "file" if line or "." in name else "path"
        spoken = f"{self._word(kind)} {self._name(name)}"
        return f"{spoken}, {self._word('line')} {self._number(int(line))}" if line else spoken

    def _name(self, name: str) -> str:
        """Speak a file name: separators become spaces, dots are named."""
        spaced = NAME_SEPARATOR_RE.sub(" ", name).strip()
        return re.sub(r"\s*\.\s*", f" {self._word('dot')} ", spaced).strip()

    def _on_version(self, m: re.Match[str]) -> str:
        """Speak ``v1.2`` and ``1.2.3``; dates, thousands and plain decimals are left to the number passes."""
        prefix, dotted = m.group(1), m.group(2)
        parts = dotted.split(".")
        if not prefix and (len(parts) < 3 or re.fullmatch(r"\d{1,2}\.\d{1,2}\.(?:\d{2}|\d{4})", dotted)
                           or all(len(p) == 3 for p in parts[1:])):
            return m.group(0)
        return self.held.hold(self._dotted(dotted))

    def _on_identifier(self, m: re.Match[str]) -> str:
        """``MAX_RETRY_COUNT`` -> "max retry count"; all capitals would be spelled letter by letter."""
        name = m.group(0)
        return (name.lower() if name.isupper() else name).replace("_", " ")

    def _on_unit(self, m: re.Match[str]) -> str:
        number, unit = m.group(1), m.group(2)
        en_one, en_many, de_one, de_many = UNITS[unit]
        if self.lang == "de":
            return de_one if number == "1" else f"{number} {de_many}"
        return f"{number} {en_one if number == '1' else en_many}"

    def _on_power(self, m: re.Match[str]) -> str:
        """Speak ``x^2`` and ``mc²``; only short bases, since a word with a raised digit is a footnote."""
        exponent = m.group(2) or m.group(3).translate(SUPERSCRIPT_DIGITS)
        return f"{m.group(1)} {self._word('power')} {exponent}"

    def _phones(self, text: str) -> str:
        """Read valid phone numbers digit by digit, in the groups they were written in."""
        if sum(c.isdigit() for c in text) < 7:
            return text
        region = "DE" if self.lang == "de" else "US"
        for match in reversed(list(phonenumbers.PhoneNumberMatcher(text, region))):
            groups = re.findall(r"\+|\d+", match.raw_string)
            spoken = ", ".join("plus" if g == "+" else self._digits(g) for g in groups).replace("plus, ", "plus ")
            text = text[:match.start] + self.held.hold(spoken) + text[match.end:]
        return text

    def _code_language(self, info: str) -> str:
        """Speak a code block's language: known ones from the table, anything else as written."""
        words = info.split()
        name = words[0].strip("{}.").lower() if words else ""
        if not name or name in CODE_NO_LANGUAGE:
            return ""
        entry = CODE_LANGUAGE_INDEX.get(name)
        if entry is None:
            return re.sub(r"[/_]", " ", name)
        return entry[2] if self.lang == "de" and len(entry) > 2 else entry[1]


# }}} Entities


# {{{ Markdown


@dataclass
class Block:
    """One rendered block: a paragraph, heading, list item or table row."""

    text: str
    sep: str = "\n\n"
    heading: bool = False


def render_inline(token: Token, speaker: Speaker) -> str:
    """Render one block's inline content; links keep their text, images and footnote references vanish."""
    children = token.children or []
    out: list[str] = []
    i = 0
    while i < len(children):
        child = children[i]
        if child.type == "text":
            out.append(speaker.text(child.content))
        elif child.type == "code_inline":
            out.append(speaker.code(child.content))
        elif child.type in ("softbreak", "hardbreak"):
            out.append("\n")
        elif child.type == "link_open":
            # [1](url) and a [1] that a reference definition turned into a link: a citation, not words
            if i + 2 < len(children) and children[i + 2].type == "link_close" and children[i + 1].content.isdigit():
                i += 2
        elif child.type == "html_inline" and child.content.lower().startswith("<sup"):
            while i + 1 < len(children) and children[i].content.lower() != "</sup>":
                i += 1
        elif child.type in ("em_open", "em_close") and child.markup == "*" and _between_digits(children, i):
            out.append(speaker.times())  # 2*3*4 is no emphasis
        i += 1
    return scrub("".join(out))


def _between_digits(children: list[Token], i: int) -> bool:
    """Whether the delimiter at ``i`` has a digit directly on both sides."""
    if i == 0 or i + 1 >= len(children):
        return False
    before, after = children[i - 1].content, children[i + 1].content
    return before[-1:].isdigit() and after[:1].isdigit()


def render_table(tokens: list[Token], start: int, speaker: Speaker) -> tuple[int, list[Block]]:
    """Render the table at ``start`` row by row, or announce it; returns the index of its last token and the blocks."""
    rows: list[list[str]] = []
    i = start
    while tokens[i].type != "table_close":
        if tokens[i].type == "tr_open":
            rows.append([])
        elif tokens[i].type == "inline":
            rows[-1].append(render_inline(tokens[i], speaker).strip())
        i += 1
    if not rows:
        return i, []
    header, body = rows[0], rows[1:]
    if len(body) > MAX_TABLE_ROWS or len(header) > MAX_TABLE_COLUMNS:
        return i, [Block(speaker.skipped_table(len(body)))]
    blocks = [Block(ITEM_MARK + ", ".join(f"{h} {c}".strip() for h, c in zip(header, row) if c), "\n") for row in body]
    if blocks:
        blocks[-1].sep = "\n\n"
    return i, blocks


def render_blocks(tokens: list[Token], speaker: Speaker) -> list[Block]:
    """Walk the parsed document and render what is worth saying, in order."""
    blocks: list[Block] = []
    depth = 0
    item_start = False
    i = 0
    while i < len(tokens):
        token = tokens[i]
        if token.type == "footnote_block_open":
            while tokens[i].type != "footnote_block_close":
                i += 1
        elif token.type == "fence":
            blocks.append(Block(speaker.code_block(token.info, token.content)))
        elif token.type == "table_open":
            i, rows = render_table(tokens, i, speaker)
            blocks += rows
        elif token.type == "html_block":
            bare = re.sub(r"(?is)<(script|style)\b.*?</\1>|<!--.*?-->|<[^>]+>", " ", token.content)
            if bare.strip():
                blocks.append(Block(scrub(speaker.text(html.unescape(bare)))))
        elif token.type in ("bullet_list_open", "ordered_list_open"):
            depth += 1
        elif token.type in ("bullet_list_close", "ordered_list_close"):
            depth -= 1
            if not depth and blocks:
                blocks[-1].sep = "\n\n"
        elif token.type == "list_item_open":
            item_start = True
        elif token.type == "heading_open":
            i += 1
            blocks.append(Block(render_inline(tokens[i], speaker), heading=True))
        elif token.type == "inline":
            mark = ITEM_MARK if item_start else ""
            item_start = False
            blocks.append(Block(mark + render_inline(token, speaker).lstrip(), "\n" if depth else "\n\n"))
        i += 1
    return blocks


def drop_reference_sections(blocks: list[Block]) -> list[Block]:
    """Cut the trailing run of "References", "Siehe auch" and the like.

    Walks back from the end and stops at the first ordinary heading, so a "Notes" section in the middle of a
    text survives. A selection that is nothing but such a section is read: selecting it was deliberate.
    """
    cut = None
    for index in range(len(blocks) - 1, -1, -1):
        block = blocks[index]
        title = HELD_RE.sub("", block.text).strip(f" \n.:,{ITEM_MARK}").lower()  # "📚 References" is still one
        if block.heading:
            if title not in REFERENCE_TITLES:
                break
            cut = index
        elif title in REFERENCE_TITLES_PLAIN:
            cut = index
    return blocks[:cut] if cut else blocks


def to_speech_text(text: str, speaker: Speaker, keep_references: bool = False) -> str:
    """Parse ``text`` as markdown and render it for reflow(), with blocks separated as it expects."""
    blocks = render_blocks(MARKDOWN.parse(text), speaker)
    if not keep_references:
        blocks = drop_reference_sections(blocks)
    return "".join(b.text + b.sep for b in blocks if b.text.strip(f" \n{ITEM_MARK}"))


# }}} Markdown


def reflow(text: str) -> str:
    """Join hard-wrapped lines; give short unpunctuated lines (headings, bullets) a sentence end.

    A blank line stays a paragraph break. A single newline is a soft wrap when the line before it
    runs close to the text's widest line (or ends in a comma or hyphen); a clearly shorter line
    without punctuation is a heading or list item and gets a full stop so the voice pauses.
    A lowercase start also means "continuation"; an uppercase start proves nothing, since German
    capitalizes every noun.
    """
    blocks = [
        [ln for ln in (re.sub(r"[ \t]+", " ", raw).strip() for raw in block.split("\n")) if ln]
        for block in re.split(r"\n\s*\n", text.replace("\r", ""))
    ]
    paragraphs: list[str] = []
    for lines in blocks:
        if not lines:
            continue
        # Per block, so one long unwrapped line elsewhere cannot skew the wrap width.
        width = max(len(ln.lstrip(ITEM_MARK)) for ln in lines)
        out = lines[0].lstrip(ITEM_MARK)
        for prev, nxt in pairwise(lines):
            prev = prev.lstrip(ITEM_MARK)
            item = nxt.startswith(ITEM_MARK)
            nxt = nxt.lstrip(ITEM_MARK)
            if item:
                out += (" " if prev.endswith(SENTENCE_END) else ". ") + nxt
            elif prev.endswith("-") and len(prev) > 1 and prev[-2].isalpha():
                out = (out[:-1] if nxt[:1].islower() else out) + nxt  # "recog-" + "nition", "Lebens-" + "Weise"
            elif prev.endswith(SENTENCE_END + (",",)) or nxt[:1].islower() or len(prev) >= WRAP_RATIO * width:
                out += " " + nxt
            else:
                out += ". " + nxt  # short line without punctuation: heading or item
        paragraphs.append(out if out.endswith(SENTENCE_END) else out + ".")
    return "\n\n".join(paragraphs)


# {{{ German numbers
# Piper (espeak-ng) reads "35" with a pause inside the word ("fünf | unddreißig") and "3." as a
# sentence end. Spelled-out numbers avoid both, and the neural engines read the words just as well.

_DE_ONES = ["null", "eins", "zwei", "drei", "vier", "fünf", "sechs", "sieben", "acht", "neun", "zehn", "elf",
            "zwölf", "dreizehn", "vierzehn", "fünfzehn", "sechzehn", "siebzehn", "achtzehn", "neunzehn"]
_DE_TENS = ["", "", "zwanzig", "dreißig", "vierzig", "fünfzig", "sechzig", "siebzig", "achtzig", "neunzig"]
_DE_ORDINAL_STEMS = {1: "erst", 3: "dritt", 7: "siebt", 8: "acht"}
_DE_MONTHS = {"januar", "jänner", "februar", "märz", "april", "mai", "juni", "juli", "august", "september",
              "oktober", "november", "dezember", "jan", "feb", "mär", "apr", "jun", "jul", "aug", "sep", "sept",
              "okt", "nov", "dez"}
# Words before an ordinal that take the "-en" ending ("am dritten"), and those that take "-e" ("der dritte").
_DE_ORD_EN = {"am", "vom", "zum", "im", "beim", "dem", "den", "des", "ab", "seit", "bis", "einem", "seinem",
              "ihrem", "diesem", "jedem"}
_DE_ORD_E = {"der", "die", "das", "jede", "jeder", "jedes", "diese", "dieser", "dieses"}
_WORD = r"[A-Za-zÄÖÜäöüß]+"


def _de_below_1000(n: int, final: bool = True) -> str:
    """Spell 0 < n < 1000; ``final=False`` gives the compound form ("ein" in "einhundert")."""
    hundreds, rest = divmod(n, 100)
    out = ("ein" if hundreds == 1 else _DE_ONES[hundreds]) + "hundert" if hundreds else ""
    if rest == 1:
        out += "eins" if final else "ein"
    elif rest < 20 and rest:
        out += _DE_ONES[rest]
    elif rest:
        tens, ones = divmod(rest, 10)
        out += (("ein" if ones == 1 else _DE_ONES[ones]) + "und" if ones else "") + _DE_TENS[tens]
    return out


def de_cardinal(n: int, year: bool = False) -> str:
    """Spell a German cardinal (n < 10**9); ``year`` reads 1100-1999 as "neunzehnhundertneunzig"."""
    if n == 0:
        return "null"
    if year and 1100 <= n <= 1999:
        rest = n % 100
        return _de_below_1000(n // 100, final=False) + "hundert" + (_de_below_1000(rest) if rest else "")
    millions, rest = divmod(n, 1_000_000)
    thousands, below = divmod(rest, 1000)
    words = []
    if millions:
        words.append("eine Million" if millions == 1 else f"{_de_below_1000(millions)} Millionen")
    small = (_de_below_1000(thousands, final=False) + "tausend" if thousands else "") + \
        (_de_below_1000(below) if below else "")
    if small:
        words.append(small)
    return " ".join(words)


def de_ordinal(n: int, ending: str) -> str:
    """Spell a German ordinal with ``ending`` ("e", "en", "er"): 3 -> "dritte", 20 -> "zwanzigste"."""
    rest = n % 100
    if rest and rest < 20:
        prefix = de_cardinal(n - rest) if n >= 100 else ""
        stem = prefix + _DE_ORDINAL_STEMS.get(rest, _DE_ONES[rest] + "t")
    else:
        stem = de_cardinal(n) + "st"
    return stem + ending


def _de_ordinal_ending(before: str | None, after: str | None) -> str | None:
    """Pick the ordinal ending from the neighbouring words, or None if "N." is not an ordinal."""
    b = (before or "").lower()
    if b in _DE_ORD_EN:
        return "en"
    if b in _DE_ORD_E:
        return "e"
    if (after or "").lower().rstrip(".") in _DE_MONTHS:
        return "er"  # "3. Oktober" on its own: "dritter Oktober"
    return None  # "Kapitel 3. Danach": a sentence end, not an ordinal


_DE_DATE_RE = re.compile(rf"(?:\b({_WORD})\s+)?\b(\d{{1,2}})\.(\d{{1,2}})\.(\d{{2,4}})\b")
_DE_ORDINAL_RE = re.compile(rf"(?:\b({_WORD})\s+)?\b(\d{{1,4}})\.(?=\s+({_WORD}))")
_DE_THOUSANDS_RE = re.compile(r"\b\d{1,3}(?:\.\d{3})+\b(?!\.\d)")
_DE_DECIMAL_RE = re.compile(r"\b(\d+),(\d+)\b")
_DE_PERCENT_RE = re.compile(r"(\d)\s?%")
_DE_CARDINAL_RE = re.compile(r"(?:\b(\S+)\s+)?(?<![\w.,:])(\d{1,9})(?!\w|[.,:]\d)")
_DE_TIME_RE = re.compile(r"\b([01]?\d|2[0-3]):([0-5]\d)\b(?:\s+Uhr\b)?")


def spell_numbers_de(text: str) -> str:
    """Spell out German dates, times, ordinals, decimals, percentages and cardinals."""

    def date(m: re.Match[str]) -> str:
        before, day, month, year = m.group(1), int(m.group(2)), int(m.group(3)), m.group(4)
        ending = _de_ordinal_ending(before, None) or "er"
        spoken = f"{de_ordinal(day, ending)} {de_ordinal(month, ending)} {de_cardinal(int(year), year=True)}"
        return f"{before} {spoken}" if before else spoken

    def ordinal(m: re.Match[str]) -> str:
        ending = _de_ordinal_ending(m.group(1), m.group(3))
        if ending is None:
            return m.group(0)
        spoken = de_ordinal(int(m.group(2)), ending)
        return f"{m.group(1)} {spoken}" if m.group(1) else spoken

    def cardinal(m: re.Match[str]) -> str:
        before, digits = m.group(1), m.group(2)
        # Leading zeros (codes, times) and model names ("RTX 4070") are not quantities.
        if (len(digits) > 1 and digits.startswith("0")) or (before and re.fullmatch(r"[A-Z][A-Z0-9-]+", before)):
            return m.group(0)
        spoken = de_cardinal(int(digits), year=True)
        return f"{before} {spoken}" if before else spoken

    text = _DE_DATE_RE.sub(date, text)
    text = _DE_TIME_RE.sub(
        lambda m: f"{de_cardinal(int(m.group(1)))} Uhr" + (f" {de_cardinal(int(m.group(2)))}" if int(m.group(2)) else ""),
        text)
    text = _DE_THOUSANDS_RE.sub(lambda m: m.group(0).replace(".", ""), text)
    text = _DE_ORDINAL_RE.sub(ordinal, text)
    text = _DE_PERCENT_RE.sub(r"\1 Prozent", text)
    text = _DE_DECIMAL_RE.sub(
        lambda m: f"{de_cardinal(int(m.group(1)))} Komma {' '.join(_DE_ONES[int(d)] for d in m.group(2))}", text)
    return _DE_CARDINAL_RE.sub(cardinal, text)

# }}} German numbers


# {{{ English numbers
# Piper's English voices read most numbers, but not "$156", "3rd", "1,250" or "3.14" reliably, and cb-qwen3-tts
# (--text-filter tts-clean) wants the spoken form too. American style: "one hundred fifty-six", no "and".

_EN_ONES = ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve",
            "thirteen", "fourteen", "fifteen", "sixteen", "seventeen", "eighteen", "nineteen"]
_EN_TENS = ["", "", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety"]
_EN_SCALES = [(10**9, "billion"), (10**6, "million"), (1000, "thousand")]
_EN_ORDINAL_WORDS = {"one": "first", "two": "second", "three": "third", "five": "fifth", "eight": "eighth",
                     "nine": "ninth", "twelve": "twelfth"}
# Symbol: (singular, plural, cent singular, cent plural)
_EN_CURRENCIES = {"$": ("dollar", "dollars", "cent", "cents"), "£": ("pound", "pounds", "penny", "pence"),
                  "€": ("euro", "euros", "cent", "cents")}


def _en_below_1000(n: int) -> str:
    """Spell 0 < n < 1000: "one hundred fifty-six"."""
    hundreds, rest = divmod(n, 100)
    words = [f"{_EN_ONES[hundreds]} hundred"] if hundreds else []
    if rest >= 20:
        tens, ones = divmod(rest, 10)
        words.append(_EN_TENS[tens] + (f"-{_EN_ONES[ones]}" if ones else ""))
    elif rest:
        words.append(_EN_ONES[rest])
    return " ".join(words)


def en_cardinal(n: int, year: bool = False) -> str:
    """Spell an English cardinal (n < 10**12); ``year`` reads 1100-1999 and 2010-2099 in pairs ("nineteen ninety")."""
    if year and (1100 <= n <= 1999 or 2010 <= n <= 2099):
        high, low = divmod(n, 100)
        if low == 0:
            return f"{_en_below_1000(high)} hundred"
        return f"{_en_below_1000(high)} {'oh ' + _EN_ONES[low] if low < 10 else _en_below_1000(low)}"
    if n == 0:
        return "zero"
    words = []
    for scale, name in _EN_SCALES:
        count, n = divmod(n, scale)
        if count:
            words.append(f"{_en_below_1000(count)} {name}")
    if n:
        words.append(_en_below_1000(n))
    return " ".join(words)


def en_ordinal(n: int) -> str:
    """Spell an English ordinal: 3 -> "third", 21 -> "twenty-first", 40 -> "fortieth"."""
    words = en_cardinal(n)
    head, sep, last = words.rpartition("-") if "-" in words.rsplit(" ", 1)[-1] else words.rpartition(" ")
    if last in _EN_ORDINAL_WORDS:
        last = _EN_ORDINAL_WORDS[last]
    elif last.endswith("y"):
        last = last[:-1] + "ieth"
    else:
        last += "th"
    return head + sep + last


def _en_plural(words: str) -> str:
    """Pluralize the last word of a spelled number: "nineteen ninety" -> "nineteen nineties"."""
    return words[:-1] + "ies" if words.endswith("y") else words + "s"


def _en_amount(m: re.Match[str]) -> str:
    """Spell a currency amount: "$1.50" -> "one dollar fifty cents", "$2 million" -> "two million dollars"."""
    unit, units, cent, cents = _EN_CURRENCIES[m.group("sym")]
    whole, frac, scale = int(m.group("whole").replace(",", "")), m.group("frac"), m.group("scale")
    if scale:
        spoken = f"{en_cardinal(whole)}{'' if frac is None else ' point ' + ' '.join(_EN_ONES[int(d)] for d in frac)}"
        return f"{spoken} {scale} {units}"
    parts = [f"{en_cardinal(whole)} {unit if whole == 1 else units}"] if whole or not frac else []
    if frac and int(frac):
        parts.append(f"{en_cardinal(int(frac))} {cent if int(frac) == 1 else cents}")
    return " ".join(parts)


_EN_SCALE_WORDS = r"thousand|million|billion|trillion"
_EN_AMOUNT_RE = re.compile(
    rf"(?P<sym>[$£€])\s?(?P<whole>\d{{1,3}}(?:,\d{{3}})+|\d+)(?:\.(?P<frac>\d{{1,2}}))?(?!\d)"
    rf"(?:\s(?P<scale>{_EN_SCALE_WORDS})\b)?"
)
# "156 €" / "156€": the symbol after the amount (European style).
_EN_AMOUNT_AFTER_RE = re.compile(r"(?<![\w.,])(\d{1,3}(?:,\d{3})+|\d+)(?:\.(\d{2}))?\s?([$£€])")
_EN_TIME_RE = re.compile(r"\b([01]?\d|2[0-3]):([0-5]\d)\b(?:\s?([AaPp])\.?\s?[Mm]\b\.?)?")
_EN_ORDINAL_RE = re.compile(r"\b(\d{1,9})(?:st|nd|rd|th)\b")
_EN_DECADE_RE = re.compile(r"(?<![\w.,])'?(\d{1,3}0)'?s\b")
_EN_THOUSANDS_RE = re.compile(r"\b\d{1,3}(?:,\d{3})+\b(?!\.\d)")
_EN_DECIMAL_RE = re.compile(r"(?<![\w.,])(\d+)\.(\d+)\b(?!\.\d)")
_EN_PERCENT_RE = re.compile(r"(\d)\s?%")
_EN_CARDINAL_RE = re.compile(r"(?:\b(\S+)\s+)?(?<![\w.,:])(\d{1,12})(?!\w|[.,:]\d)")


def spell_numbers_en(text: str) -> str:
    """Spell out English amounts, times, ordinals, decades, decimals, percentages and cardinals."""

    def time(m: re.Match[str]) -> str:
        hour, minute, meridiem = int(m.group(1)), int(m.group(2)), m.group(3)
        spoken = en_cardinal(hour) + (
            f" {'oh ' + _EN_ONES[minute] if minute < 10 else _en_below_1000(minute)}" if minute
            else "" if meridiem else " o'clock")
        return f"{spoken} {meridiem.upper()} M" if meridiem else spoken

    def decade(m: re.Match[str]) -> str:
        n = int(m.group(1))
        # "'80s", "80s": the eighties; "1990s": the nineteen nineties
        return _en_plural(en_cardinal(n, year=True) if n >= 1000 else en_cardinal(n % 100 or n))

    def after(m: re.Match[str]) -> str:
        frac = f".{m.group(2)}" if m.group(2) else ""
        return _EN_AMOUNT_RE.sub(_en_amount, f"{m.group(3)}{m.group(1)}{frac}")

    def cardinal(m: re.Match[str]) -> str:
        before, digits = m.group(1), m.group(2)
        # Leading zeros (codes, zip codes) and model names ("RTX 4070") are not quantities.
        if (len(digits) > 1 and digits.startswith("0")) or (before and re.fullmatch(r"[A-Z][A-Z0-9-]+", before)):
            return m.group(0)
        spoken = en_cardinal(int(digits), year=True)
        return f"{before} {spoken}" if before else spoken

    text = _EN_AMOUNT_RE.sub(_en_amount, text)
    text = _EN_AMOUNT_AFTER_RE.sub(after, text)
    text = _EN_TIME_RE.sub(time, text)
    text = _EN_ORDINAL_RE.sub(lambda m: en_ordinal(int(m.group(1))), text)
    text = _EN_DECADE_RE.sub(decade, text)
    text = _EN_THOUSANDS_RE.sub(lambda m: en_cardinal(int(m.group(0).replace(",", ""))), text)
    text = _EN_PERCENT_RE.sub(r"\1 percent", text)
    text = _EN_DECIMAL_RE.sub(
        lambda m: f"{en_cardinal(int(m.group(1)))} point {' '.join(_EN_ONES[int(d)] for d in m.group(2))}", text)
    return _EN_CARDINAL_RE.sub(cardinal, text)

# }}} English numbers


def detect_language(text: str) -> str:
    """Guess the language from the words that will be read, so code blocks and URLs cannot tip it."""
    return detect_lang(to_speech_text(strip_terminal(text), Speaker("en")))


def clean(text: str, lang: str = "auto", spell_numbers: bool = True, keep_references: bool = False) -> str:
    """Run the full cleaning pipeline; ``lang`` is ``de``, ``en`` or ``auto``."""
    if lang == "auto":
        lang = detect_language(text)
    speaker = Speaker(lang)
    text = to_speech_text(strip_terminal(text), speaker, keep_references)
    text = expand_abbreviations(text, lang)
    text = reflow(text)
    if spell_numbers:
        text = spell_numbers_de(text) if lang == "de" else spell_numbers_en(text)
    text = speaker.held.restore(text)
    text = re.sub(r"\s+([,.;:!?])", r"\1", text)  # gaps left behind by removed markers
    text = re.sub(r"([.!?])\s*\.(?!\.)", r"\1", text)
    return text.strip()


def split_point(sentence: str, limit: int) -> int:
    """Index to cut an over-long sentence at: the strongest clause break within ``limit``.

    A break in the first third is skipped (it would leave the rest nearly as long), so a
    late comma beats an early semicolon. Last resort: the last space, then a hard cut.
    """
    for marks in (CLAUSE_BREAKS, (", ",), (" ",)):
        lo = limit // 3 if marks[0] != " " else 1
        best = max((i + len(m) for m in marks if (i := sentence.rfind(m, lo, limit)) > 0), default=0)
        if best:
            return best
    return limit


def chunk(text: str, limit: int, sentence_limit: int = 0) -> list[str]:
    """Split into single-line chunks of at most ``limit`` chars, breaking at sentence ends.

    The first chunk is kept short (a third of the limit) so playback starts quickly while
    the rest is still being synthesized. A sentence longer than ``sentence_limit`` (0: the
    chunk limit) is cut at clause breaks and each piece gets a line of its own: engines
    speak a line's sentence in one go, and Piper rushes and slurs beyond ~13 s of speech.
    """
    sentences = [s for para in text.split("\n\n") for s in re.split(r"(?<=[.!?\u2026])\s+", para.replace("\n", " ")) if s]
    sentence_limit = min(sentence_limit or limit, limit)
    chunks: list[str] = []
    current = ""
    for sentence in sentences:
        while len(sentence) > sentence_limit:
            cut = split_point(sentence, sentence_limit)
            sentence, rest = sentence[:cut].strip(), sentence[cut:].strip()
            if current:
                chunks.append(current)
                current = ""
            chunks.append(sentence)
            sentence = rest
        max_len = limit // 3 if not chunks else limit
        if current and len(current) + 1 + len(sentence) > max_len:
            chunks.append(current)
            current = sentence
        else:
            current = f"{current} {sentence}".strip()
    if current:
        chunks.append(current)
    return chunks


def main() -> int:
    """CLI entry point."""
    parser = argparse.ArgumentParser(description="Clean text for speech synthesis (stdin -> stdout).")
    parser.add_argument("-l", "--lang", choices=["auto", "de", "en"], default="auto",
                        help="language for abbreviation expansion (default: auto-detect)")
    parser.add_argument("-c", "--chunk", type=int, metavar="N",
                        help="output one chunk per line, each at most N chars (sentence-aligned)")
    parser.add_argument("-s", "--sentence", type=int, metavar="N", default=0,
                        help="with --chunk: split sentences longer than N chars at clause breaks "
                             "(; : – then commas), one piece per line (default: the chunk size)")
    parser.add_argument("--no-numbers", action="store_true", help="keep digits (numbers are spelled out by default)")
    parser.add_argument("--keep-references", action="store_true",
                        help='keep trailing sections such as "References", "See also", "Einzelnachweise"')
    parser.add_argument("--detect", action="store_true", help="print the detected language (de/en) and exit")
    args = parser.parse_args()

    text = sys.stdin.read()
    if args.detect:
        print(detect_language(text))
        return 0
    cleaned = clean(text, args.lang, spell_numbers=not args.no_numbers, keep_references=args.keep_references)
    if args.chunk:
        print("\n".join(chunk(cleaned, args.chunk, args.sentence)))
    else:
        print(cleaned)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
