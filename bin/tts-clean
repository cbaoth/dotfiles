#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["emoji", "markdown-it-py", "mdit-py-plugins", "phonenumbers"]
# ///
"""Clean text for speech synthesis: drop what is meant for the eye, not the ear.

Reads stdin, writes the cleaned text to stdout. Engine-independent on purpose:
TTS models cannot be relied on to skip footnote markers or URLs, so every
engine behind tts-speak gets the same pre-processed text.

Input is always parsed as markdown; plain text passes through unharmed. Removes or rewrites:
  * ANSI escapes, box-drawing and agent UI characters, markdown syntax, HTML
  * emoji and ``:shortcodes:`` (named: ``rocket emoji``, ``Rakete Emoji``)
  * code blocks (announced with their language and length), small tables (row by row; large ones announced)
  * footnotes and citation markers (``[1]``, ``[^1]``, ``[citation needed]``, superscripts), trailing
    "References" / "Einzelnachweise" / "Siehe auch" sections
  * URLs (``https://www.example.org/a?b=1`` -> ``web address example dot org``), emails, file paths (basename only),
    phone numbers, IP addresses, versions, commit hashes, identifiers, units
  * dotted abbreviations (``S.M.A.R.T.`` -> ``Smart``, ``z.B.`` -> ``zum Beispiel``)
  * hard line wraps inside a paragraph (terminal selections are full of them)
  * numbers, German and English (``$156`` -> ``one hundred fifty-six dollars``; ``--no-numbers`` keeps digits)
"""

from __future__ import annotations

import argparse
import html
import re
import sys
from dataclasses import dataclass, field
from itertools import pairwise
from urllib.parse import urlsplit

import emoji
import phonenumbers
from markdown_it import MarkdownIt
from markdown_it.token import Token
from mdit_py_plugins.footnote import footnote_plugin

# Indented code is off: in plain text, a four-space indent is a paragraph or a terminal margin, not code.
MARKDOWN = (
    MarkdownIt("commonmark", {"html": True}).enable(["table", "strikethrough"]).disable("code").use(footnote_plugin)
)

ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b\][^\x07]*\x07")
BOX_RE = re.compile(r"[─-╿▀-▟]+")
# Agent UI marks (Claude Code: tool bullets, result corners).
UI_MARKS_RE = re.compile(r"[⏺⎿⎯❯●]")
# What is left once emoji are named: unnamed decoration, stray joiners. Arrows are left to SYMBOLS.
DECOR_RE = re.compile(r"[\U0001F000-\U0001FAFF☀-➿⬀-⯿⏩-⏺\ufe0f\u200d\u20e3]")
# Listed as emoji, but used as plain symbols or bullets.
EMOJI_TEXT_SYMBOLS = frozenset("©®™‼⁉↔↕↖↗↘↙↩↪▪▫▶◀◻◼◽◾Ⓜ")
# :rocket:, not 12:30:45, [:a:] or a::b.
EMOJI_SHORTCODE_RE = re.compile(r"(?<![\w:/.\[]):[a-z0-9_+-]+:(?![\w/\]])")
SKIN_TONE_RE = re.compile(r"[\U0001F3FB-\U0001F3FF]")
EMOJI_NAME_JUNK_RE = re.compile(r"(?:_|[^\w'’-])+")
# Control characters, and the code points held spoken forms are parked on (see Held).
INPUT_JUNK_RE = re.compile(r"[\x00-\x08\x0b\x0c\x0e-\x1f\U000F0000-\U0010FFFD]")
# "(see )" is what is left of "(see [1])" once the marker is gone
EMPTY_PARENS_RE = re.compile(
    r"\(\s*(?:(?:see|siehe|vgl\.?|cf\.?|source|quelle)\s*:?\s*)?\)|\[\s*\]|<\s*>", re.IGNORECASE
)
# [1] [12] [a] [^1] [1,2] [1-3] [note 4] [citation needed] [edit] [Bearbeiten | Quelltext bearbeiten] [update]
FOOTNOTE_RE = re.compile(
    r"\[(?:\d{1,3}(?:\s*[,–-]\s*\d{1,3})*|[a-z]|\^[\w-]+|(?:note|nb|fn)\s*\d+"
    r"|citation needed|edit|bearbeiten(?:\s*\|\s*quelltext bearbeiten)?|quelltext bearbeiten"
    r"|update[sd]?|clarification needed|when\?|who\?|according to whom\?)\]",
    re.IGNORECASE,
)
# A marker has no base right before it; "x^2" and "mc²" are powers (POWER_RE).
CARET_RE = re.compile(r"(?<!\w)\^\d{1,3}\b")
SUPERSCRIPT_RE = re.compile(r"[¹²³⁰-⁹]+")
POWER_RE = re.compile(r"(?<![\w^])(\w{1,3})(?:\^(\d{1,3})\b|([¹²³⁰-⁹]+))")
SUPERSCRIPT_DIGITS = str.maketrans("⁰¹²³⁴⁵⁶⁷⁸⁹", "0123456789")
# "this.12 Then": a footnote that lost its superscript when copied. The four letters keep "Nr.12" and "Abb.3" out.
BARE_FOOTNOTE_RE = re.compile(r"(?<=[a-zäöüß]{4}[.!?\"”)])\d{1,3}(?=\s+[A-ZÄÖÜ\"„“]|\s*$)", re.MULTILINE)
# S.M.A.R.T.  U.S.A.  (two or more single letters, each followed by a dot)
DOTTED_ACRONYM_RE = re.compile(r"\b(?:[A-Za-z]\.){2,}(?=\W|$)")
# Bullets markdown does not know, e.g. from a rendered web page.
BULLET_RE = re.compile(r"^\s*[•‣◦▪]\s+", re.MULTILINE)
TABLE_RULE_RE = re.compile(r"^\s*\|?[\s:|-]{3,}\|?\s*$", re.MULTILINE)

_URL_CHARS = r"(?:[^\s<>\"'`()\[\]]|\([^\s()]*\))+"
URL_RE = re.compile(rf"\b[A-Za-z][A-Za-z0-9+.-]{{1,15}}://{_URL_CHARS}|\bwww\.{_URL_CHARS}")
SCP_RE = re.compile(r"(?<![\w.-])[\w.-]+@([\w-]+(?:\.[\w-]+)+):[\w./~-]+")
EMAIL_RE = re.compile(r"(?<![\w.+-])(?:mailto:)?([\w.+-]+@[\w-]+(?:\.[\w-]+)+)\b")
# Scheme-less domains only for these: README.md, file.py, tool.sh and node.js all end in real TLDs.
_BARE_TLDS = "com|org|net|de|at|ch|eu|io|dev|app|ai|edu|gov|info|uk"
BARE_DOMAIN_RE = re.compile(
    rf"(?<![\w@./-])((?:[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?\.)+(?:{_BARE_TLDS}))(?![\w(-]|\.\w)(?:/{_URL_CHARS})?"
)
IP_RE = re.compile(r"(?<![\w.])((?:25[0-5]|2[0-4]\d|1?\d?\d)(?:\.(?:25[0-5]|2[0-4]\d|1?\d?\d)){3})(?::\d+)?(?!\w|\.\w)")
UUID_RE = re.compile(r"\b[0-9a-fA-F]{8}-(?:[0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}\b")
_PATH_CHARS = r"[\w.+@%=,-]"
WINDOWS_PATH_RE = re.compile(r"(?<![\w\\])(?:[A-Za-z]:\\|\\\\)[^\s\"'<>|:*?]+")
# Anchored: "~/x", "./x", "../x", or "/a/b". Unanchored "and/or", "km/h", "A/B" never match.
UNIX_PATH_RE = re.compile(
    rf"(?<![\w/.:~\\-])(?:(?:~|\.{{1,2}})/(?:{_PATH_CHARS}+/?)+|/{_PATH_CHARS}+(?:/{_PATH_CHARS}+)+/?)"
    r"(?::(\d+))?(?::\d+)?"
)
RELATIVE_PATH_RE = re.compile(r"(?<![\w/.:~-])(?:[\w.-]+/)+[\w.-]+(?::(\d+))?(?::\d+)?")
PATH_EXTENSION_RE = re.compile(r"[^.]\.[a-z][a-z0-9]{1,4}$")
BARE_RELATIVE_PATH_RE = re.compile(r"[\w.+-]+(?:/[\w.+-]+)+/?")
VERSION_RE = re.compile(r"(?<![\w.])(v?)(\d+(?:\.\d+)+)(?:[-+][\w.]*\w)?(?!\w|\.\w)")
# Two-part numbers are versions only after a product name; "Price 3.50" is a decimal.
PRODUCT_VERSION_RE = re.compile(
    r"\b(Python|Node|Ubuntu|Debian|Fedora|Linux|Kernel|Java|PHP|Ruby|Rust|Perl|Lua|Firefox|Chrome|Vivaldi|Sway"
    r"|Claude|Opus|Sonnet|Haiku|GPT|Gemini|Llama|Qwen)(\s+)(\d+\.\d+)(?!\w|\.\w)"
)
HASH_RE = re.compile(r"\b(?=[0-9a-f]*[a-f])(?=[0-9a-f]*\d)[0-9a-f]{7,40}\b")
POSTCODE_RE = re.compile(r"(?<=, )\d{5}(?=\s+[A-ZÄÖÜ][a-zäöüß-]+)|^\d{5}(?=\s+[A-ZÄÖÜ][a-zäöüß-]+\s*$)", re.MULTILINE)
IDENTIFIER_RE = re.compile(r"(?<![\w/.-])[A-Za-z][A-Za-z0-9]*(?:_[A-Za-z0-9]+)+(?![\w/-])")
CAMEL_RE = re.compile(r"(?<=[a-z0-9])(?=[A-Z])")
CLI_FLAG_RE = re.compile(r"(?<!\S)--?(?=[A-Za-z])")
NAME_SEPARATOR_RE = re.compile(r"[_-]+")
# Inline code longer than this is a command or snippet, not a word in a sentence.
MAX_SPOKEN_CODE = 60
# Above either limit a table is announced instead of read row by row.
MAX_TABLE_ROWS, MAX_TABLE_COLUMNS = 6, 4

# Marks the start of a list item between render_blocks() and reflow().
ITEM_MARK = "\x01"
# Marks a named emoji until scrub() sees the whole line (a leading one acts as a bullet); the slot is one not yet named.
EMOJI_MARK, EMOJI_SLOT = "\x02", "\x03"
EMOJI_RUN_RE = re.compile(rf"(\w?)({EMOJI_SLOT}(?:[ \t]*{EMOJI_SLOT})*)(\w?)")
LINE_EMOJI_RE = re.compile(rf"^[ \t]*{EMOJI_MARK}(.)[ \t]*(?=\S)", re.MULTILINE)
HELD_RE = re.compile(r"[\U000F0000-\U0010FFFD]")
# A line at least this fraction of the widest line is taken as hard-wrapped, not as a heading/item.
WRAP_RATIO = 0.6
SENTENCE_END = tuple(".!?:;…。\"')]”»")
# Where an over-long sentence may be split, before falling back to commas.
CLAUSE_BREAKS = ("; ", ": ", " – ", " — ", " - ")

# Spoken forms. Matched case-sensitively, with optional space after inner dots.
ABBREVIATIONS = {
    "de": {
        r"z\.\s?B\.": "zum Beispiel",
        r"d\.\s?h\.": "das heißt",
        r"u\.\s?a\.": "unter anderem",
