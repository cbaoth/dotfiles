# Schemes whose name is spelled out; any other is read as written.
SPELLED_SCHEMES = {"ftp", "ftps", "sftp", "scp", "ssh", "nfs", "smb", "rtsp", "rtmp", "imap", "imaps", "tcp", "udp"}
