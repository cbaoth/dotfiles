#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; indent-tabs-mode: nil; tab-width: 2 -*-
# vim: ft=bash:et:ts=2:sts=2:sw=2
# code: language=bash insertSpaces=true tabSize=2
# shellcheck shell=bash
#
# Monitor input or Wayland clipboard data and execute a command.

# set options
set -o errtrace
#set -o errexit
set -o pipefail
set -o nounset
(( ${DEBUG_LVL:-0} >= 2 )) && set -o xtrace
IFS=$'\t\n\0'

# traps
# shellcheck disable=SC2154
trap 'rc=$?; \
      printf "ERROR(%s) in %s:%s\n  -> %s\n  -> %s\n" "${rc}" \
             "${0:-N/A}" "${LINENO:-N/A}" "${FUNCNAME[@]:-N/A}" \
             "${BASH_COMMAND:-N/A}"; \
      exit $rc' ERR
trap 'printf "\nINTERRUPT\n"; exit 1' SIGINT SIGTERM

# Logging
#p_msg() { printf '%s\n' "$*"; }
#p_nfo() { printf '\033[32mINFO\033[0m %s\n' "$*"; }
p_war() { printf '\033[33mWARNING\033[0m %s\n' "$*" >&2; }
p_err() { printf '\033[31mERROR\033[0m: %s\n' "$*" >&2; }
#p_dbg() { (( "${1:-0}" <= "${DEBUG_LVL:-0}" )) && printf '\033[36mDEBUG\033[0m: %s\n' "${*:2}" >&2 || true; }

# Usage
p_usg() { printf 'Usage: %s  [OPTION]... COMMAND...\n' "$(basename "$0")"; }
p_hlp() {
  p_usg
  cat <<'EOF'

Reads text input from command line or the Wayland clipboard [--clipboard],
passing the text as argument to the given COMMAND.

General:
  -b, --background      Execute command as job, else: execute in sequence.
  -d, --delimiter       Input delimiter (default: newline $'\n').

Clipboard:
  -c, --clipboard       Monitor the Wayland clipboard (wl-paste) instead of
                        reading terminal input, or the Windows clipboard in WSL.
  -x, --xclip           Deprecated alias for --clipboard.
  --pollrate X          Clipboard mode poll-rate in seconds (default: 0.2s).

Filter Input:
  -m, --match RE        Each item (input separated by --delimiter) must match
                        the given regex, else: ignore the item.
  --match-whole         Match the complete input instead (e.g. the whole
                        clipboard text); if it matches, all items are used.
  --allow-duplicates    Allow repeated input (default: ignore). Affects sequen-
                        tial repetitions only, duplicates are never tracked
                        globally. Has no effect on --clipboard mode (see below).

Terminal Input History (privacy: kept in memory only, unless asked):
  -H, --history[=FILE]  Persist the input history and reuse it in later runs,
                        in FILE or by default in
                        ~/.local/state/while-read/COMMAND.history (mode 0600).
                        Without this option the history lives in memory only
                        and is gone when while-read exits. Note: the optional
                        FILE needs the = form (--history=FILE), else it would
                        be taken for the COMMAND.

Verbosity:
  -v, --verbose         Verbose output, print full command before execution.
  -xn, --xnotify        Use notify-send (if available) to show each processed
                        item as a desktop notification.

Terminal Input Mode (default):
  Reads terminal text input line-by-line. Each time a newline is entered,
  COMMAND is executed using the given text as final argument.

  On a terminal (and with the default delimiter) the line is read via
  readline: prompt, inline editing, up/down history and ctrl-r search work
  like in the shell. Piped input is read as is, without prompt or history.

  If a different delimiter is used, the line may be split up into individual
  items (e.g. separated by space), each item executing the COMMAND.

  Each {} within the COMMAND will be substituted with the given line/item,
  shell-escaped. COMMAND is re-parsed by bash, so quotes that survive your
  shell break this escaping: '{}' is fine (your shell removes the quotes, like
  with find), but "<<<'{}'" or "echo '{}'" passes literal quotes; use "<<<{}".
  If no {} exists the line/item will be appended to the COMMAND (final arg).

Clipboard Mode [-c]:
  Reads the Wayland clipboard content (wl-paste, package wl-clipboard) in
  regular intervals (default: 0.2 sec intervals, see --pollrate). Each
  clipboard content change, within the given interval, is read as input.
  Empty and non-text clipboard content is ignored.

  Since the clipboard can contain multi-line text, using the default
  delimiter \n will result in multiple COMMAND executions per input (one
  per line in clipboard text). The delimiter can be changed but be aware that
  multi-line COMMAND arguments may be problematic.

  Note that the --allow-duplicates option is ignored in clipboard mode, since only
  clipboard changes are registered as new input.

Background [-b] option and limitations:
  By default commands are executed in sequence (single threaded) meaning that
  the input is not monitored while a command is still being executed. In case
  of terminal input mode this might work to some degree (until the input buffer
  is exhausted) but it can result in data loss (input not read).

  As a result it is usually sensible to use [-b], especially in clipboard mode
  in combination with long running commands (longer than clipboard change
  intervals).

  Note that in the current implementation no execution queue exists, meaning
  that a combination of long running commands and high input frequency can
  again result in issues (high load / too many jobs).

Examples:
  # read URLs from input, append matches to file 'links' and download
  while-read -b -m '^https?://' echo {} \>\> links \; wget -nv -c {}
  # same but using tee
  while-read -b -m '^https?://' tee -a links "<<<{}" \| wget -nv -c -i -

  # monitor the clipboard for URLs and open matches in new firefox tabs
  while-read -c -b -m '^\w+://' firefox --new-tab
EOF
}

# arguments
declare bg=false
declare clipboard=false
declare verbose=false
declare allow_dupes=false
declare match_whole=false
declare xnotify=false
declare delimiter=$'\n'
declare history=false
declare history_file=""
declare regex=""
declare pollrate=.2
declare -a cmd_arg=()

# Are we in a Windows Subsystem for Linux?
IS_WSL=false
if [[ $(uname -r) = *icrosoft* ]]; then  # WSL1: Microsoft, WSL2: microsoft
  IS_WSL=true
fi

# parse arguments
parse_args() {
  if [[ -z "${1:-}" ]]; then
    p_usg >&2
    exit 1
  fi
  while [[ -n "${1:-}" ]]; do
    case "$1" in
      -c|--clipboard|-x|--xclip)
        clipboard=true
        shift
        ;;
      -m|--match)
        if [[ -z "${2:-}" ]]; then
          p_err "missing regex value for option [$1]"
          exit 1
        fi
        regex="$2"
        shift 2
        ;;
      --match-whole)
        match_whole=true
        shift
        ;;
      --match-separate) # deprecated, per item matching is the default
        match_whole=false
        shift
        ;;
      -d|--delimiter)
        if [[ -z "${2:-}" ]]; then
          p_err "missing delimiter value for option [$1]"
          exit 1
        fi
        delimiter="$2"
        shift 2
        ;;
      -H|--history)
        history=true
        shift
        ;;
      --history=*)
        history=true
        history_file="${1#--history=}"
        history_file="${history_file/#\~\//${HOME}/}"
        shift
        ;;
      --allow-duplicates)
        allow_dupes=true
        shift
        ;;
      -b|--background)
        bg=true
        shift
        ;;
      -v|--verbose)
        verbose=true
        shift
        ;;
      -xn|--xnotify)
        if command -v notify-send > /dev/null 2>&1; then
          xnotify=true
        else
          p_war "argument $1 ignored, notify-send command not found"
        fi
        shift
        ;;
      --pollrate)
        if [[ -z "${2:-}" ]]; then
          p_err "missing decimal value for option [$1]"
          exit 1
        fi
        if [[ ! "$2" =~ ^([0-9]+\.?[0-9]*|\.[0-9]+)(s|m|h|d)?$ ]]; then
          p_err "invalid value [$2] for option [$1]"
          p_err "only numeric values with suffix s (default), m, h, and d are allowed"
          exit 1
        fi
        pollrate="$2"
        shift 2
        ;;
      -h|--help)
        p_hlp
        exit 0
        ;;
      -*)
        p_err "unknown option [$1]"
        exit 1
        ;;
      *)
        break
        ;;
    esac
  done

  if [[ -z "${1:-}" ]]; then
    p_err "missing command"
    exit 1
  fi
  cmd_arg+=("$@")

  if ${history} && [[ -z "${history_file}" ]]; then
    history_file="${XDG_STATE_HOME:-${HOME}/.local/state}/while-read/${1##*/}.history"
  fi

  if ${allow_dupes} && ${clipboard}; then
    p_war "Ignoring --allow-duplicates option in --clipboard mode."
    allow_dupes=false
  fi

  if ${clipboard} && ! ${IS_WSL}; then
    if ! command -v wl-paste > /dev/null 2>&1; then
      p_err "wl-paste not found (install: sudo apt install wl-clipboard)"
      exit 1
    fi
    if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
      p_err "WAYLAND_DISPLAY not set, --clipboard needs a Wayland session"
      exit 1
    fi
  fi
}

# Terminal input via readline (prompt, editing, history)? Only for a terminal
# and the default delimiter, since readline always ends a line at newline.
use_readline() {
  ! ${clipboard} && [[ -t 0 && "${delimiter}" == $'\n' ]]
}

# Set up readline history: in memory only, or additionally loaded from / saved
# to the history file (--history). The file is created private (0600).
history_init() {
  set -o history  # off in non-interactive shells, but read -e needs it
  HISTSIZE=1000
  ${history} || return 0
  HISTFILE="${history_file}"
  HISTFILESIZE=1000
  if [[ ! -e "${HISTFILE}" ]]; then
    (umask 077; mkdir -p -- "${HISTFILE%/*}" && : > "${HISTFILE}") \
      || { p_war "cannot create history file [${HISTFILE}], history not persisted"; history=false; return 0; }
  fi
  history -r
}

# Remember a line in the history (not empty, not a repeat of the last line).
history_add() {
  [[ -z "$1" || "$1" == "${history_last:-}" ]] && return 0
  history_last="$1"
  history -s -- "$1"
  # append only the new line instead of rewriting the file (parallel sessions)
  ${history} && history -a
  return 0
}

# start reading / monitoring
read_loop() {
  local input      # current input (clipboard content / read line)
  local input_prev # input from previous iteration
  local item       # input or part of input (separated via delimiter)
  local first=true # is first iteration?
  local readline=false
  local history_last=""
  if use_readline; then
    readline=true
    history_init
  fi

  # keep reading input
  while true; do
    # clipboard or read lines?
    if ${clipboard}; then
      # poll rate sleep, must come first due to continues below
      if ! $first; then
        sleep "${pollrate}"  # poll rate
      fi
      if ${IS_WSL}; then
        input="$(powershell.exe Get-Clipboard)"
      else
        # empty or non-text clipboard: wl-paste exits 1, treat as no input
        input="$(wl-paste --no-newline --type text 2> /dev/null)" || input=""
      fi
    else
      # EOF (ctrl-d): stop, but still process a final line without newline
      if ${readline}; then
        IFS='' read -e -r -p '> ' input || [[ -n "${input}" ]] || break
        history_add "${input}"
      else
        IFS='' read -r -d $'\n' input || [[ -n "${input}" ]] || break
      fi
    fi
    first=false

    # new input identical to previous / clipboard unchanged? -> skip input
    if ! ${allow_dupes} && [[ "${input}" == "${input_prev:-}" ]]; then
      continue
    fi
    # remember every input (also skipped ones below), so re-copying an earlier
    # clipboard text after something else counts as a change
    input_prev="${input}"

    # no input? -> skip
    [[ -z "${input}" ]] && continue
    # whole input match mode and regex doesn't match? -> skip input
    if ${match_whole} && [[ ! "${input}" =~ ${regex} ]]; then
      continue
    fi

    # process lines/delimiter input, each element at a time (including last)
    while IFS='' read -r -d "${delimiter}" item || [[ -n "${item}" ]]; do
      if ! ${match_whole} && [[ ! "${item}" =~ ${regex} ]]; then
        continue
      fi
      local -a cmd

      # substitute {}?
      if [[ "$*" =~ \{\} ]]; then # contains {}? substitute
        # in the command substitute all {} with the given item
        # https://stackoverflow.com/a/29613573 escape specials
        cmd="$(perl -s -0777 -pe 's/\{\}/\Q$item\E/g' -- -item="${item}" <<<"$@")"
      else # no {}? append argument
        cmd=("$@")
        cmd+=("$(printf '%q' "${item}")")
      fi

      # run in background (job)?
      if ${bg}; then
        # TODO implement a simple queue to limit number of concurrent jobs
        ${verbose} && echo "${cmd[*]} &"
        ${xnotify} && notify-send -u low 'while-read' "${item}"
        bash <<<"${cmd[@]}" &
      else
        ${verbose} && echo "${cmd[*]}"
        ${xnotify} && notify-send -u low 'while-read' "${item}"
        bash <<<"${cmd[@]}"
      fi
    done < <(printf '%s' "${input}")  # <<< would append a newline to the last item

    item=""
  done
}

main() {
  parse_args "$@"
  read_loop "${cmd_arg[@]}"
}

main "$@"
