#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; indent-tabs-mode: nil; tab-width: 2 -*-
# vim: ft=bash:et:ts=2:sts=2:sw=2
# code: language=bash insertSpaces=true tabSize=2
# shellcheck shell=bash
#
# Toggle mute of the default PipeWire input (microphone) and show a swayosd
# message. `swayosd-client --input-volume mute-toggle` (swayosd 0.3.0) did not
# change the state of a bluetooth headset mic here, wpctl does.
# Used by the Fn+F9 Solaar rule (home/.config/solaar/rules.yaml).

set -euo pipefail

declare -r SOURCE='@DEFAULT_AUDIO_SOURCE@'

main() {
  wpctl set-mute "${SOURCE}" toggle

  local icon msg
  if [[ "$(wpctl get-volume "${SOURCE}")" == *MUTED* ]]; then
    icon="microphone-sensitivity-muted-symbolic"
    msg="Microphone muted"
  else
    icon="microphone-sensitivity-high-symbolic"
    msg="Microphone on"
  fi
  # The OSD is feedback only; a missing swayosd-server must not fail the toggle.
  swayosd-client --custom-icon "${icon}" --custom-message "${msg}" || true
}

main "$@"
