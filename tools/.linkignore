# Files/directories inside home/ to skip when linking with link.sh.
# One pattern per line, using sed regular expressions.
# Most repo-level files (README, docs, bin, tools, etc.) are already excluded
# by being outside the home/ subdirectory — only add entries here for
# things inside home/ that should NOT be symlinked to $HOME.

# Template for the untracked, per-machine ~/.gitconfig.local — reference only.
\.gitconfig\.local\.example$

# In-tree documentation (e.g. .zsh.d/completions/README.md) is reference only;
# never mirror it into $HOME.
README\.md
