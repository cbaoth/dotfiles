{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 8,
  "control-center-margin-left": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "timeout": 8,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "relative-timestamps": true,
  "control-center-width": 480,
  "control-center-height": 600,
  "notification-window-width": 420,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 150,
  "hide-on-clear": true,
  "hide-on-action": true,
  "text-empty": "No Notifications",
  "script-fail-notify": true,
  "notification-visibility": {
    "bluetooth-status-transient": {
      "app-name": "^[Bb]lueman",
      "state": "transient",
      "override-urgency": "low"
    },
    "own-status-tools-transient": {
      "app-name": "^(sway-awake|sway-kill|sway-winfo|bt-audio-reset|grimshot)$",
      "state": "transient"
    }
  },
  "scripts": {
    "waybar-urgency-low": {
      "urgency": "Low",
      "exec": "swaync-waybar record"
    },
    "waybar-urgency-normal": {
      "urgency": "Normal",
      "exec": "swaync-waybar record"
    },
    "waybar-urgency-critical": {
      "urgency": "Critical",
      "exec": "swaync-waybar record; pw-play /usr/share/sounds/freedesktop/stereo/dialog-warning.oga"
    },
    "click-focus-low": {
      "urgency": "Low",
      "run-on": "action",
      "exec": "swaync-focus-urgent"
    },
    "click-focus-normal": {
      "urgency": "Normal",
      "run-on": "action",
      "exec": "swaync-focus-urgent"
    },
    "click-focus-critical": {
      "urgency": "Critical",
      "run-on": "action",
      "exec": "swaync-focus-urgent"
    }
  },
  "widgets": [
    "title",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "notifications": {
      "vexpand": true
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    }
  }
}
