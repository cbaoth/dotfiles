#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; indent-tabs-mode: nil; tab-width: 2 -*-
# vim: ft=bash:et:ts=2:sts=2:sw=2
# code: language=bash insertSpaces=true tabSize=2
# shellcheck shell=bash
#
# Claude Code PreToolUse hook: ask before Bash/Glob/Grep touch mounted storage or crawl from /.
#
# Best effort, by design: the command string is split on whitespace and shell
# punctuation, not parsed, so variables, `cd` and symlinks get past it. It
# guards against an over-eager agent, not an adversary. Read/Edit are covered
# by the native `Read(//srv/**)`-style ask rules in settings.json instead.
#
# Input: hook JSON on stdin. Output: an "ask" decision with a reason, or
# nothing (no opinion; the normal permission rules decide). Never blocks: any
# internal failure exits 0 without output.
#
# Config (one path per line, `#` comments; `!path` = exception):
#   ~/.claude/mount-guard.conf            guarded roots + global exceptions
#   <project>/.claude/mount-guard.local   extra per-project lines (optional)

# No `set -e`: a hook that dies on an edge case must fail open (exit 0, no
# output), never break every Bash call in every session.
set -uo pipefail

declare -r GLOBAL_CONF="${HOME}/.claude/mount-guard.conf"
# Crawling one of these crosses every mount below it; `~` and `$HOME` are the
# literal words an agent types, so they stay unexpanded
# shellcheck disable=SC2088
declare -ra CRAWL_ROOTS=("/" "/*" "~" "~/" "\$HOME" "\${HOME}" "/home" "/home/" "${HOME}" "${HOME}/")
# Tools that recurse by default, or always reach mounted data (locate db)
declare -ra RECURSIVE_TOOLS=(find du tree fd fdfind rg ag ncdu)
declare -ra INDEX_TOOLS=(locate plocate mlocate)
# Tools that recurse only with -R/--recursive (grep family: also -r; for ls -r
# means reverse)
declare -ra FLAG_TOOLS=(grep egrep fgrep ls chmod chown chgrp cp)
declare -ra LOWER_R_TOOLS=(grep egrep fgrep cp)

declare -a GUARDED=()
declare -a EXCEPTIONS=()

load_conf() {
  local file line
  for file in "$@"; do
    [[ -r "${file}" ]] || continue
    while IFS= read -r line || [[ -n "${line}" ]]; do
      line="${line%%#*}"
      line="${line//[[:space:]]/}"
      [[ -z "${line}" ]] && continue
      if [[ "${line}" == '!'* ]]; then
        EXCEPTIONS+=("${line#!}")
      else
        GUARDED+=("${line%/}")
      fi
    done < "${file}"
  done
  # Fallback if the config is missing (fresh host, link not run yet)
  (( ${#GUARDED[@]} )) || GUARDED=(/srv /media /mnt /run/media)
  is_proot && drop_empty_roots
}

# Android kernel + distro rootfs = PRoot (DroidDeck, proot-distro); same test
# as IS_PROOT in home/.common_env, whose export saves the fork. Android denies
# /proc/sys/kernel/osrelease and PRoot fakes /proc/version, so uname it is.
is_proot() {
  case "${IS_PROOT:-}" in
    true) return 0 ;;
    false) return 1 ;;
  esac
  [[ "$(uname -r 2>/dev/null)" == *android* && -f /etc/os-release ]]
}

# PRoot only: a guarded root that is absent or empty holds nothing, and a
# PRoot cannot mount anything there later (no autofs). Not done elsewhere: an
# autofs root looks empty until it is accessed. Hidden-only entries count as
# empty (/media holds KDE's .directory/.hidden links in DroidDeck).
drop_empty_roots() {
  local root
  local -a kept=() entries=()
  for root in "${GUARDED[@]}"; do
    [[ -d "${root}" ]] || continue
    entries=("${root}"/*)
    [[ -e "${entries[0]}" || -L "${entries[0]}" ]] && kept+=("${root}")
  done
  GUARDED=("${kept[@]}")
}

# 0 if $1 is at or below $2
is_under() {
  [[ "$1" == "$2" || "$1" == "$2"/* ]]
}

# Prints the guarded root $1 is at or below; 1 if none or excepted
guarded_root() {
  local path="${1%/}" root exc
  [[ -z "${path}" ]] && return 1
  for exc in "${EXCEPTIONS[@]}"; do
    is_under "${path}" "${exc%/}" && return 1
  done
  for root in "${GUARDED[@]}"; do
    if is_under "${path}" "${root}"; then
      printf '%s' "${root}"
      return 0
    fi
  done
  return 1
}

in_list() {
  local needle="$1" item
  shift
  for item in "$@"; do
    [[ "${needle}" == "${item}" ]] && return 0
  done
  return 1
}

ask() {
  jq -nc --arg reason "mount-guard: $1" '{hookSpecificOutput: {
    hookEventName: "PreToolUse", permissionDecision: "ask", permissionDecisionReason: $reason}}'
  exit 0
}

# Is $1 a crawl root, literally or after expansion of ~ / $HOME?
is_crawl_root() {
  in_list "$1" "${CRAWL_ROOTS[@]}" || in_list "${1%/}" "${CRAWL_ROOTS[@]}"
}

# Word -> absolute path against DIR (best effort; ~ and $HOME expanded).
abs_path() {
  local -r w="$1" dir="$2"
  case "${w}" in
    /*) printf '%s' "${w}" ;;
    '~'|'~/'*) printf '%s' "${HOME}${w#\~}" ;;
    '$HOME'*) printf '%s' "${HOME}${w#\$HOME}" ;;
    '${HOME}'*) printf '%s' "${HOME}${w#\$\{HOME\}}" ;;
    *) printf '%s' "${dir%/}/${w}" ;;
  esac
}

# Name of the recursive tool in WORDS, or nothing.
recursive_tool() {
  local w base flag_r="" flag_upper_r="" found=""
  for w in "$@"; do
    base="${w##*/}"
    in_list "${base}" "${RECURSIVE_TOOLS[@]}" && found="${base}"
    [[ "${w}" =~ ^-[a-zA-Z]*R || "${w}" == "--recursive" ]] && flag_upper_r=1
    [[ "${w}" =~ ^-[a-zA-Z]*r ]] && flag_r=1
  done
  if [[ -z "${found}" && -n "${flag_r}${flag_upper_r}" ]]; then
    for w in "$@"; do
      base="${w##*/}"
      if [[ -n "${flag_upper_r}" ]] && in_list "${base}" "${FLAG_TOOLS[@]}" \
        || in_list "${base}" "${LOWER_R_TOOLS[@]}"; then
        found="${base} -R"
      fi
    done
  fi
  printf '%s' "${found}"
}

# The command is split into segments at ; && || | & and newlines, and the
# crawl-root test applies per segment: `cd ~ && find dotfiles` names ~ only in
# the `cd`, and the find runs in ~/dotfiles. A `cd` is followed, so
# `cd ~ && find .` (or a find with no existing path operand) still asks.
check_bash() {
  local -r cmd="$1" start_dir="$2"
  local -a words=() segments=()
  local w base sanitized seg recursive root dir="${start_dir}" target operand_ok

  # Guarded roots: any absolute word anywhere in the command.
  sanitized="${cmd//[;|&()<>\"\'\`=]/ }"
  read -ra words <<< "${sanitized//$'\n'/ }"
  for w in "${words[@]}"; do
    base="${w##*/}"
    if in_list "${base}" "${INDEX_TOOLS[@]}"; then
      ask "${base} searches an index that includes mounted storage"
    fi
    case "${w}" in
      /*|'~'|'~/'*|'$HOME'*|'${HOME}'*) ;;
      *) continue ;;
    esac
    target="$(abs_path "${w}" /)"
    if root="$(guarded_root "${target}")"; then
      ask "touches mounted storage under ${root}: ${w}"
    fi
    # Through a symlink (~/Downloads -> Android storage); one fork per
    # existing path only.
    [[ -e "${target}" ]] || continue
    target="$(readlink -f -- "${target}" 2>/dev/null)" || continue
    if root="$(guarded_root "${target}")"; then
      ask "touches mounted storage under ${root}: ${w} (-> ${target})"
    fi
  done

  # Crawl roots: per segment.
  sanitized="${cmd//$'\n'/;}"
  sanitized="${sanitized//&&/;}"
  sanitized="${sanitized//||/;}"
  sanitized="${sanitized//[|&]/;}"
  IFS=';' read -ra segments <<< "${sanitized}"
  for seg in "${segments[@]}"; do
    seg="${seg//[()<>\"\'\`=]/ }"
    read -ra words <<< "${seg}"
    (( ${#words[@]} )) || continue
    if [[ "${words[0]}" == "cd" ]]; then
      dir="$(abs_path "${words[1]:-~}" "${dir:-/}")"
      continue
    fi
    recursive="$(recursive_tool "${words[@]}")"
    [[ -n "${recursive}" ]] || continue
    operand_ok=""
    for w in "${words[@]:1}"; do
      if is_crawl_root "${w}"; then
        ask "${recursive} on '${w}' crosses every mount below it (NFS/NTFS, many TB)"
      fi
      [[ "${w}" == -* ]] && continue
      [[ "${w}" == "." || "${w}" == "./" ]] && { operand_ok=""; break; }
      target="$(abs_path "${w}" "${dir:-/}")"
      [[ -e "${target}" ]] && ! is_crawl_root "${target}" && operand_ok=1
    done
    # No usable path operand: the tool crawls its working directory.
    if [[ -z "${operand_ok}" ]] && [[ -n "${dir}" ]] && is_crawl_root "${dir}"; then
      ask "${recursive} in '${dir}' crosses every mount below it (NFS/NTFS, many TB)"
    fi
  done
}

check_search() {
  local -r tool="$1" path="$2" cwd="$4"
  local pattern="$3"
  local target="${path:-${cwd}}" root
  if in_list "${target}" "${CRAWL_ROOTS[@]}"; then
    ask "${tool} on '${target}' crosses every mount below it (NFS/NTFS, many TB)"
  fi
  # A Grep pattern is a regex, not a path; only Glob patterns can be absolute
  [[ "${tool}" == "Grep" ]] && pattern=""
  for target in "${target}" "${pattern}"; do
    [[ "${target}" == /* ]] || continue
    if root="$(guarded_root "${target}")"; then
      ask "${tool} in mounted storage under ${root}: ${target}"
    fi
  done
}

main() {
  command -v jq > /dev/null 2>&1 || exit 0
  local input tool cwd
  input="$(cat)" || exit 0
  tool="$(jq -r '.tool_name // empty' <<< "${input}" 2> /dev/null)" || exit 0
  cwd="$(jq -r '.cwd // empty' <<< "${input}" 2> /dev/null)"
  load_conf "${GLOBAL_CONF}" "${cwd:+${cwd}/.claude/mount-guard.local}"

  case "${tool}" in
    Bash)
      check_bash "$(jq -r '.tool_input.command // empty' <<< "${input}")" "${cwd}"
      ;;
    Glob|Grep)
      check_search "${tool}" \
        "$(jq -r '.tool_input.path // empty' <<< "${input}")" \
        "$(jq -r '.tool_input.pattern // empty' <<< "${input}")" \
        "${cwd}"
      ;;
  esac
  exit 0
}

main "$@"
