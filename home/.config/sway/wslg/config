# ~/.config/sway/wslg/config: minimal sway nested in WSLg (Windows), see bin/sway-wslg
#
# Standalone on purpose: the desktop config (../config, config.d/) needs
# waybar, swaync, wallpapers and many bin/ helpers that WSL does not have.
# Bindings follow config.d/40-keybindings.conf where only built-in commands
# are involved. Notes and open points: docs/setup/sway-wslg.md
#
# Packages (apt): sway foot wl-clipboard xwayland

# {{{ = Variables ============================================================
# No $mod: nested wlroots takes the modifier state from WSLg, which only
# knows Shift/Ctrl/Alt (Windows keeps Super). The ISO key (Hyper_L) does
# arrive as a key, so holding it enters the "wm" mode below instead.
set $left  q
set $right w
set $up    f
set $down  p
set $term  foot
set $mode_wm     wm
set $mode_meta   Meta | [c] close · [q/w/f/p, arrows] resize (Shift: fine) · [Esc] exit
set $mode_system System | [c] reload · [Shift+x] exit sway · [Esc] back
# }}} = Variables ============================================================

# {{{ = Output / Input =======================================================
# The single output is the Windows window. Its size is the output mode:
# sway-wslg -s WxH, or at runtime: swaymsg -- output WL-1 mode --custom WxH
output WL-1 mode --custom 1920x1080
output * bg #000000 solid_color

# Same layouts as the desktop (config.d/10-output-input.conf). WSLg forwards
# scancodes, so the Windows layout does not matter here.
input "type:keyboard" {
    xkb_layout  "custom,custom,custom"
    xkb_variant "extend,basic,qwerty"
    xkb_options numpad:mac
    # WSLg already repeats held keys (release/press pairs); a second repeat
    # in sway doubles key presses and re-fires bindings.
    repeat_rate  0
}
# }}} = Output / Input =======================================================

# {{{ = Look =================================================================
font pango:monospace 10
default_border pixel 2
default_floating_border pixel 2
focus_follows_mouse no

bar {
    position top
    status_command while date +'%Y-%m-%d %H:%M'; do sleep 30; done
}
# }}} = Look =================================================================

# {{{ = Key bindings =========================================================
# Not bound: Alt+F4 (Windows would close the whole sway window).
# Alt+drag; Win+drag is AutoHotkey's (moves the whole sway window).
floating_modifier Mod1 normal

# ISO + key = desktop's $mod + key: ISO enters the "wm" mode, the next
# binding runs and returns to default (one-shot).
# Why not "leave on release": sway arms a --release binding on the *press*,
# in the mode active then; once another key is pressed it is disarmed. So
# ISO+key, then releasing ISO, never fires it. The release bindings below
# only cover ISO tapped alone, and the release/press pairs WSLg sends for a
# held key (its key repeat).
bindsym Hyper_L                  mode "$mode_wm"
bindsym --release Hyper_L        mode "default"
mode "$mode_wm" {
    bindsym Hyper_L              nop
    bindsym --release Hyper_L    mode "default"

    bindsym --no-repeat Return   exec $term, mode "default"
    bindsym --no-repeat Insert   input type:keyboard xkb_switch_layout next, mode "default"

    # Focus / move
    bindsym Alt+$left            focus left, mode "default"
    bindsym Alt+$right           focus right, mode "default"
    bindsym Alt+$up              focus up, mode "default"
    bindsym Alt+$down            focus down, mode "default"
    bindsym Alt+Left             focus left, mode "default"
    bindsym Alt+Right            focus right, mode "default"
    bindsym Alt+Up               focus up, mode "default"
    bindsym Alt+Down             focus down, mode "default"
    bindsym Alt+Shift+$left      move left, mode "default"
    bindsym Alt+Shift+$right     move right, mode "default"
    bindsym Alt+Shift+$up        move up, mode "default"
    bindsym Alt+Shift+$down      move down, mode "default"
    bindsym Alt+Shift+Left       move left, mode "default"
    bindsym Alt+Shift+Right      move right, mode "default"
    bindsym Alt+Shift+Up         move up, mode "default"
    bindsym Alt+Shift+Down       move down, mode "default"

    # Layout
    bindsym h                    layout splith, mode "default"
    bindsym Shift+h              split h, mode "default"
    bindsym v                    layout splitv, mode "default"
    bindsym Shift+v              split v, mode "default"
    bindsym s                    layout toggle split, mode "default"
    bindsym t                    layout tabbed, mode "default"
    bindsym Shift+s              layout stacking, mode "default"
    bindsym Alt+z                fullscreen toggle, mode "default"
    bindsym Alt+t                floating toggle, mode "default"
    bindsym p                    focus mode_toggle, mode "default"
    bindsym a                    focus parent, mode "default"
    bindsym Shift+a              focus child, mode "default"
    bindsym z                    move scratchpad, mode "default"
    bindsym Shift+z              scratchpad show, mode "default"
    bindsym b                    bar mode toggle, mode "default"

    # Workspaces
    bindsym $left                workspace prev_on_output, mode "default"
    bindsym $right               workspace next_on_output, mode "default"
    bindsym Left                 workspace prev_on_output, mode "default"
    bindsym Right                workspace next_on_output, mode "default"
    bindsym 1                    workspace number 1, mode "default"
    bindsym 2                    workspace number 2, mode "default"
    bindsym 3                    workspace number 3, mode "default"
    bindsym 4                    workspace number 4, mode "default"
    bindsym 5                    workspace number 5, mode "default"
    bindsym 6                    workspace number 6, mode "default"
    bindsym 7                    workspace number 7, mode "default"
    bindsym 8                    workspace number 8, mode "default"
    bindsym 9                    workspace number 9, mode "default"
    bindsym 0                    workspace number 10, mode "default"
    bindsym Shift+1              move container to workspace number 1, workspace number 1, mode "default"
    bindsym Shift+2              move container to workspace number 2, workspace number 2, mode "default"
    bindsym Shift+3              move container to workspace number 3, workspace number 3, mode "default"
    bindsym Shift+4              move container to workspace number 4, workspace number 4, mode "default"
    bindsym Shift+5              move container to workspace number 5, workspace number 5, mode "default"
    bindsym Shift+6              move container to workspace number 6, workspace number 6, mode "default"
    bindsym Shift+7              move container to workspace number 7, workspace number 7, mode "default"
    bindsym Shift+8              move container to workspace number 8, workspace number 8, mode "default"
    bindsym Shift+9              move container to workspace number 9, workspace number 9, mode "default"
    bindsym Shift+0              move container to workspace number 10, workspace number 10, mode "default"

    bindsym x                    mode "$mode_meta"
    bindsym Escape               mode "$mode_system"
}

# Meta mode (desktop: $mod+x): close, resize
mode "$mode_meta" {
    bindsym c            kill, mode "default"
    bindsym $left        resize shrink width  100 px
    bindsym $right       resize grow   width  100 px
    bindsym $up          resize grow   height 100 px
    bindsym $down        resize shrink height 100 px
    bindsym Shift+$left  resize shrink width   10 px
    bindsym Shift+$right resize grow   width   10 px
    bindsym Shift+$up    resize grow   height  10 px
    bindsym Shift+$down  resize shrink height  10 px
    bindsym Left         resize shrink width  100 px
    bindsym Right        resize grow   width  100 px
    bindsym Up           resize grow   height 100 px
    bindsym Down         resize shrink height 100 px
    bindsym Return       mode "default"
    bindsym Escape       mode "default"
    bindsym Ctrl+g       mode "default"
}

# System mode (desktop: $mod+Escape): reload, exit
mode "$mode_system" {
    bindsym c            reload, mode "default"
    bindsym Shift+x      exit
    bindsym Return       mode "default"
    bindsym Escape       mode "default"
    bindsym Ctrl+g       mode "default"
}
# }}} = Key bindings =========================================================

# {{{ = Startup ==============================================================
exec sway-wslg-clipboard
# }}} = Startup ==============================================================
