[Unit]
Description=Sync OneDrive every 30 minutes
Documentation=file:%h/dotfiles/bin/onedrive-sync

[Timer]
# Interval counted from the end of the previous run, so a slow catch-up never
# stacks runs. A routine run is ~3 min (DB check + scan of ~200k files) on saito.
OnStartupSec=10min
OnUnitInactiveSec=30min
AccuracySec=1min
RandomizedDelaySec=2min
Persistent=true

[Install]
WantedBy=timers.target
