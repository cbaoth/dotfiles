[Unit]
Description=Alert (ntfy) that rclone-bisync %i is persistently failing
Documentation=file:%h/dotfiles/bin/rclone-bisync
# Started via OnFailure= in rclone-bisync@.service — no timer, no [Install].

[Service]
Type=oneshot
# Throttled per title: a failure repeating every 30 min pushes at most every 6 h.
ExecStart=%h/bin/ntfy-send --priority high --tags cloud,warning --throttle 21600 \
  "rclone-bisync %i FAILED" \
  "%i has not synced for hours. Inspect: journalctl --user -u rclone-bisync@%i -n 60"
