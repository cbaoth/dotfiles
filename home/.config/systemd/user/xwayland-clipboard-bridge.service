[Unit]
Description=Copy X11 clipboard copies (wine, Proton, XWayland) to the Wayland clipboard
Documentation=file:///home/cbaoth/dotfiles/docs/troubleshooting/xwayland-clipboard-to-wayland.md
# Started explicitly from the sway config:
#   exec systemctl --user start xwayland-clipboard-bridge.service
# That runs after `dbus-update-activation-environment --systemd`, so DISPLAY and
# WAYLAND_DISPLAY are in the unit's environment. No `enable` needed.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/bin/xwayland-clipboard-bridge
# Also after an Xwayland restart: the X connection drops and the bridge exits.
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
