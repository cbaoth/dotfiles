[Unit]
Description=Auto-commit and sync the private notes repo (~/notes)
Documentation=file:%h/dotfiles/bin/notes-sync
# Pointless (and noisy) to even try while offline; the timer will come back.
After=network-online.target
Wants=network-online.target

# A *transient* failure (offline, agent not up) exits 0 and just retries. This
# only fires when notes-sync exits non-zero — a *persistent* failure (no
# upstream, stuck rebase, a growing backlog of unpushed commits). See the ntfy
# escalation in bin/notes-sync.
OnFailure=notes-sync-failed.service

[Service]
Type=oneshot
ExecStart=%h/bin/notes-sync --quiet

# The push needs an SSH agent. On motoko that is KeePassXC, which only exists
# inside the graphical session — so this unit is only useful once that session
# is up. A *transient* failed push degrades to "commit only" (kept locally,
# retried next tick) rather than data loss; only a *persistent* failure escalates
# to a non-zero exit and the OnFailure= alert above.
Environment=GIT_TERMINAL_PROMPT=0

# Never let a stuck network call pile up timer firings.
TimeoutStartSec=120

[Install]
WantedBy=default.target
