[Unit]
Description=Commit and pull ~/notes hourly (no push)
Documentation=file:%h/dotfiles/bin/notes-sync

[Timer]
# Hourly, not the 5 minutes notes-sync uses. Nothing leaves the host before a
# manual push anyway, so a commit is only a local checkpoint; `notc`/`notsy`
# commit on demand at the end of a session. Far fewer wakeups and log lines.
OnStartupSec=3min
OnUnitActiveSec=1h

AccuracySec=1min
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target
