// Custom XKB symbols
//
// https://xkbcommon.org/doc/current/keymap-text-format-v1-v2.html
// https://lars.ingebrigtsen.no/2024/04/28/the-simplest-thing-in-the-world-modifing-keymaps-in-wayland/
//
// libxkbcommon searches ~/.config/xkb/symbols/ before system paths, so this
// file is found automatically when sway specifies xkb_layout=custom, xkb_variant=basic.
//
// Basic sway input block to use this custom layout:
// input "type:keyboard" {
//    # Use custom layouts: Colemak + Extend, Colemak, QWERTY
//    xkb_layout  "custom,custom,custom"
//    xkb_variant "extend,basic,qwerty"
//    # Use plain Colemak
//    #xkb_layout us
//    #xkb_variant colemak
// }

// Modifier plumbing shared by all variants.
//
// XKB has only 8 real modifiers, and with Extend all of them are spoken for:
//   Shift  Lock  Control  Mod1=Alt  Mod2=LevelFive (Extend)  Mod3=Hyper
//   Mod4=Super  Mod5=LevelThree (AltGr)
// Stock pc puts LevelFive on Mod3 next to Hyper. Sharing breaks sway: it also
// matches bindings against the unshifted keysym, so Extend+E (Down) would fire
// `$hyper+e`. NumLock gives up Mod2 instead (no numpad in use; sway sets
// numpad:mac so a keypad still types digits).
//
// Modifier maps are per key, not per group, so the Caps key must not be in
// one: Ctrl here and LevelFive in custom(extend) both use explicit actions.
partial modifier_keys
xkb_symbols "mods" {
    // ISO key (<LSGT>): the key between Left Shift and Z on ISO keyboards.
    // us(colemak) maps this key to minus/underscore; override it with Hyper_L
    // so sway can use it as $hyper (Mod3) in bindsym directives.
    key <LSGT> { [ Hyper_L, Hyper_L ] };
    modifier_map Mod3 { <LSGT> };

    // CapsLock -> Ctrl (formerly BackSpace via us(colemak), plus AltGr+Caps ->
    // Delete; neither caught on).
    key <CAPS> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ Control_L ],
                 actions[Group1] = [ SetMods(modifiers=Control) ] };

    // Free Mod2 for LevelFive: void the NumLock key (an unmapped NumLock would
    // otherwise lock Mod2 = permanent Extend) and move pc's fake <LVL5> key.
    key <NMLK> { type[Group1] = "ONE_LEVEL", [ VoidSymbol ] };
    modifier_map Mod2 { <LVL5> };
};

xkb_symbols "basic" {
    // Full Colemak layout
    include "us(colemak)"
    include "custom(mods)"
    name[Group1] = "Colemak (US)";

    // AltGr+Delete -> Insert (AutoHotkey <^>!Del::Insert). Mainly for keyboards
    // with no dedicated Insert key, e.g. the Logitech MX Mechanical Mini, where
    // it otherwise needs a hard-to-remember Fn combination.
    key <DELE> { [ Delete, Delete, Insert, Insert ] };

    // Arrow characters, mirroring the AutoHotkey bindings used on Windows
    // (Incl/KeyMap.ahk: <^>!. -> "→" etc.).
    //
    // us(colemak) already pulls in level3(ralt_switch), so AltGr *is* LevelThree:
    //   level 1 = plain   level 2 = Shift   level 3 = AltGr   level 4 = AltGr+Shift
    //
    // Only level 4 is overridden, so the level-3 dead keys stay usable. This is
    // free: us(colemak) puts `asciitilde` on level 4 of every key whose level 3
    // is a dead key (13 keys) as pure filler, and `~` already lives on
    // Shift+grave — so nothing reachable is lost.
    //
    // Left/right key position mirrors arrow direction (k left of m, as , left of .).
    key <AB09> { [ period, greater, dead_abovedot,  U2192 ] };  // AltGr-Shift-.  ->  →
    key <AB08> { [ comma,  less,    dead_cedilla,   U2190 ] };  // AltGr-Shift-,  ->  ←
    key <AB07> { [ m,      M,       dead_macron,    U21D2 ] };  // AltGr-Shift-m  ->  ⇒
    key <AB06> { [ k,      K,       dead_abovering, U21D0 ] };  // AltGr-Shift-k  ->  ⇐

    // ()/[] swap: OFF, kept for testing. Puts ( ) unshifted on the bracket
    // keys and [ ] on Shift+9/0; { } stay on Shift+bracket. Parens are far
    // more common than brackets in Lisp and in prose. Ported from the old
    // xmodmap-104-us (2000s, see docs/setup/emacs.md). Levels 3/4 repeat
    // us(colemak)'s quote marks and guillemets unchanged.
    // To test: uncomment the four lines, then `swaymsg reload`.
    //key <AE09> { [ 9,          bracketleft,  leftsinglequotemark,  leftdoublequotemark  ] };
    //key <AE10> { [ 0,          bracketright, rightsinglequotemark, rightdoublequotemark ] };
    //key <AD11> { [ parenleft,  braceleft,    guillemotleft,        0x1002039 ] };
    //key <AD12> { [ parenright, braceright,   guillemotright,       0x100203a ] };
};

xkb_symbols "qwerty" {
    // Plain US QWERTY layout (maps <LSGT> to backslash/bar, overridden below).
    // Activated via Scroll_Lock toggle (kbd-layout-toggle) for gaming / QWERTY sessions.
    include "us(basic)"
    include "custom(mods)"
    name[Group1] = "QWERTY (US)";
};

xkb_symbols "extend" {
    // Colemak + DreymaR's Extend layer: hold CapsLock for navigation, editing
    // and home-row modifiers. https://dreymar.colemak.org/layers-extend.html
    // Layer map, design and known limits: docs/setup/extend-layer.md
    include "custom(basic)"
    name[Group1] = "Colemak (US) + Extend";

    // Main layer only. Left out: extend(lv5_fk) (media keys on F1-F12, eats
    // Ctrl+Alt+F# and collides with the $altgr+F# sway bindings) and
    // extend(lv5_sk) (Extend on Backspace/Enter, flaky in some toolkits).
    include "extend(lv5)"

    // CapsLock held = Extend.
    key <CAPS> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ ISO_Level5_Shift ],
                 actions[Group1] = [ SetMods(modifiers=LevelFive) ] };

    // extend(lv5) maps <LSGT> to Delete with explicit actions, which also
    // kills Hyper on levels 1-4. Put Hyper back.
    key <LSGT> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ Hyper_L ],
                 actions[Group1] = [ SetMods(modifiers=Mod3) ] };

    // Home-row modifiers (a/s/t = Alt/Shift/Ctrl) must not auto-repeat:
    // Wayland clients repeat keys themselves and re-send the key with the
    // modifier now active, so a held Extend+T arrived as Ctrl+t (zsh
    // transpose-chars, VS Code "Go to Symbol"). Repeat is per key, not per
    // group: holding a/s/t no longer repeats the letter in any group.
    key <AC01> { repeat = no };
    key <AC03> { repeat = no };
    key <AC04> { repeat = no };

    // Key types: extend(lv5) uses EIGHT_LEVEL_SEMIALPHABETIC, which consumes
    // Shift on Extend levels, so Extend+S+T+N arrives as Ctrl+Left instead of
    // Ctrl+Shift+Left (no word selection). The *_WITH_LEVEL5_LOCK types keep
    // Shift (preserve[LevelFive+Shift]); their NumLock entries are inert since
    // NumLock is unmapped (see "mods").
    // Extend+` (Pointer_EnableKeys, an X11 MouseKeys toggle): disabled, the
    // key is kept free for later use. NoSymbol keeps levels 1-4 from Colemak.
    key <TLDE> { type[Group1] = "EIGHT_LEVEL_WITH_LEVEL5_LOCK",
                 symbols[Group1] = [ NoSymbol, NoSymbol, NoSymbol, NoSymbol,
                                     VoidSymbol, VoidSymbol, VoidSymbol, VoidSymbol ] };
    key <ESC>  { type[Group1] = "EIGHT_LEVEL_WITH_LEVEL5_LOCK" };
    key <AE01> { type[Group1] = "EIGHT_LEVEL_WITH_LEVEL5_LOCK" };
    key <AE02> { type[Group1] = "EIGHT_LEVEL_WITH_LEVEL5_LOCK" };
    key <AE03> { type[Group1] = "EIGHT_LEVEL_WITH_LEVEL5_LOCK" };
    key <AE04> { type[Group1] = "EIGHT_LEVEL_WITH_LEVEL5_LOCK" };
    key <AE05> { type[Group1] = "EIGHT_LEVEL_WITH_LEVEL5_LOCK" };
    key <AE06> { type[Group1] = "EIGHT_LEVEL_WITH_LEVEL5_LOCK" };
    key <AE07> { type[Group1] = "EIGHT_LEVEL_WITH_LEVEL5_LOCK" };
    key <AE08> { type[Group1] = "EIGHT_LEVEL_WITH_LEVEL5_LOCK" };
    key <AE09> { type[Group1] = "EIGHT_LEVEL_WITH_LEVEL5_LOCK" };
    key <AE10> { type[Group1] = "EIGHT_LEVEL_WITH_LEVEL5_LOCK" };
    key <AE11> { type[Group1] = "EIGHT_LEVEL_WITH_LEVEL5_LOCK" };
    key <AE12> { type[Group1] = "EIGHT_LEVEL_WITH_LEVEL5_LOCK" };
    // Colemak letters (q w f p g j l u y / a r s t d h n e i o / z x c v b k m)
    key <AD01> { type[Group1] = "EIGHT_LEVEL_ALPHABETIC_WITH_LEVEL5_LOCK" };
    key <AD02> { type[Group1] = "EIGHT_LEVEL_ALPHABETIC_WITH_LEVEL5_LOCK" };
    key <AD03> { type[Group1] = "EIGHT_LEVEL_ALPHABETIC_WITH_LEVEL5_LOCK" };
    key <AD04> { type[Group1] = "EIGHT_LEVEL_ALPHABETIC_WITH_LEVEL5_LOCK" };
    key <AD05> { type[Group1] = "EIGHT_LEVEL_ALPHABETIC_WITH_LEVEL5_LOCK" };
    key <AD06> { type[Group1] = "EIGHT_LEVEL_ALPHABETIC_WITH_LEVEL5_LOCK" };
    key <AD07> { type[Group1] = "EIGHT_LEVEL_ALPHABETIC_WITH_LEVEL5_LOCK" };
    key <AD08> { type[Group1] = "EIGHT_LEVEL_ALPHABETIC_WITH_LEVEL5_LOCK" };
    key <AD09> { type[Group1] = "EIGHT_LEVEL_ALPHABETIC_WITH_LEVEL5_LOCK" };
    key <AC01> { type[Group1] = "EIGHT_LEVEL_ALPHABETIC_WITH_LEVEL5_LOCK" };
    key <AC02> { type[Group1] = "EIGHT_LEVEL_ALPHABETIC_WITH_LEVEL5_LOCK" };
    key <AC03> { type[Group1] = "EIGHT_LEVEL_ALPHABETIC_WITH_LEVEL5_LOCK" };
    key <AC04> { type[Group1] = "EIGHT_LEVEL_ALPHABETIC_WITH_LEVEL5_LOCK" };
    key <AC05> { type[Group1] = "EIGHT_LEVEL_ALPHABETIC_WITH_LEVEL5_LOCK" };
    key <AC06> { type[Group1] = "EIGHT_LEVEL_ALPHABETIC_WITH_LEVEL5_LOCK" };
    key <AC07> { type[Group1] = "EIGHT_LEVEL_ALPHABETIC_WITH_LEVEL5_LOCK" };
    key <AC08> { type[Group1] = "EIGHT_LEVEL_ALPHABETIC_WITH_LEVEL5_LOCK" };
    key <AC09> { type[Group1] = "EIGHT_LEVEL_ALPHABETIC_WITH_LEVEL5_LOCK" };
    key <AC10> { type[Group1] = "EIGHT_LEVEL_ALPHABETIC_WITH_LEVEL5_LOCK" };
    key <AB01> { type[Group1] = "EIGHT_LEVEL_ALPHABETIC_WITH_LEVEL5_LOCK" };
    key <AB02> { type[Group1] = "EIGHT_LEVEL_ALPHABETIC_WITH_LEVEL5_LOCK" };
    key <AB03> { type[Group1] = "EIGHT_LEVEL_ALPHABETIC_WITH_LEVEL5_LOCK" };
    key <AB04> { type[Group1] = "EIGHT_LEVEL_ALPHABETIC_WITH_LEVEL5_LOCK" };
    key <AB05> { type[Group1] = "EIGHT_LEVEL_ALPHABETIC_WITH_LEVEL5_LOCK" };
    key <AB06> { type[Group1] = "EIGHT_LEVEL_ALPHABETIC_WITH_LEVEL5_LOCK" };
    key <AB07> { type[Group1] = "EIGHT_LEVEL_ALPHABETIC_WITH_LEVEL5_LOCK" };
    // Non-letter keys in the letter block
    key <AD10> { type[Group1] = "EIGHT_LEVEL_WITH_LEVEL5_LOCK" };
    key <AD11> { type[Group1] = "EIGHT_LEVEL_WITH_LEVEL5_LOCK" };
    key <AD12> { type[Group1] = "EIGHT_LEVEL_WITH_LEVEL5_LOCK" };
    key <BKSL> { type[Group1] = "EIGHT_LEVEL_WITH_LEVEL5_LOCK" };
    key <AC11> { type[Group1] = "EIGHT_LEVEL_WITH_LEVEL5_LOCK" };
    key <AB08> { type[Group1] = "EIGHT_LEVEL_WITH_LEVEL5_LOCK" };
    key <AB09> { type[Group1] = "EIGHT_LEVEL_WITH_LEVEL5_LOCK" };
    key <AB10> { type[Group1] = "EIGHT_LEVEL_WITH_LEVEL5_LOCK" };
    key <SPCE> { type[Group1] = "EIGHT_LEVEL_WITH_LEVEL5_LOCK" };
};
