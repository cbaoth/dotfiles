#compdef translate tlde tlen tldeF tlenF
# vim: ft=zsh:et:ts=2:sts=2:sw=2
#
# Completion for translate (bin/translate in the dotfiles repo) and its zsh
# front-ends tlde/tlen/tldeF/tlenF (.zsh.d/translate.zsh). Autoloaded by compinit via the
# #compdef tag above.
#
# Keep in sync with bin/translate: options mirror parse_args(); language codes
# are read live from its LANGUAGES table, models from `ollama list`.

_translate_langs() {
  local bin
  bin=$(whence -p translate 2>/dev/null) || return
  local -a langs
  langs=(${(f)"$(sed -n 's/^ *"\([a-z][a-z]\)": "\(.*\)",$/\1:\2/p' "${bin:A}")"})
  (( ${#langs} )) && _describe -t languages 'language' langs
}

_translate_models() {
  (( $+commands[ollama] )) || return
  local -a models
  models=(${${(f)"$(ollama list 2>/dev/null)"}[2,-1]%%[[:space:]]*})
  # compadd, not _values: model tags contain colons (hf.co/...:Q4_K_M)
  (( ${#models} )) && compadd -- "${models[@]}"
}

local -a target
local -a faithful
# tlde/tlen/... fix the target language; tldeF/tlenF are already faithful
[[ $service == translate ]] && target=('(-t --target)'{-t,--target}'[target language]:language:_translate_langs')
[[ $service == (translate|tlde|tlen) ]] && faithful=('(-F --faithful)'{-F,--faithful}'[keep profanity and insults (general model, slower)]')

_arguments -s -S \
  '(- *)'{-h,--help}'[show help]' \
  "${target[@]}" \
  "${faithful[@]}" \
  '(-s --source)'{-s,--source}'[source language]:language:_translate_langs' \
  '(-m --model)'{-m,--model}'[Ollama model]:model:_translate_models' \
  '(--cpu)--gpu[let Ollama put the model on the GPU]' \
  '(--gpu)--cpu[keep the model on the CPU (default)]' \
  '--keep-alive[keep the model loaded this long]:duration (30m, 2h, -1 = forever):' \
  '(*)--raw[the text as one literal argument]:text:' \
  '*:text:'
