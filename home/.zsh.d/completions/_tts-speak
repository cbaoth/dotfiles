#compdef tts-speak
# vim: ft=zsh:et:ts=2:sts=2:sw=2
#
# Completion for tts-speak (bin/tts-speak in the dotfiles repo).
# Autoloaded by compinit via the #compdef tag above.
#
# Keep in sync with bin/tts-speak: options mirror usage(); engine names are
# discovered live from its engine_* functions, piper voices from the model
# directory, so adding an engine or a voice needs no edit here.

_tts-speak_engines() {
  local bin
  bin=$(whence -p tts-speak 2>/dev/null) || return
  local -a engines
  engines=(${(f)"$(sed -n 's/^engine_\([a-z0-9]*\)().*/\1/p' "${bin:A}")"})
  (( ${#engines} )) && _values 'engine' "${engines[@]}"
}

# Voices depend on the engine given earlier on the line (-e/--engine), else
# the default from the config file / environment, else piper.
_tts-speak_voices() {
  local engine=${TTS_ENGINE:-piper} i
  for (( i = 1; i < CURRENT; i++ )); do
    [[ ${words[i]} == (-e|--engine) ]] && engine=${words[i+1]}
  done
  case $engine in
    piper)
      local dir=${TTS_PIPER_DIR:-$HOME/.cache/piper-tts}
      local -a voices
      if compset -P '*:'; then  # MODEL:<TAB> -> speaker names/ids of that model
        local model=${IPREFIX%:}
        voices=(${(f)"$(jq -r '.speaker_id_map // {} | keys[]' "${dir}/${model}.onnx.json" 2>/dev/null)"})
        (( ${#voices} )) && _describe -t speakers 'speaker' voices
      else
        voices=("${dir}"/*.onnx(N:t:r))
        (( ${#voices} )) && compadd -S '' -- "${voices[@]}"
      fi
      ;;
    http)
      # OpenAI-style servers list their voices (Voxtral does; others may not).
      local url=${TTS_HTTP_URL:-http://127.0.0.1:8880/v1/audio/speech} v
      local -a hv
      hv=(${(f)"$(curl -s -m 1 "${url%/audio/speech}/audio/voices" 2>/dev/null | jq -r '.voices[]?' 2>/dev/null)"})
      (( ${#hv} )) && _values 'server voice' "${hv[@]}" || _message 'no voice list from the server (not running?)'
      ;;
    *) _message "voice name is server-specific for engine '${engine}'" ;;
  esac
}

# --fixes: a NAME from the fixes dir (listed live), or any .sed file.
_tts-speak_fixes() {
  local dir=${TTS_PIPER_FIXES_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/tts}/fixes
  local -a names
  names=("${dir}"/*.sed(N:t:r))
  _alternative "names:fixes:compadd -a names" 'files:file:_files -g "*.sed"'
}

_arguments -s \
  '(-e --engine)'{-e,--engine}'[Engine to use]:engine:_tts-speak_engines' \
  '(-l --lang)'{-l,--lang}'[Text language]:language:(de en auto)' \
  '(-v --voice)'{-v,--voice}'[Voice/model (engine-specific)]:voice:_tts-speak_voices' \
  '(-s --speed)'{-s,--speed}'[Speaking speed, 1.0 = normal]:speed:(0.8 0.9 1.0 1.1 1.2 1.5)' \
  '(-o --output)'{-o,--output}'[Write audio to FILE instead of playing]:file:_files' \
  '(-k --keep --no-keep)'{-k,--keep}'[Also keep the audio as a session dir under DIR]:directory:_files -/' \
  '(-k --keep)--no-keep[Do not keep the audio, even if TTS_KEEP_DIR is set]' \
  '*--fixes[Piper: extra pronunciation fixes (sed script or NAME)]:fixes:_tts-speak_fixes' \
  '*'{-p,--piper-opt}'[Piper tuning KEY=VAL,...]:option:(noise_scale= noise_w= length_scale= sentence_silence=)' \
  '(-u --ui)'{-u,--ui}'[Player UI: terminal, window, or plain background]:ui:(auto term window none)' \
  '--no-clean[Read the text exactly as given]' \
  '(-h --help)'{-h,--help}'[Show help]' \
  '1:command:(toggle stop pause prev next list)' \
  '*:text: '
