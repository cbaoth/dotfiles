#compdef apt-sources
# vim: ft=zsh:et:ts=2:sts=2:sw=2
#
# Completion for apt-sources (bin/apt-sources in the dotfiles repo).
# Autoloaded by compinit via the #compdef tag above.
#
# Keep in sync with bin/apt-sources: commands and options mirror p_hlp().
# Release codenames are read live from distro-info-data.

_apt-sources() {
  local -a common codenames
  common=(
    '(-n --dry-run -y --yes)'{-n,--dry-run}'[show proposed changes only]'
    '(-n --dry-run -y --yes)'{-y,--yes}'[apply unambiguous changes without asking]'
    '--no-backup[do not keep FILE.bak]'
    '*'{-v,--verbose}'[increase verbosity]'
    '(- *)'{-h,--help}'[show help]'
    '*:sources file:_files -W /etc/apt/sources.list.d -g "*.sources"'
  )
  if (( CURRENT == 2 )); then
    _describe command '(
      "reenable:re-enable and re-target sources after a release upgrade"
      "keys:verify signing keys, refresh or pin them"
      "cleanup:delete leftover backups apt ignores"
    )'
    return
  fi
  case "${words[2]}" in
    reenable)
      codenames=(${(f)"$(ubuntu-distro-info --all 2>/dev/null)"})
      _arguments -S "${common[@]}" \
        '(-r --release)'{-r,--release}'[target release codename]:codename:(${codenames})' \
        '--no-keys[skip the key check]'
      ;;
    keys)
      _arguments -S "${common[@]}"
      ;;
    cleanup)
      # no FILE arguments
      _arguments -S "${(@)common[1,-2]}"
      ;;
  esac
}

_apt-sources "$@"
