#compdef tts-clean
# vim: ft=zsh:et:ts=2:sts=2:sw=2
#
# Completion for tts-clean (bin/tts-clean in the dotfiles repo; stdin -> stdout).
# Keep in sync with its argparse options.

_arguments -s \
  '(-l --lang)'{-l,--lang}'[Language for abbreviation expansion]:language:(auto de en)' \
  '(-c --chunk)'{-c,--chunk}'[One chunk per line, at most N chars]:max chars:(120 300 500)' \
  '(-s --sentence)'{-s,--sentence}'[With --chunk: split sentences longer than N chars at clause breaks]:max chars:(120 150 200)' \
  '(-p --pauses)'{-p,--pauses}'[With --chunk: a chunk per list item and paragraph, with a tab and its pause level]' \
  '--no-numbers[Keep digits (numbers are spelled out by default)]' \
  '--keep-references[Keep trailing sections such as References, See also, Einzelnachweise]' \
  '--detect[Print the detected language and exit]' \
  '(-h --help)'{-h,--help}'[Show help]'
