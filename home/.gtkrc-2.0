# ~/.gtkrc-2.0: GTK2 theme settings.
#
# GTK2 does not read the GTK3/4 settings.ini, gsettings, or the desktop
# color-scheme portal, so a GTK2 app renders light on a dark desktop unless a
# dark GTK2 theme is named here explicitly. The only GTK2 app in use is Double
# Commander (the doublecmd-gtk build); its own panel colours are theme-default,
# so theming the widgetset darkens both the chrome and the file panels.
#
# Adwaita-dark, not the GTK3 Yaru-magenta-dark: yaru-theme-gtk 26.10 dropped
# its gtk-2.0/ variants, and a theme name without one falls back to the light
# GTK2 default with no error. Adwaita-dark's GTK2 theme comes from
# gnome-themes-extra-data (pulled in by libgtk2.0). There is no Adwaita-dark
# icon theme; the Yaru icon themes are still shipped, so icons keep matching
# the rest of the desktop. See docs/setup/dark-theme.md.

gtk-theme-name="Adwaita-dark"
gtk-icon-theme-name="Yaru-magenta-dark"
gtk-font-name="Ubuntu Sans 11"
