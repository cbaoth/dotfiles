# ~/.gitconfig — universal git configuration, tracked in cbaoth/dotfiles.
#
# Machine-specific settings (credential helper, work identity, OS quirks) do
# NOT belong here — this repo is public. They live in the untracked
# ~/.gitconfig.local; see .gitconfig.local.example for the template.

[user]
	name = Andreas Weyer
	email = dev@cbaoth.de

[credential "https://github.com"]
	# Answers the "Username for 'https://github.com'" prompt so only the token
	# is ever asked for. Safe in this public repo: the account name is already
	# in every remote URL — it is identity, like user.email above, not a
	# secret and not the machine-specific *helper* (which stays in
	# ~/.gitconfig.local).
	#
	# The alternative is baking `cbaoth@` into each remote URL by hand, which
	# has to be redone for every fresh clone on every host. This does not.
	# Matters most with `git push-token`, which disables the helpers on purpose
	# and so has nothing cached to fall back on.
	username = cbaoth

[core]
	# No pager by default: git commands dump straight to the terminal instead
	# of opening less. Matches the global PAGER=cat trial in ~/.common_env and
	# the everyday habit of appending the `,l` alias (| less) only when needed.
	# Overrides $PAGER/$GIT_PAGER for git specifically; drop this to restore the
	# default pager, or page one command with `git -p <cmd>` / `git <cmd> ,l`.
	pager = cat

[init]
	defaultBranch = main

[pull]
	# Rebase local commits onto fetched ones instead of a merge commit. Set
	# globally so every repo behaves the same, with no per-clone step (and no
	# "you have divergent branches" hint after the fact).
	rebase = true

[rebase]
	# Auto-stash a dirty working tree before a rebase (incl. `pull --rebase`)
	# and re-apply it after — no more "cannot rebase: you have unstaged
	# changes". The stash is restored even if the rebase is aborted.
	autoStash = true

[merge]
	# 3-way conflict markers: also show the original (merge-base) text between
	# ||||||| and =======, not just ours vs theirs. Makes "both sides changed
	# this" conflicts actually resolvable instead of a guessing game.
	conflictStyle = zdiff3

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# Claude Code settings: commit with sorted keys and without per-host values
# (model, effort), so reorders and /model or effort switches never show as
# changes. Opt-in per file via .gitattributes (filter=claude-settings). Not
# required: on a host without this config (e.g. before dotfiles-link on a fresh
# machine) git simply passes the file through unfiltered.
# Quirk: `git status` (and VS Code's badge) can still list the file as
# modified while `git diff` is empty. Status skips the filter when the file
# size differs from the size recorded at the last `git add`, and the raw file
# (unsorted, with model/effort) rarely matches it. `git add` on the file stages
# nothing and refreshes that record. VS Code's diff view does not run the
# filter at all; it compares HEAD with the raw file.
[filter "claude-settings"]
	clean = jq -S --indent 2 'del(.model, .effortLevel, .modelSettings)'
	smudge = cat

# htop rewrites htoprc on every exit, including the sort column picked in the
# UI. Commit every sort setting pinned to htop's defaults (CPU%, descending), so
# re-sorting never shows as a change. Trade-off: a fresh checkout starts every
# screen sorted by CPU%. Same status quirk as claude-settings above.
[filter "htoprc"]
	clean = sed -E \
		-e 's/^sort_key=.*/sort_key=46/' \
		-e 's/^sort_direction=.*/sort_direction=-1/' \
		-e 's/^tree_sort_key=.*/tree_sort_key=0/' \
		-e 's/^tree_sort_direction=.*/tree_sort_direction=1/' \
		-e 's/^[.]sort_key=.*/.sort_key=PERCENT_CPU/' \
		-e 's/^[.]sort_direction=.*/.sort_direction=-1/' \
		-e 's/^[.]tree_sort_key=.*/.tree_sort_key=PID/' \
		-e 's/^[.]tree_sort_direction=.*/.tree_sort_direction=1/'
	smudge = cat

# Loaded last, so machine-local settings win over the defaults above. A missing
# file is silently ignored, so this is safe on a host that has no local config.
[include]
	path = ~/.gitconfig.local
