# Build context = repo root for .devcontainer/Dockerfile (the image copies the
# working tree). Keep anything private or per-machine out of the image.

# Scratch and local overrides (see .gitignore)
_local/
scratch/
**/*.local
**/*.local.*
!**/*.local.example
# The host clone's link profile (tools/link.sh) is handed down to the image;
# it holds only a profile name. Dockerfile fails early when it is missing.
!/.link-profile.local
.env
.env.*

# Caches
.ruff_cache/
**/__pycache__/
