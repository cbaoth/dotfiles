# Base apt packages — every machine (desktop, server, wsl).
# One package per line. Blank lines and # comments ignored.
# Installed by: setup/modules/00-apt-base.sh
# Docs:         docs/setup/ubuntu-base.md

# Shell & editors
zsh
vim
neovim

# Terminal multiplexing & monitoring
tmux
htop
btop

# Network
iftop
ngrep
lsof

# Version control
git
git-lfs

# Transfer & backup
wget
curl
aria2
rsync
restic
# Previously only a gnome-shell dependency (auto); see desktop.list.
sshfs
gnupg
ca-certificates

# Pagers & syntax highlighting
less
bat
multitail
python3-pygments

# Search & find
fd-find
ripgrep
# TODO look into ripgrep-all

# Data wrangling
jq
gawk
parallel

# Archives
unzip
zip
# 7zip, not p7zip-full: the latter is now only a virtual name provided by 7zip.
# dpkg-query never reports a virtual package as installed, so using it here
# would make every run reinstall it and report a change forever. It happens to
# work on machines that upgraded through the transitional package — i.e. it
# would only break on a fresh box.
7zip

# Python
python3-pip
python3-venv
python-is-python3

# Development tools
shellcheck
# Claude Code's sandboxed Bash tool needs both on Linux; without them the CLI
# still runs but warns, and sandboxing is unavailable. The CLI itself is not an
# apt package here: setup/modules/28-claude-code.sh (which warns if these are
# missing, since it can run without 00-apt-base).
bubblewrap
socat

# Cron & scheduling
# cronic wraps a cron job so output is mailed only on failure. Crontabs
# reference it directly, so its absence breaks them *silently* — a desktop
# purge removed it from saito on 2026-09-26 and took the backups down for two
# weeks unnoticed. Tiny (21 kB installed, no deps beyond a shell).
# NOTE: it reports by mailing root, which nobody reads. It is not alerting;
# that is the ntfy heartbeat in the backup jobs.
cronic

# File maintenance
jdupes
rmlint
# https://github.com/dundee/gdu/tree/master - A fast disk usage analyzer written in Go
gdu

# Other
rename
